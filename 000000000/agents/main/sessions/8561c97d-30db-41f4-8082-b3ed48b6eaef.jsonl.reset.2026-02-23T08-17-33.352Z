{"type":"message","id":"7172c6a5","parentId":"91dd71de","timestamp":"2026-02-23T08:07:35.788Z","message":{"role":"assistant","content":[{"type":"text","text":"### 3. OpenClaw调用封装"},{"type":"toolCall","id":"call_8875127e194c4aa089f63272","name":"write","arguments":{"path":"D:\\工作报告\\openclaw_browser_bridge.py","content":"\"\"\"\nOpenClaw ↔ Browser-Use-Main 桥接封装\n让OpenClaw能够直接调用browser-use-main功能\n\"\"\"\n\nimport subprocess\nimport json\nimport os\nfrom pathlib import Path\n\nclass BrowserAutomationBridge:\n    \"\"\"浏览器自动化桥接器\"\"\"\n    \n    def __init__(self):\n        self.controller_script = r\"D:\\工作报告\\openclaw_controller.py\"\n        self.browser_use_path = r\"D:\\666666_kingwork\\browser-use-main\\browser-use-main\"\n        \n    def execute_task(self, task_type, **kwargs):\n        \"\"\"执行浏览器自动化任务\"\"\"\n        \n        # 构建命令\n        params_json = json.dumps(kwargs, ensure_ascii=False)\n        \n        command = [\n            \"python\", \n            self.controller_script,\n            task_type,\n            params_json\n        ]\n        \n        try:\n            # 执行任务\n            result = subprocess.run(\n                command,\n                cwd=self.browser_use_path,\n                capture_output=True,\n                text=True,\n                timeout=600  # 10分钟超时\n            )\n            \n            if result.returncode == 0:\n                # 解析JSON输出\n                try:\n                    return json.loads(result.stdout.strip())\n                except json.JSONDecodeError:\n                    return {\n                        \"status\": \"success\",\n                        \"raw_output\": result.stdout,\n                        \"task\": task_type\n                    }\n            else:\n                return {\n                    \"status\": \"error\",\n                    \"message\": result.stderr,\n                    \"returncode\": result.returncode\n                }\n                \n        except subprocess.TimeoutExpired:\n            return {\"status\": \"error\", \"message\": \"任务执行超时\"}\n        except Exception as e:\n            return {\"status\": \"error\", \"message\": str(e)}\n    \n    # 便捷方法\n    def douyin_search(self, keyword=\"AI\", count=10):\n        \"\"\"抖音搜索\"\"\"\n        return self.execute_task(\"douyin_search\", keyword=keyword, count=count)\n    \n    def baidu_search(self, keyword):\n        \"\"\"百度搜索\"\"\"\n        return self.execute_task(\"baidu_search\", keyword=keyword)\n    \n    def browse_videos(self, platform=\"douyin\", keyword=\"AI\", count=10):\n        \"\"\"浏览视频\"\"\"\n        return self.execute_task(\"browse_videos\", platform=platform, keyword=keyword, count=count)\n    \n    def extract_website_data(self, url, selector):\n        \"\"\"提取网站数据\"\"\"\n        return self.execute_task(\"extract_data\", url=url, selector=selector)\n\n# OpenClaw工具函数\ndef openclaw_browser_command(task_type, **params):\n    \"\"\"OpenClaw可调用的浏览器命令\"\"\"\n    bridge = BrowserAutomationBridge()\n    return bridge.execute_task(task_type, **params)\n\n# 测试函数\ndef test_integration():\n    \"\"\"测试集成是否正常工作\"\"\"\n    bridge = BrowserAutomationBridge()\n    \n    print(\"测试抖音搜索...\")\n    result = bridge.douyin_search(\"AI\", 3)\n    print(\"结果:\", json.dumps(result, ensure_ascii=False, indent=2))\n    \n    print(\"\\n测试百度搜索...\")\n    result = bridge.baidu_search(\"人工智能\")\n    print(\"结果:\", json.dumps(result, ensure_ascii=False, indent=2))\n\nif __name__ == \"__main__\":\n    test_integration()"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":43668,"output":935,"cacheRead":0,"cacheWrite":0,"totalTokens":44603,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771834003688}}
