{"type":"message","id":"c33c7d16","parentId":"8556d9d5","timestamp":"2026-02-23T08:06:43.675Z","message":{"role":"assistant","content":[{"type":"text","text":"### 2. 控制脚本"},{"type":"toolCall","id":"call_edb23141de0842c7abc24d22","name":"write","arguments":{"path":"D:\\工作报告\\openclaw_controller.py","content":"\"\"\"\nOpenClaw 主控制脚本 - 胶水层入口\n通过OpenClaw exec工具调用browser-use-main\n\"\"\"\n\nimport json\nimport sys\nimport os\n\n# 添加browser-use-main到Python路径\nbrowser_use_path = r\"D:\\666666_kingwork\\browser-use-main\\browser-use-main\"\nsys.path.insert(0, browser_use_path)\n\ndef main():\n    \"\"\"主控制函数\"\"\"\n    # 从命令行参数获取任务信息\n    if len(sys.argv) < 3:\n        print(json.dumps({\n            \"status\": \"error\",\n            \"message\": \"Usage: python openclaw_controller.py <task_type> <json_params>\"\n        }))\n        return\n    \n    task_type = sys.argv[1]\n    params_str = sys.argv[2]\n    \n    try:\n        params = json.loads(params_str)\n    except json.JSONDecodeError:\n        print(json.dumps({\n            \"status\": \"error\",\n            \"message\": \"Invalid JSON parameters\"\n        }))\n        return\n    \n    # 导入我们的集成器\n    from browser_integration_config import BrowserIntegration\n    \n    # 执行任务\n    integrator = BrowserIntegration()\n    result = integrator.execute_browser_task(task_type, params)\n    \n    # 输出结果（JSON格式，便于OpenClaw解析）\n    print(json.dumps(result, ensure_ascii=False))\n\nif __name__ == \"__main__\":\n    main()"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":43239,"output":407,"cacheRead":0,"cacheWrite":0,"totalTokens":43646,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771833983378}}
