{"type":"message","id":"c82913bd","parentId":"9fd5e300","timestamp":"2026-02-22T05:04:59.155Z","message":{"role":"assistant","content":[{"type":"text","text":"                                                            让我尝试使用Python直接连接CDP"},{"type":"toolCall","id":"call_b6d57517c1314bdfb80a9a22","name":"write","arguments":{"path":"cdp_douyin.py","content":"#!/usr/bin/env python3\n\"\"\"\n使用CDP直接控制Chrome执行抖音任务\n\"\"\"\n\nimport websockets\nimport asyncio\nimport json\nimport time\n\nasync def control_douyin():\n    \"\"\"通过CDP控制浏览器\"\"\"\n    try:\n        # 连接到Chrome DevTools Protocol\n        async with websockets.connect('ws://127.0.0.1:18792/devtools/browser') as ws:\n            print(\"✅ 成功连接到浏览器\")\n            \n            # 获取目标列表\n            targets_msg = {\n                \"id\": 1,\n                \"method\": \"Target.getTargets\"\n            }\n            await ws.send(json.dumps(targets_msg))\n            \n            response = await ws.recv()\n            targets = json.loads(response)\n            print(f\"找到 {len(targets.get('result', {}).get('targetInfos', []))} 个目标\")\n            \n            # 寻找抖音标签页\n            douyin_target = None\n            for target in targets.get('result', {}).get('targetInfos', []):\n                if 'douyin' in target.get('url', '').lower():\n                    douyin_target = target\n                    break\n            \n            if douyin_target:\n                print(f\"🎯 找到抖音标签页: {douyin_target['url']}\")\n                \n                # 连接到具体标签页\n                attach_msg = {\n                    \"id\": 2,\n                    \"method\": \"Target.attachToTarget\",\n                    \"params\": {\n                        \"targetId\": douyin_target[\"targetId\"],\n                        \"flatten\": True\n                    }\n                }\n                await ws.send(json.dumps(attach_msg))\n                \n                attach_response = await ws.recv()\n                print(\"✅ 成功连接到抖音标签页\")\n                \n                # 开始自动化任务\n                print(\"🚀 开始抖音自动化任务...\")\n                \n                for i in range(100):\n                    print(f\"📺 处理第 {i+1}/100 个视频\")\n                    \n                    # 浏览时间\n                    view_time = 2 + random.uniform(0, 5)\n                    print(f\"⏰ 浏览 {view_time:.2f} 秒\")\n                    time.sleep(view_time)\n                    \n                    # 模拟点赞\n                    like_msg = {\n                        \"id\": 3 + i * 2,\n                        \"method\": \"Input.dispatchMouseEvent\",\n                        \"params\": {\n                            \"type\": \"mousePressed\",\n                            \"button\": \"left\",\n                            \"x\": 300,\n                            \"y\": 600,\n                            \"clickCount\": 1\n                        }\n                    }\n                    await ws.send(json.dumps(like_msg))\n                    print(\"👍 执行点赞\")\n                    \n                    # 模拟上划\n                    swipe_msg = {\n                        \"id\": 4 + i * 2,\n                        \"method\": \"Input.dispatchTouchEvent\",\n                        \"params\": {\n                            \"type\": \"touchStart\",\n                            \"touchPoints\": [{\n                                \"x\": 200,\n                                \"y\": 700\n                            }]\n                        }\n                    }\n                    await ws.send(json.dumps(swipe_msg))\n                    print(\"⬆️  执行上划\")\n                    \n                    time.sleep(1)\n                \n                print(\"🎉 任务完成！\")\n                \n            else:\n                print(\"❌ 未找到抖音标签页\")\n                \n    except Exception as e:\n        print(f\"❌ 连接失败: {e}\")\n\nif __name__ == \"__main__\":\n    import random\n    asyncio.run(control_douyin())"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":72259,"output":925,"cacheRead":0,"cacheWrite":0,"totalTokens":73184,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771736634834}}
