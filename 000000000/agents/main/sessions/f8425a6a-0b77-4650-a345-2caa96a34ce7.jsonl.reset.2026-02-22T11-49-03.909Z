{"type":"message","id":"9a00df40","parentId":"9c27cbff","timestamp":"2026-02-22T05:07:27.048Z","message":{"role":"assistant","content":[{"type":"text","text":"                                                                              CDP连接被拒绝。让我尝试一个更直接的方法，使用系统级自动化："},{"type":"toolCall","id":"call_39b75f45df864aabb2c7500e","name":"write","arguments":{"path":"direct_automation.py","content":"#!/usr/bin/env python3\n\"\"\"\nDirect system-level automation for Douyin\n\"\"\"\n\nimport time\nimport random\nimport subprocess\nimport pyautogui\n\ndef automate_douyin_direct():\n    print(\"Starting direct Douyin automation\")\n    \n    # First ensure Chrome is open to Douyin\n    print(\"Opening Chrome with Douyin...\")\n    subprocess.Popen([\n        \"C:\\\\Program Files\\\\Google\\\\Chrome\\\\Application\\\\chrome.exe\", \n        \"--new-window\", \n        \"https://www.douyin.com/\"\n    ])\n    \n    # Wait for browser to load\n    time.sleep(8)\n    \n    print(\"Browser should be open. Starting automation in 3 seconds...\")\n    time.sleep(3)\n    \n    # Get screen size for positioning\n    try:\n        screen_width, screen_height = pyautogui.size()\n        print(f\"Screen size: {screen_width}x{screen_height}\")\n    except:\n        print(\"Using default screen coordinates\")\n        screen_width, screen_height = 1920, 1080\n    \n    # Main automation loop\n    for i in range(100):\n        print(f\"\\n--- Processing video {i+1}/100 ---\")\n        \n        # Viewing time: 2 seconds + random 0-5 seconds\n        view_time = 2 + random.uniform(0, 5)\n        print(f\"Watching for {view_time:.2f} seconds\")\n        time.sleep(view_time)\n        \n        # Like button position (approximate)\n        like_x = screen_width * 0.85  # Right side\n        like_y = screen_height * 0.6  # Middle vertical\n        \n        print(\"Clicking like button...\")\n        try:\n            pyautogui.click(like_x, like_y)\n            print(\"Like clicked\")\n        except Exception as e:\n            print(f\"Like click failed: {e}\")\n        \n        # Swipe up gesture (simulate with page down)\n        print(\"Swiping to next video...\")\n        try:\n            pyautogui.press('pagedown')  # Page down for next video\n            # Alternative: pyautogui.scroll(-500)  # Scroll down\n            print(\"Swipe executed\")\n        except Exception as e:\n            print(f\"Swipe failed: {e}\")\n        \n        # Short interval between actions\n        time.sleep(1)\n    \n    print(\"\\n🎉 Automation completed! 100 videos processed\")\n\nif __name__ == \"__main__\":\n    automate_douyin_direct()"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":73036,"output":685,"cacheRead":0,"cacheWrite":0,"totalTokens":73721,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771736787471}}
