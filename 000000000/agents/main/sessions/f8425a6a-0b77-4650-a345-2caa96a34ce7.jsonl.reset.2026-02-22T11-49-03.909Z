{"type":"message","id":"a69b2557","parentId":"0b360458","timestamp":"2026-02-22T03:53:30.752Z","message":{"role":"assistant","content":[{"type":"text","text":"                              让我创建一个简化版本，不需要语音识别依赖："},{"type":"toolCall","id":"call_4d677403158b4cf7ace8ebdd","name":"write","arguments":{"path":"simple_voice_server.py","content":"#!/usr/bin/env python3\n\"\"\"\n简化版局域网语音输入服务器\n手机浏览器访问 http://<你的电脑IP>:8000 进行语音输入\n\"\"\"\n\nfrom flask import Flask, render_template_string, request, jsonify\nimport os\n\napp = Flask(__name__)\n\nHTML_TEMPLATE = '''\n<!DOCTYPE html>\n<html>\n<head>\n    <title>OpenClaw 语音输入</title>\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <style>\n        body { font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; }\n        button { padding: 20px; font-size: 18px; background: #007bff; color: white; border: none; border-radius: 8px; cursor: pointer; }\n        button:active { background: #0056b3; }\n        #result { margin-top: 20px; padding: 15px; border: 1px solid #ddd; border-radius: 8px; min-height: 60px; }\n    </style>\n</head>\n<body>\n    <h2>🎤 OpenClaw 语音输入</h2>\n    \n    <button id=\"recordBtn\">\n        🎤 按住说话（直接输入文本）\n    </button>\n    \n    <div id=\"result\"></div>\n    \n    <div style=\"margin-top: 20px;\">\n        <input type=\"text\" id=\"textInput\" placeholder=\"或直接输入指令\" style=\"padding: 10px; width: 100%; font-size: 16px;\">\n        <button onclick=\"sendText()\" style=\"margin-top: 10px;\">📤 发送指令</button>\n    </div>\n    \n    <script>\n        const recordBtn = document.getElementById('recordBtn');\n        const resultDiv = document.getElementById('result');\n        const textInput = document.getElementById('textInput');\n        \n        // 模拟语音输入（实际需要浏览器语音API支持）\n        recordBtn.onclick = () => {\n            const command = prompt('请输入语音指令（模拟语音输入）:');\n            if (command) {\n                executeCommand(command);\n            }\n        };\n        \n        function sendText() {\n            const command = textInput.value.trim();\n            if (command) {\n                executeCommand(command);\n                textInput.value = '';\n            }\n        }\n        \n        async function executeCommand(command) {\n            resultDiv.innerHTML = '🟡 执行中: ' + command;\n            \n            try {\n                const response = await fetch('/execute', {\n                    method: 'POST',\n                    headers: { 'Content-Type': 'application/json' },\n                    body: JSON.stringify({ command: command })\n                });\n                \n                const data = await response.json();\n                if (data.success) {\n                    resultDiv.innerHTML = '✅ 执行成功: ' + command;\n                    \n                    // 显示执行结果\n                    if (data.result) {\n                        resultDiv.innerHTML += '<br><br>' + data.result;\n                    }\n                } else {\n                    resultDiv.innerHTML = '❌ 执行失败: ' + (data.error || '未知错误');\n                }\n            } catch (error) {\n                resultDiv.innerHTML = '❌ 网络错误: ' + error;\n            }\n        }\n        \n        // 回车键发送\n        textInput.addEventListener('keypress', (e) => {\n            if (e.key === 'Enter') {\n                sendText();\n            }\n        });\n    </script>\n</body>\n</html>\n'''\n\n@app.route('/')\ndef voice_interface():\n    return render_template_string(HTML_TEMPLATE)\n\n@app.route('/execute', methods=['POST'])\ndef execute_command():\n    try:\n        data = request.json\n        command = data.get('command', '').strip()\n        \n        if not command:\n            return jsonify({'success': False, 'error': '指令为空'})\n        \n        print(f\"🎯 收到语音指令: {command}\")\n        \n        result_text = \"\"\n        \n        # 根据指令执行相应操作\n        if \"检查\" in command or \"状态\" in command or \"heartbeat\" in command:\n            result_text = \"执行系统检查...\"\n            # 这里可以添加实际检查逻辑\n            \n        elif \"清理\" in command or \"删除\" in command or \"clean\" in command:\n            result_text = \"执行清理操作...\"\n            # 这里可以添加实际清理逻辑\n            \n        elif \"evomap\" in command or \"提交\" in command:\n            result_text = \"执行EvoMap提交...\"\n            # 这里可以添加EvoMap提交逻辑\n            \n        else:\n            result_text = f\"收到指令: {command}\\n请配置具体执行逻辑\"\n        \n        return jsonify({\n            'success': True, \n            'command': command,\n            'result': result_text\n        })\n        \n    except Exception as e:\n        return jsonify({'success': False, 'error': str(e)})\n\nif __name__ == \"__main__\":\n    print(\"🎤 启动局域网语音服务器...\")\n    print(\"📱 请在手机浏览器访问: http://<你的电脑IP>:8000\")\n    print(\"💡 先运行 ipconfig 查看电脑的局域网IP地址\")\n    app.run(host='0.0.0.0', port=8000, debug=True)"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":60495,"output":1376,"cacheRead":0,"cacheWrite":0,"totalTokens":61871,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771732324215}}
