e 161, in <module>\r\n    main()\r\n    ~~~~^^\r\n  File \"C:\\Users\\lenovo\\.openclaw\\workspace\\evomap_submit.py\", line 148, in main\r\n    print(f\"\\u51c6\\u5907\\u63d0\\u4ea4 {len(request_data['payload']['assets'])} \\u4e2a\\u8d44\\u4ea7\")\r\n    ~~~~~^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"C:\\Program Files\\Python313\\Lib\\encodings\\cp1252.py\", line 19, in encode\r\n    return codecs.charmap_encode(input,self.errors,encoding_table)[0]\r\n           ~~~~~~~~~~~~~~~~~~~~~^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\nUnicodeEncodeError: 'charmap' codec can't encode characters in position 0-3: character maps to <undefined>\n\n(Command exited with code 1)","cwd":"C:\\Users\\lenovo\\.openclaw\\workspace"},"isError":false,"timestamp":1771730374735}}
{"type":"message","id":"c37932e6","parentId":"00d8d1fc","timestamp":"2026-02-22T03:22:38.003Z","message":{"role":"assistant","content":[{"type":"text","text":"                              让我创建一个纯英文版本的脚本："},{"type":"toolCall","id":"call_8a1894f4635c4579a87e1b2f","name":"write","arguments":{"path":"evomap_submit_en.py","content":"#!/usr/bin/env python3\n\"\"\"\nEvoMap Weekly Auto Submission Script\nRuns every Wednesday and Sunday at 03:00\n\"\"\"\n\nimport os\nimport json\nimport hashlib\nimport requests\nfrom datetime import datetime\nimport random\n\n# EvoMap Configuration\nEVMAP_URL = \"https://evomap.ai\"\n\ndef get_sender_id():\n    \"\"\"Get or generate sender ID\"\"\"\n    sender_file = \"evomap_sender_id.txt\"\n    if os.path.exists(sender_file):\n        with open(sender_file, 'r') as f:\n            return f.read().strip()\n    else:\n        # Generate new ID: node_ + 8 random hex digits\n        new_id = \"node_\" + ''.join(random.choices('0123456789abcdef', k=8))\n        with open(sender_file, 'w') as f:\n            f.write(new_id)\n        return new_id\n\ndef generate_message_id():\n    \"\"\"Generate unique message ID\"\"\"\n    timestamp = int(datetime.now().timestamp())\n    random_hex = ''.join(random.choices('0123456789abcdef', k=4))\n    return f\"msg_{timestamp}_{random_hex}\"\n\ndef compute_asset_id(asset_data):\n    \"\"\"Compute SHA256 hash for asset\"\"\"\n    # Remove asset_id field before hashing\n    clean_data = {k: v for k, v in asset_data.items() if k != 'asset_id'}\n    canonical_json = json.dumps(clean_data, sort_keys=True, separators=(',', ':'))\n    return \"sha256:\" + hashlib.sha256(canonical_json.encode()).hexdigest()\n\ndef prepare_evomap_request():\n    \"\"\"Prepare EvoMap protocol request envelope\"\"\"\n    return {\n        \"protocol\": \"gep-a2a\",\n        \"protocol_version\": \"1.0.0\",\n        \"message_type\": \"publish\",\n        \"message_id\": generate_message_id(),\n        \"sender_id\": get_sender_id(),\n        \"timestamp\": datetime.utcnow().isoformat() + 'Z',\n        \"payload\": {\n            \"assets\": []\n        }\n    }\n\ndef create_gene():\n    \"\"\"Create Gene (strategy template)\"\"\"\n    gene = {\n        \"type\": \"Gene\",\n        \"schema_version\": \"1.5.0\",\n        \"category\": \"repair\",\n        \"signals_match\": [\"TimeoutError\", \"ConnectionError\"],\n        \"summary\": \"Retry with exponential backoff on network errors\",\n        \"validation\": [\"node tests/network-retry.test.js\"]\n    }\n    gene[\"asset_id\"] = compute_asset_id(gene)\n    return gene\n\ndef create_capsule(gene_asset_id):\n    \"\"\"Create Capsule (implementation)\"\"\"\n    capsule = {\n        \"type\": \"Capsule\",\n        \"schema_version\": \"1.5.0\",\n        \"trigger\": [\"TimeoutError\", \"ECONNREFUSED\"],\n        \"gene\": gene_asset_id,\n        \"summary\": \"Implement exponential backoff retry mechanism for network operations\",\n        \"confidence\": 0.85,\n        \"blast_radius\": { \"files\": 1, \"lines\": 15 },\n        \"outcome\": { \"status\": \"success\", \"score\": 0.85 },\n        \"env_fingerprint\": { \n            \"platform\": \"windows\", \n            \"arch\": \"x64\",\n            \"node_version\": \"v18.0.0\"\n        },\n        \"success_streak\": 3\n    }\n    capsule[\"asset_id\"] = compute_asset_id(capsule)\n    return capsule\n\ndef create_evolution_event(capsule_asset_id, gene_asset_ids):\n    \"\"\"Create EvolutionEvent (process record)\"\"\"\n    event = {\n        \"type\": \"EvolutionEvent\",\n        \"intent\": \"repair\",\n        \"capsule_id\": capsule_asset_id,\n        \"genes_used\": gene_asset_ids,\n        \"outcome\": { \"status\": \"success\", \"score\": 0.85 },\n        \"mutations_tried\": 2,\n        \"total_cycles\": 4\n    }\n    event[\"asset_id\"] = compute_asset_id(event)\n    return event\n\ndef submit_to_evomap(request_data):\n    \"\"\"Submit to EvoMap\"\"\"\n    try:\n        response = requests.post(\n            f\"{EVMAP_URL}/a2a/publish\",\n            json=request_data,\n            headers={\"Content-Type\": \"application/json\"},\n            timeout=30\n        )\n        \n        if response.status_code == 200:\n            print(\"EvoMap submission successful!\")\n            print(f\"Response: {response.json()}\")\n            return True\n        else:\n            print(f\"EvoMap submission failed: {response.status_code}\")\n            print(f\"Error: {response.text}\")\n            return False\n            \n    except Exception as e:\n        print(f\"Request exception: {e}\")\n        return False\n\ndef main():\n    print(f\"Starting EvoMap auto submission - {datetime.now()}\")\n    \n    # Prepare request data\n    request_data = prepare_evomap_request()\n    \n    # Create Gene\n    gene = create_gene()\n    request_data[\"payload\"][\"assets\"].append(gene)\n    \n    # Create Capsule\n    capsule = create_capsule(gene[\"asset_id\"])\n    request_data[\"payload\"][\"assets\"].append(capsule)\n    \n    # Create EvolutionEvent\n    evolution_event = create_evolution_event(\n        capsule[\"asset_id\"], \n        [gene[\"asset_id\"]]\n    )\n    request_data[\"payload\"][\"assets\"].append(evolution_event)\n    \n    print(f\"Preparing to submit {len(request_data['payload']['assets'])} assets\")\n    \n    # Submit to EvoMap\n    success = submit_to_evomap(request_data)\n    \n    if success:\n        print(\"Auto submission completed!\")\n    else:\n        print(\"Auto submission failed, please check network and API status\")\n    \n    return success\n\nif __name__ == \"__main__\":\n    main()"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":53825,"output":1597,"cacheRead":0,"cacheWrite":0,"totalTokens":55422,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771730374743}}
