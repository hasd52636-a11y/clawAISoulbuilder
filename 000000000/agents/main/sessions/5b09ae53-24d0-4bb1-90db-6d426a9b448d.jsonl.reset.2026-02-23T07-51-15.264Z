{"type":"message","id":"4bf42bf2","parentId":"290d7efd","timestamp":"2026-02-23T07:48:40.986Z","message":{"role":"assistant","content":[{"type":"text","text":"                                                                                                                                      还是编码问题。让我创建一个纯英文版本的脚本："},{"type":"toolCall","id":"call_82cc7f8dcad5414ba97d8293","name":"write","arguments":{"path":"D:\\工作报告\\20260223_07_douyin_auto_browse.py","content":"#!/usr/bin/env python3\n\"\"\"\nDouyin Auto Browse Script\nAutomatically browse 10 Douyin videos through Baidu search\n\"\"\"\n\nimport time\nimport random\nfrom selenium import webdriver\nfrom selenium.webdriver.common.by import By\nfrom selenium.webdriver.chrome.options import Options\nfrom selenium.webdriver.common.keys import Keys\nfrom selenium.webdriver.support.ui import WebDriverWait\nfrom selenium.webdriver.support import expected_conditions as EC\n\ndef setup_chrome_driver():\n    \"\"\"Setup ChromeDriver options\"\"\"\n    chrome_options = Options()\n    \n    # Anti-automation detection config\n    chrome_options.add_argument('--no-sandbox')\n    chrome_options.add_argument('--disable-dev-shm-usage')\n    chrome_options.add_argument('--disable-blink-features=AutomationControlled')\n    chrome_options.add_experimental_option(\"excludeSwitches\", [\"enable-automation\"])\n    chrome_options.add_experimental_option('useAutomationExtension', False)\n    \n    # User agent\n    chrome_options.add_argument('--user-agent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36')\n    \n    # ChromeDriver path\n    chromedriver_path = r\"C:\\Users\\lenovo\\Downloads\\chromedriver\\chromedriver-win32\\chromedriver.exe\"\n    \n    driver = webdriver.Chrome(executable_path=chromedriver_path, options=chrome_options)\n    \n    # Hide WebDriver features\n    driver.execute_script(\"Object.defineProperty(navigator, 'webdriver', {get: () => undefined})\")\n    \n    return driver\n\ndef baidu_search_douyin(driver):\n    \"\"\"Search Douyin through Baidu\"\"\"\n    print(\"[SEARCH] Searching Douyin via Baidu...\")\n    driver.get(\"https://www.baidu.com\")\n    \n    # Wait for search box\n    WebDriverWait(driver, 10).until(\n        EC.presence_of_element_located((By.ID, \"kw\"))\n    )\n    \n    # Enter search keyword\n    search_box = driver.find_element(By.ID, \"kw\")\n    search_box.clear()\n    search_box.send_keys(\"抖音\")\n    \n    # Click search\n    search_btn = driver.find_element(By.ID, \"su\")\n    search_btn.click()\n    \n    # Wait for results\n    time.sleep(3)\n    print(\"[DONE] Baidu search completed\")\n\ndef access_douyin_website(driver):\n    \"\"\"Access Douyin official website\"\"\"\n    print(\"[ACCESS] Accessing Douyin website...\")\n    \n    # Find and click official link\n    try:\n        official_link = WebDriverWait(driver, 10).until(\n            EC.element_to_be_clickable((By.XPATH, \"//a[contains(@href, 'douyin.com')]\"))\n        )\n        official_link.click()\n    except:\n        # Click first result if official link not found\n        first_result = driver.find_element(By.CSS_SELECTOR, \"#content_left .result a\")\n        first_result.click()\n    \n    # Wait for page load\n    time.sleep(5)\n    print(\"[DONE] Douyin website access completed\")\n\ndef simulate_video_browsing(driver, video_count=10):\n    \"\"\"Simulate video browsing behavior\"\"\"\n    print(f\"[VIDEO] Starting to browse {video_count} videos...\")\n    \n    for i in range(video_count):\n        print(f\"\\n[VIDEO] Video {i+1}/{video_count}\")\n        \n        # Random watch time (5-8 seconds)\n        watch_time = 5 + random.randint(0, 3)\n        print(f\"[TIME] Watching for {watch_time} seconds\")\n        time.sleep(watch_time)\n        \n        # Simulate swipe up (next video)\n        print(\"[ACTION] Swiping to next video\")\n        \n        # Try to find next button or use keyboard\n        try:\n            next_btn = driver.find_element(By.XPATH, \"//button[contains(text(), '下一个')]\")\n            next_btn.click()\n        except:\n            # Use keyboard down arrow\n            body = driver.find_element(By.TAG_NAME, 'body')\n            body.send_keys(Keys.ARROW_DOWN)\n        \n        # Random interval between videos\n        if i < video_count - 1:\n            interval = random.uniform(1.0, 3.0)\n            print(f\"[WAIT] Waiting {interval:.1f} seconds\")\n            time.sleep(interval)\n    \n    print(f\"\\n[DONE] Completed browsing {video_count} videos\")\n\ndef handle_login_if_needed(driver):\n    \"\"\"Handle login prompt if needed\"\"\"\n    print(\"[LOGIN] Checking login requirements...\")\n    \n    try:\n        # Look for login elements\n        login_elements = driver.find_elements(By.XPATH, \"//*[contains(text(), '登录')]\")\n        \n        if login_elements:\n            print(\"[WARNING] Login required, please handle manually\")\n            print(\"[WAIT] Waiting 20 seconds for manual login...\")\n            time.sleep(20)\n        else:\n            print(\"[OK] No login required\")\n            \n    except Exception as e:\n        print(f\"[ERROR] Login check failed: {e}\")\n\ndef main():\n    \"\"\"Main execution function\"\"\"\n    driver = None\n    \n    try:\n        # Initialize browser\n        print(\"[INIT] Initializing browser...\")\n        driver = setup_chrome_driver()\n        \n        # Execute full process\n        baidu_search_douyin(driver)\n        access_douyin_website(driver)\n        \n        # Switch to latest window (Douyin website)\n        driver.switch_to.window(driver.window_handles[-1])\n        \n        # Handle login\n        handle_login_if_needed(driver)\n        \n        # Start video browsing\n        simulate_video_browsing(driver, video_count=10)\n        \n        print(\"\\n[SUCCESS] Task completed!\")\n        \n    except Exception as e:\n        print(f\"\\n[FAILED] Execution failed: {e}\")\n        print(\"[TIP] Check network or complete login manually\")\n        \n    finally:\n        if driver:\n            print(\"\\n[CLOSE] Closing browser...\")\n            driver.quit()\n\nif __name__ == \"__main__\":\n    print(\"=\" * 60)\n    print(\"DOUYIN AUTO BROWSE SCRIPT\")\n    print(\"FEATURES: Baidu Search -> Douyin Access -> Video Browse\")\n    print(\"=\" * 60)\n    \n    main()\n    \n    print(\"\\n\" + \"=\" * 60)\n    print(\"USAGE INSTRUCTIONS:\")\n    print(\"1. Make sure Chrome browser is installed\")\n    print(\"2. Script handles Baidu search and Douyin access\")\n    print(\"3. Manual login may be required in browser\")\n    print(\"4. Browser closes automatically after completion\")\n    print(\"=\" * 60)"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":77100,"output":1818,"cacheRead":0,"cacheWrite":0,"totalTokens":78918,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771832817390}}
