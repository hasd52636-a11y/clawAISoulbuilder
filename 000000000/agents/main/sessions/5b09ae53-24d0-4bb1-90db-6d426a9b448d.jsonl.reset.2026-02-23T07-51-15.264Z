{"type":"message","id":"6582220a","parentId":"9a2ad5b8","timestamp":"2026-02-23T07:39:59.564Z","message":{"role":"assistant","content":[{"type":"text","text":"                                                                                  现在让我创建一个更完整的版本，包含抖音登录自动化："},{"type":"toolCall","id":"call_e1e8c646f26d4e07ab6f717e","name":"write","arguments":{"path":"D:\\工作报告\\20260223_06_抖音完整自动化.py","content":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"\n抖音完整自动化脚本\n包含：百度搜索 → 抖音访问 → 视频浏览\n\"\"\"\n\nimport time\nimport random\nfrom selenium import webdriver\nfrom selenium.webdriver.common.by import By\nfrom selenium.webdriver.chrome.options import Options\nfrom selenium.webdriver.common.keys import Keys\nfrom selenium.webdriver.support.ui import WebDriverWait\nfrom selenium.webdriver.support import expected_conditions as EC\n\ndef setup_chrome_driver():\n    \"\"\"设置ChromeDriver选项\"\"\"\n    chrome_options = Options()\n    \n    # 反自动化检测配置\n    chrome_options.add_argument('--no-sandbox')\n    chrome_options.add_argument('--disable-dev-shm-usage')\n    chrome_options.add_argument('--disable-blink-features=AutomationControlled')\n    chrome_options.add_experimental_option(\"excludeSwitches\", [\"enable-automation\"])\n    chrome_options.add_experimental_option('useAutomationExtension', False)\n    \n    # 用户代理设置\n    chrome_options.add_argument('--user-agent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36')\n    \n    # ChromeDriver路径\n    chromedriver_path = r\"C:\\Users\\lenovo\\Downloads\\chromedriver\\chromedriver-win32\\chromedriver.exe\"\n    \n    driver = webdriver.Chrome(executable_path=chromedriver_path, options=chrome_options)\n    \n    # 隐藏WebDriver特征\n    driver.execute_script(\"Object.defineProperty(navigator, 'webdriver', {get: () => undefined})\")\n    \n    return driver\n\ndef baidu_search_douyin(driver):\n    \"\"\"通过百度搜索抖音\"\"\"\n    print(\"🔍 通过百度搜索抖音...\")\n    driver.get(\"https://www.baidu.com\")\n    \n    # 等待搜索框加载\n    WebDriverWait(driver, 10).until(\n        EC.presence_of_element_located((By.ID, \"kw\"))\n    )\n    \n    # 输入搜索关键词\n    search_box = driver.find_element(By.ID, \"kw\")\n    search_box.clear()\n    search_box.send_keys(\"抖音\")\n    \n    # 点击搜索\n    search_btn = driver.find_element(By.ID, \"su\")\n    search_btn.click()\n    \n    # 等待搜索结果\n    time.sleep(3)\n    print(\"✅ 百度搜索完成\")\n\ndef access_douyin_website(driver):\n    \"\"\"访问抖音官方网站\"\"\"\n    print(\"🌐 访问抖音官方网站...\")\n    \n    # 查找并点击抖音官网链接\n    try:\n        # 尝试找到官方链接\n        official_link = WebDriverWait(driver, 10).until(\n            EC.element_to_be_clickable((By.XPATH, \"//a[contains(@href, 'douyin.com') and contains(text(), '官网')]\"))\n        )\n        official_link.click()\n    except:\n        # 如果找不到官方链接，点击第一个结果\n        first_result = driver.find_element(By.CSS_SELECTOR, \"#content_left .result a\")\n        first_result.click()\n    \n    # 等待页面加载\n    time.sleep(5)\n    print(\"✅ 抖音网站访问完成\")\n\ndef simulate_video_browsing(driver, video_count=10):\n    \"\"\"模拟视频浏览行为\"\"\"\n    print(f\"🎬 开始模拟浏览 {video_count} 个视频...\")\n    \n    for i in range(video_count):\n        print(f\"\\n📺 第 {i+1}/{video_count} 个视频\")\n        \n        # 随机观看时间（5-8秒）\n        watch_time = 5 + random.randint(0, 3)\n        print(f\"⏰ 观看时间: {watch_time} 秒\")\n        time.sleep(watch_time)\n        \n        # 模拟上划手势（切换到下一个视频）\n        print(\"👆 执行上划操作\")\n        \n        # 在抖音网页版，可能需要点击\"下一个\"按钮或使用键盘操作\n        try:\n            # 尝试找到下一个按钮\n            next_btn = driver.find_element(By.XPATH, \"//button[contains(text(), '下一个') or contains(text(), '下一个视频')]\")\n            next_btn.click()\n        except:\n            # 如果找不到按钮，使用键盘向下箭头\n            body = driver.find_element(By.TAG_NAME, 'body')\n            body.send_keys(Keys.ARROW_DOWN)\n        \n        # 随机间隔，模拟人类操作\n        if i < video_count - 1:\n            interval = random.uniform(1.0, 3.0)\n            print(f\"⏳ 间隔 {interval:.1f} 秒\")\n            time.sleep(interval)\n    \n    print(f\"\\n✅ 已完成 {video_count} 个视频浏览\")\n\ndef handle_login_if_needed(driver):\n    \"\"\"处理登录提示（如果需要）\"\"\"\n    print(\"🔐 检查登录需求...\")\n    \n    try:\n        # 查找登录弹窗或按钮\n        login_elements = driver.find_elements(By.XPATH, \"//*[contains(text(), '登录') or contains(text(), 'Login')]\")\n        \n        if login_elements:\n            print(\"⚠️  检测到登录要求，请手动处理\")\n            print(\"⏳ 等待20秒用于手动登录...\")\n            time.sleep(20)\n        else:\n            print(\"✅ 无需登录\")\n            \n    except Exception as e:\n        print(f\"❌ 登录检查错误: {e}\")\n\ndef main():\n    \"\"\"主执行函数\"\"\"\n    driver = None\n    \n    try:\n        # 初始化浏览器\n        print(\"🔧 初始化浏览器...\")\n        driver = setup_chrome_driver()\n        \n        # 执行完整流程\n        baidu_search_douyin(driver)\n        access_douyin_website(driver)\n        \n        # 切换到最新打开的窗口（抖音网站）\n        driver.switch_to.window(driver.window_handles[-1])\n        \n        # 处理登录\n        handle_login_if_needed(driver)\n        \n        # 开始浏览视频\n        simulate_video_browsing(driver, video_count=10)\n        \n        print(\"\\n🎉 任务完成！\")\n        \n    except Exception as e:\n        print(f\"\\n❌ 执行失败: {e}\")\n        print(\"💡 建议：检查网络连接或手动完成登录\")\n        \n    finally:\n        if driver:\n            print(\"\\n🔄 关闭浏览器...\")\n            driver.quit()\n\nif __name__ == \"__main__\":\n    print(\"=\" * 60)\n    print(\"🤖 抖音自动化浏览脚本\")\n    print(\"🛠️  功能：百度搜索 → 抖音访问 → 视频浏览\")\n    print(\"=\" * 60)\n    \n    main()\n    \n    print(\"\\n\" + \"=\" * 60)\n    print(\"📋 使用说明:\")\n    print(\"1. 确保Chrome浏览器已安装\")\n    print(\"2. 脚本会自动处理百度搜索和抖音访问\")\n    print(\"3. 如需登录，请在弹出的浏览器中手动完成\")\n    print(\"4. 浏览完成后会自动关闭浏览器\")\n    print(\"=\" * 60)"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":70526,"output":1904,"cacheRead":0,"cacheWrite":0,"totalTokens":72430,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771832224453}}
