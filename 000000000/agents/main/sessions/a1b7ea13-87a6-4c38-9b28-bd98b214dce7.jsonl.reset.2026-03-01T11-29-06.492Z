{"type":"message","id":"90a9d081","parentId":"c3ed078f","timestamp":"2026-03-01T02:25:24.150Z","message":{"role":"toolResult","toolCallId":"call_c2a005938c874f5293eeb504","toolName":"exec","content":[{"type":"text","text":"dir : Second path fragment must not be a drive or UNC name.\r\nParameter name: path2\r\nAt line:1 char:1\r\n+ dir \"D:\\????\\\" /Q\r\n+ ~~~~~~~~~~~~~~~~~\r\n    + CategoryInfo          : InvalidArgument: (D:\\????\\:String) [Get-ChildItem], ArgumentException\r\n    + FullyQualifiedErrorId : DirArgumentError,Microsoft.PowerShell.Commands.GetChildItemCommand\n\n(Command exited with code 1)"}],"details":{"status":"completed","exitCode":1,"durationMs":465,"aggregated":"dir : Second path fragment must not be a drive or UNC name.\r\nParameter name: path2\r\nAt line:1 char:1\r\n+ dir \"D:\\????\\\" /Q\r\n+ ~~~~~~~~~~~~~~~~~\r\n    + CategoryInfo          : InvalidArgument: (D:\\????\\:String) [Get-ChildItem], ArgumentException\r\n    + FullyQualifiedErrorId : DirArgumentError,Microsoft.PowerShell.Commands.GetChildItemCommand\n\n(Command exited with code 1)","cwd":"C:\\Users\\lenovo\\.openclaw\\workspace"},"isError":false,"timestamp":1772331924147}}
