restart/--json/--timeout as needed\r\n\n[38;2;255;90;45m[1mExamples:[m[K\r\n  [38;2;255;122;61mopenclaw update [38;2;139;127;119m# Update a source checkout (git)[K\r[m\n  [38;2;255;122;61mopenclaw update --channel beta [38;2;139;127;119m# Switch to beta channel (git + npm)[K\r[m\n  [38;2;255;122;61mopenclaw update --channel dev [38;2;139;127;119m# Switch to dev channel (git + npm)[K\r[m\n  [38;2;255;122;61mopenclaw update --tag beta [38;2;139;127;119m# One-off update to a dist-tag or version[K\r[m\n  [38;2;255;122;61mopenclaw update --no-restart [38;2;139;127;119m# Update without restarting the service[K\r[m\n  [38;2;255;122;61mopenclaw update --json [38;2;139;127;119m# Output result as JSON[K\r[m\n  [38;2;255;122;61mopenclaw update --yes [38;2;139;127;119m# Non-interactive (accept downgrade prompts)[K\r[m\n  [38;2;255;122;61mopenclaw update wizard [38;2;139;127;119m# Interactive update wizard[K\r[m\n  [38;2;255;122;61mopenclaw --update [38;2;139;127;119m# Shorthand for openclaw update[K\r[m\n\n[38;2;255;90;45m[1mNotes:[m[K\r\n  - Switch channels with --channel stable|beta|dev\r\n  - For global installs: auto-updates via detected package manager when possible (see docs/install/updating.md)\r\n  - Downgrades require confirmation (can break configuration)\r\n  - Skips update if the working directory has uncommitted changes\r\n\n[38;2;139;127;119mDocs: [m]8;id=23520-1;https://docs.openclaw.ai/cli/update\\docs.openclaw.ai/cli/update]8;;\\[K\r\n]0;C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"}],"details":{"status":"completed","exitCode":0,"durationMs":4768,"aggregated":"[?9001h[?1004h[?25l[2J[m[H]0;openclaw[?25h[?25l[38;2;255;90;45m[1m\r\n🦞 OpenClaw[m [38;2;255;138;91m2026.2.21-2 [38;2;139;127;119m(35a57bc) — [38;2;209;74;34mYour config is valid, your assumptions are not.[4;1H[?25h[?25l[m[38;2;255;90;45m[1mUsage:[m openclaw update [options] [command][6;1HUpdate OpenClaw and inspect update channel status[38;2;255;90;45m[1m[8;1HOptions:[m\r\n  [38;2;255;1