{"type":"message","id":"3d650ed5","parentId":"c4cd2b47","timestamp":"2026-03-08T03:52:51.089Z","message":{"role":"toolResult","toolCallId":"call_f1714f177e1a49c1bec48d3a","toolName":"read","content":[{"type":"text","text":"# 今日头条发布配置 - 生产环境\n\n# 浏览器设置\nbrowser:\n  headless: false  # 显示浏览器窗口\n  slow_mo: 300     # 操作延迟（毫秒）\n  timeout: 60000   # 超时时间（毫秒）\n\n# 发布设置\npublish:\n  skip_actual_publish: false  # 实际发布\n  test_mode: false           # 生产模式\n  max_retries: 3            # 最大重试次数\n  retry_delay: 5            # 重试延迟（秒）\n\n# 内容设置\ncontent:\n  default_title: \"Han酱AI观察：{date} 科技简报\"\n  min_title_length: 2\n  max_title_length: 30\n  min_content_length: 100\n  max_content_length: 5000\n\n# 图片设置\nimage:\n  enable_free_image: true   # 启用免费图片库\n  default_keywords: [\"科技\", \"未来\", \"AI\", \"创新\"]\n  max_images: 1             # 最大图片数量\n\n# 发布选项\noptions:\n  ad_enabled: true          # 启用广告\n  first_publish: true       # 头条首发\n  author_statement: \"个人观点，仅供参考\"  # 作者声明\n  location_enabled: false   # 添加位置\n\n# 文件路径\npaths:\n  screenshots: \"screenshots\"    # 截图目录\n  logs: \"logs\"                  # 日志目录\n  content_cache: \"cache\"        # 内容缓存\n  output: \"output\"              # 输出目录\n\n# 调度设置\nschedule:\n  enabled: false          # 启用自动调度\n  time: \"01:00\"          # 每天执行时间（GMT+8）\n  timezone: \"Asia/Shanghai\"\n\n# 安全设置\nsafety:\n  enable_content_check: true  # 启用内容安全检查\n  sensitive_keywords:         # 敏感关键词列表\n    - \"政治\"\n    - \"色情\"\n    - \"暴力\"\n    - \"赌博\"\n    - \"毒品\"\n  max_check_retries: 3\n\n# 日志设置\nlogging:\n  level: \"INFO\"          # 日志级别：DEBUG, INFO, WARNING, ERROR\n  file_enabled: true     # 启用文件日志\n  console_enabled: true  # 启用控制台日志\n\n# Han酱AI风格设置\nhan_ai_style:\n  objective_ratio: 70    # 客观分析比例（%）\n  disdain_ratio: 15      # 冷眼旁观比例（%）\n  humor_ratio: 10        # 冷幽默比例（%）\n  praise_ratio: 5        # 轻微赞赏比例（%）\n  emoji_enabled: true    # 启用表情符号\n  signature: \"🔥 Han酱AI的冷眼观察\"  # 签名"}],"isError":false,"timestamp":1772941971075}}
