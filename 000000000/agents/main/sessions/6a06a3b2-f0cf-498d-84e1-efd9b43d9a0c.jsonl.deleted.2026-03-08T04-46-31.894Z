{"type":"message","id":"41a53d89","parentId":"a8be73fa","timestamp":"2026-03-08T04:00:18.771Z","message":{"role":"toolResult","toolCallId":"call_93d4dd66eed745e2af6caefc","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"\n安装今日头条自动发布技能所需依赖\n\"\"\"\n\nimport subprocess\nimport sys\nimport os\nfrom pathlib import Path\n\ndef run_command(cmd, description):\n    \"\"\"运行命令并处理输出\"\"\"\n    print(f\"\\n🔧 {description}...\")\n    print(f\"   运行: {cmd}\")\n    \n    try:\n        result = subprocess.run(\n            cmd,\n            shell=True,\n            check=True,\n            capture_output=True,\n            text=True\n        )\n        print(f\"   ✅ 成功\")\n        if result.stdout.strip():\n            print(f\"   输出: {result.stdout[:200]}...\")\n        return True\n    except subprocess.CalledProcessError as e:\n        print(f\"   ❌ 失败: {e}\")\n        if e.stderr:\n            print(f\"   错误: {e.stderr[:200]}\")\n        return False\n\ndef main():\n    \"\"\"主安装函数\"\"\"\n    print(\"=\" * 60)\n    print(\"今日头条自动发布技能 - 依赖安装\")\n    print(\"=\" * 60)\n    \n    # 检查Python版本\n    print(f\"\\n🐍 Python版本: {sys.version}\")\n    if sys.version_info < (3, 7):\n        print(\"❌ 需要Python 3.7或更高版本\")\n        return False\n    \n    # 安装Playwright\n    success = run_command(\n        \"pip install playwright\",\n        \"安装Playwright\"\n    )\n    \n    if not success:\n        print(\"❌ Playwright安装失败\")\n        return False\n    \n    # 安装浏览器\n    success = run_command(\n        \"playwright install chromium\",\n        \"安装Chromium浏览器\"\n    )\n    \n    if not success:\n        print(\"❌ 浏览器安装失败\")\n        return False\n    \n    # 安装其他Python依赖\n    dependencies = [\n        \"python-docx\",      # DOCX文件处理\n        \"pyyaml\",           # YAML配置文件\n        \"requests\",         # HTTP请求\n        \"pillow\",           # 图片处理\n        \"beautifulsoup4\",   # HTML解析\n        \"lxml\",             # XML处理\n    ]\n    \n    print(f\"\\n📦 安装其他依赖: {', '.join(dependencies)}\")\n    \n    for dep in dependencies:\n        success = run_command(\n            f\"pip install {dep}\",\n            f\"安装 {dep}\"\n        )\n        if not success:\n            print(f\"⚠️  {dep} 安装失败，但继续安装其他依赖\")\n    \n    # 创建配置文件模板\n    print(\"\\n📄 创建配置文件模板...\")\n    config_template = Path(__file__).parent.parent / \"references\" / \"config_template.yaml\"\n    config_file = Path(\"config.yaml\")\n    \n    if config_template.exists() and not config_file.exists():\n        import shutil\n        shutil.copy(config_template, config_file)\n        print(f\"   ✅ 配置文件已创建: {config_file}\")\n        print(f\"   请编辑此文件并填写您的配置\")\n    else:\n        print(f\"   ⚠️  配置文件已存在或模板不存在\")\n    \n    # 创建示例文档\n    print(\"\\n📝 创建示例文档...\")\n    example_doc = Path(\"example_article.docx\")\n    if not example_doc.exists():\n        try:\n            from docx import Document\n            doc = Document()\n            doc.add_heading('示例文章标题', 0)\n            doc.add_paragraph('这是第一段内容。')\n            doc.add_paragraph('这是第二段内容，包含一些关键词如人工智能和机器学习。')\n            doc.add_paragraph('这是第三段内容，讨论科技发展趋势。')\n            doc.save(str(example_doc))\n            print(f\"   ✅ 示例文档已创建: {example_doc}\")\n        except Exception as e:\n            print(f\"   ⚠️  创建示例文档失败: {e}\")\n    else:\n        print(f\"   ⚠️  示例文档已存在\")\n    \n    # 验证安装\n    print(\"\\n🔍 验证安装...\")\n    \n    test_imports = [\n        (\"playwright\", \"from playwright.async_api import async_playwright\"),\n        (\"docx\", \"import docx\"),\n        (\"yaml\", \"import yaml\"),\n    ]\n    \n    all_imports_ok = True\n    for module_name, import_stmt in test_imports:\n        try:\n            exec(import_stmt)\n            print(f\"   ✅ {module_name} 导入成功\")\n        except ImportError as e:\n            print(f\"   ❌ {module_name} 导入失败: {e}\")\n            all_imports_ok = False\n    \n    # 最终提示\n    print(\"\\n\" + \"=\" * 60)\n    if all_imports_ok:\n        print(\"🎉 安装完成！\")\n        print(\"\\n下一步:\")\n        print(\"1. 编辑 config.yaml 文件，配置您的账号信息\")\n        print(\"2. 准备 .docx 格式的文章文件\")\n        print(\"3. 运行测试命令:\")\n        print(\"   python scripts/toutiao_publisher.py --article example_article.docx --debug\")\n        print(\"\\n📖 更多信息请参考:\")\n        print(\"   - references/browser_automation.md (浏览器自动化指南)\")\n        print(\"   - references/toutiao_selectors.md (页面元素选择器)\")\n        print(\"   - references/error_handling.md (错误处理指南)\")\n    else:\n        print(\"⚠️  安装完成，但部分依赖可能有问题\")\n        print(\"请检查上面的错误信息并手动安装缺失的依赖\")\n    \n    print(\"=\" * 60)\n    return all_imports_ok\n\nif __name__ == \"__main__\":\n    try:\n        success = main()\n        sys.exit(0 if success else 1)\n    except KeyboardInterrupt:\n        print(\"\\n\\n安装被用户中断\")\n        sys.exit(1)\n    except Exception as e:\n        print(f\"\\n❌ 安装过程中出现错误: {e}\")\n        sys.exit(1)"}],"isError":false,"timestamp":1772942418754}}
