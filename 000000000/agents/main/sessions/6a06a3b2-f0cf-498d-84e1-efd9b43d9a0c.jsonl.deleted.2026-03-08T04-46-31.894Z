{"type":"message","id":"a59a34ac","parentId":"a7deba71","timestamp":"2026-03-08T03:48:15.366Z","message":{"role":"toolResult","toolCallId":"call_f0ab31e035894b2ba99cd20a","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"\nDirect publishing script for today's briefing\n\"\"\"\n\nimport asyncio\nimport sys\nimport os\nimport json\nfrom datetime import datetime\n\n# Force UTF-8\nif sys.platform == \"win32\":\n    import io\n    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8', errors='ignore')\n    sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding='utf-8', errors='ignore')\n\nasync def publish_today_briefing():\n    \"\"\"Publish today's briefing\"\"\"\n    \n    print(\"PUBLISHING TODAY'S HANJIANG AI BRIEFING TO TOUTIAO\")\n    print(\"=\" * 60)\n    \n    # Add to path\n    sys.path.append(os.path.dirname(__file__))\n    \n    try:\n        # Import the working publisher\n        import toutiao_publisher_fixed as publisher\n        \n        print(\"1. Creating publisher instance...\")\n        pub = publisher.ToutiaoPublisher()\n        \n        print(\"2. Preparing today's article data...\")\n        \n        # Today's date\n        today = datetime.now().strftime('%Y-%m-%d')\n        # Use the briefing file generated by Han酱AI\n        briefing_path = r\"D:\\工作报告\\Han酱AI_简报_20260219.md\"\n        \n        if not os.path.exists(briefing_path):\n            print(f\"ERROR: Today's briefing not found: {briefing_path}\")\n            print(\"Cannot proceed without briefing file.\")\n            return False\n        \n        # Read content\n        with open(briefing_path, 'r', encoding='utf-8') as f:\n            content = f.read()\n        \n        # Extract title\n        title = f\"Han酱AI人类观察简报 - {today}\"\n        lines = content.split('\\n')\n        for line in lines:\n            if line.startswith('# '):\n                title = line[2:].strip()\n                break\n        \n        # Prepare article data as expected by the publisher\n        article_data = {\n            'title': title,\n            'content': content,\n            'category': 'Technology',\n            'tags': ['AI', '人工智能', '科技观察', 'Han酱AI', '人类行为', '科技伦理'],\n            'declare_original': True,\n            'author_declaration': '个人观点，仅供参考',\n            'ad_settings': 'default'\n        }\n        \n        print(f\"   Title: {title}\")\n        print(f\"   Content: {len(content)} characters\")\n        print(f\"   Category: {article_data['category']}\")\n        print(f\"   Tags: {', '.join(article_data['tags'])}\")\n        \n        print(\"3. Starting browser automation...\")\n        \n        # IMPORTANT: We need to modify the publisher's config to actually publish\n        # The default config has skip_publish=True and test_mode=True\n        # Let's modify it directly\n        pub.config['skip_publish'] = False\n        pub.config['test_mode'] = False\n        \n        print(\"   Config updated: skip_publish=False, test_mode=False\")\n        \n        # Publish the article\n        result = await pub.publish_article(article_data)\n        \n        print(\"4. Publication result:\")\n        print(json.dumps(result, indent=2, ensure_ascii=False))\n        \n        if result.get('success'):\n            print(\"=\" * 60)\n            print(\"SUCCESS: Article published!\")\n            print(\"=\" * 60)\n            \n            # Save publication record\n            record = {\n                'date': today,\n                'title': title,\n                'content_length': len(content),\n                'tags': article_data['tags'],\n                'publish_time': datetime.now().isoformat(),\n                'result': result\n            }\n            \n            record_path = os.path.join(os.path.dirname(__file__), \"..\", \"logs\", f\"publication_{today}.json\")\n            with open(record_path, 'w', encoding='utf-8') as f:\n                json.dump(record, f, indent=2, ensure_ascii=False)\n            \n            print(f\"Publication record saved to: {record_path}\")\n            return True\n        else:\n            print(\"=\" * 60)\n            print(\"FAILED: Publication failed\")\n            print(\"=\" * 60)\n            return False\n            \n    except Exception as e:\n        print(\"=\" * 60)\n        print(\"ERROR in publishing:\")\n        print(str(e))\n        print(\"=\" * 60)\n        import traceback\n        traceback.print_exc()\n        return False\n\nasync def main():\n    \"\"\"Main function\"\"\"\n    print(\"WARNING: This will actually publish to Toutiao!\")\n    print(\"Date:\", datetime.now().strftime('%Y-%m-%d %H:%M:%S'))\n    print()\n    print(\"Auto-confirming and proceeding...\")\n    print()\n    \n    success = await publish_today_briefing()\n    \n    if success:\n        print(\"\\n\" + \"=\" * 60)\n        print(\"PUBLICATION COMPLETED SUCCESSFULLY!\")\n        print(f\"Hanjiang AI briefing for {datetime.now().strftime('%Y-%m-%d')} has been published to Toutiao.\")\n        print(\"=\" * 60)\n    else:\n        print(\"\\n\" + \"=\" * 60)\n        print(\"PUBLICATION FAILED\")\n        print(\"Please check the error messages above.\")\n        print(\"=\" * 60)\n        sys.exit(1)\n\nif __name__ == '__main__':\n    asyncio.run(main())"}],"isError":false,"timestamp":1772941695353}}
