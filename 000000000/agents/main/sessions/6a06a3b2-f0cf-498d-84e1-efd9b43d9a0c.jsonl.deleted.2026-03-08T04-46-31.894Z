{"type":"message","id":"3ff64cc7","parentId":"5b0a6498","timestamp":"2026-03-08T03:52:56.005Z","message":{"role":"toolResult","toolCallId":"call_21fc7ce6e12540b3b614346c","toolName":"read","content":[{"type":"text","text":"\nclass ToutiaoPublisher:\n    \"\"\"今日头条自动发布器\"\"\"\n    \n    def __init__(self, config_path=None):\n        self.config = self.load_config(config_path)\n        self.browser = None\n        self.page = None\n        \n    def load_config(self, config_path):\n        \"\"\"加载配置文件\"\"\"\n        default_config = {\n            'headless': False,\n            'slow_mo': 300,\n            'timeout': 60000,\n            'skip_publish': True,  # 跳过实际发布，只测试流程\n            'test_mode': True,\n            'screenshot_dir': 'screenshots',\n            'log_dir': 'logs'\n        }\n        \n        if config_path and os.path.exists(config_path):\n            try:\n                import yaml\n                with open(config_path, 'r', encoding='utf-8') as f:\n                    user_config = yaml.safe_load(f)\n                    default_config.update(user_config)\n            except Exception as e:\n                logger.warning(f\"加载配置文件失败: {e}\")\n        \n\n[424 more lines in file. Use offset=55 to continue.]"}],"isError":false,"timestamp":1772941975992}}
