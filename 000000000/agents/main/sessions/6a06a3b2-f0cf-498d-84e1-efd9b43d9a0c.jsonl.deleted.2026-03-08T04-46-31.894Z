{"type":"message","id":"7ae05d10","parentId":"63178e31","timestamp":"2026-03-08T03:50:42.850Z","message":{"role":"toolResult","toolCallId":"call_437cb22314874b039c7722de","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"\n今日头条自动发布脚本 - 修复编码版本\n移除表情符号，确保Windows兼容性\n\"\"\"\n\nimport asyncio\nimport logging\nimport os\nimport sys\nfrom pathlib import Path\nfrom datetime import datetime\nimport json\n\n# 配置日志\nlogging.basicConfig(\n    level=logging.INFO,\n    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',\n    handlers=[\n        logging.StreamHandler(sys.stdout),\n        logging.FileHandler('toutiao_publish.log', encoding='utf-8')\n    ]\n)\nlogger = logging.getLogger(__name__)\n\nclass ToutiaoPublisher:\n    \"\"\"今日头条自动发布器\"\"\"\n    \n    def __init__(self, config_path=None):\n        self.config = self.load_config(config_path)\n        self.browser = None\n        self.page = None\n        \n    def load_config(self, config_path):\n        \"\"\"加载配置文件\"\"\"\n        default_config = {\n            'headless': False,\n            'slow_mo': 300,\n            'timeout': 60000,\n            'skip_publish': True,  # 跳过实际发布，只测试流程\n            'test_mode': True,\n            'screenshot_dir': 'screenshots',\n            'log_dir': 'logs'\n        }\n        \n        if config_path and os.path.exists(config_path):\n            try:\n                import yaml\n                with open(config_path, 'r', encoding='utf-8') as f:\n                    user_config = yaml.safe_load(f)\n\n[428 more lines in file. Use offset=51 to continue.]"}],"isError":false,"timestamp":1772941842840}}
