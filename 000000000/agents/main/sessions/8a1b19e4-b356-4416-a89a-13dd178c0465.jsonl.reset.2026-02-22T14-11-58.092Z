{"type":"message","id":"55aef1a9","parentId":"525cf43c","timestamp":"2026-02-22T14:03:39.033Z","message":{"role":"assistant","content":[{"type":"text","text":"                  明白，大王！我会调整策略：**找不到点赞按钮就跳过，遇到直播也跳过**。让我重新设计自动化逻辑。"},{"type":"toolCall","id":"call_2e65cbe3445f45099b60220d","name":"write","arguments":{"path":"D:\\工作报告\\20260222_09_抖音智能浏览_跳过策略.py","content":"#!/usr/bin/env python3\n\"\"\"\n抖音智能浏览脚本 - 带跳过策略\n找不到点赞按钮就跳过，直播也跳过\n\"\"\"\n\nimport time\nimport random\n\ndef douyin_smart_browsing(driver):\n    \"\"\"\n    智能抖音浏览 - 带跳过策略\n    \"\"\"\n    print(\"🎬 开始抖音智能浏览任务（带跳过策略）...\")\n    \n    # 任务参数\n    target_videos = 10  # 目标浏览10条有效视频\n    max_attempts = 20   # 最多尝试20次（防止无限循环）\n    skipped_count = 0   # 跳过的项目计数\n    completed_count = 0 # 完成的视频计数\n    \n    try:\n        # 等待页面稳定\n        print(\"⏳ 等待抖音页面稳定...\")\n        time.sleep(3)\n        \n        attempt = 0\n        while completed_count < target_videos and attempt < max_attempts:\n            attempt += 1\n            print(f\"\\n🔄 尝试 #{attempt} (完成: {completed_count}/10, 跳过: {skipped_count})\")\n            \n            # 1. 检查当前内容类型\n            print(\"   🔍 检查当前内容类型...\")\n            time.sleep(random.uniform(2, 4))  # 等待渲染\n            \n            # 2. 检测是否是直播（跳过直播）\n            is_live = check_if_live_stream(driver)\n            if is_live:\n                print(\"   📺 检测到直播，跳过...\")\n                skipped_count += 1\n                swipe_to_next(driver)\n                time.sleep(2)\n                continue\n            \n            # 3. 检查点赞按钮是否存在\n            print(\"   🔎 查找点赞按钮...\")\n            like_button_exists = check_like_button(driver)\n            \n            if not like_button_exists:\n                print(\"   ⚠️  点赞按钮不存在，跳过此内容...\")\n                skipped_count += 1\n                swipe_to_next(driver)\n                time.sleep(2)\n                continue\n            \n            # 4. 正常视频流程\n            print(\"   📹 检测到正常视频，开始处理...\")\n            \n            # 观看视频（5-8秒随机）\n            watch_time = random.uniform(5, 8)\n            print(f\"   👀 观看视频 {watch_time:.1f} 秒...\")\n            time.sleep(watch_time)\n            \n            # 执行点赞\n            print(\"   ❤️  执行点赞...\")\n            if click_like_button(driver):\n                print(\"   ✅ 点赞成功\")\n            else:\n                print(\"   ❌ 点赞失败，继续流程\")\n            \n            # 短暂等待\n            time.sleep(1)\n            \n            # 上划切换\n            print(\"   ⬆️  上划切换到下一个...\")\n            swipe_to_next(driver)\n            \n            # 等待新内容加载\n            load_time = random.uniform(2, 3)\n            print(f\"   ⏳ 等待加载 {load_time:.1f} 秒...\")\n            time.sleep(load_time)\n            \n            completed_count += 1\n            print(f\"   ✅ 第 {completed_count} 条视频处理完成\")\n        \n        # 任务总结\n        print(f\"\\n🎉 抖音智能浏览任务完成！\")\n        print(f\"   - 成功浏览: {completed_count} 条视频\")\n        print(f\"   - 跳过内容: {skipped_count} 个\")\n        print(f\"   - 总尝试次数: {attempt} 次\")\n        \n        return True\n        \n    except Exception as e:\n        print(f\"❌ 任务执行失败: {e}\")\n        return False\n\ndef check_if_live_stream(driver):\n    \"\"\"\n    检测当前内容是否是直播\n    \"\"\"\n    # 这里需要具体的直播检测逻辑\n    # 例如：查找\"直播中\"、\"LIVE\"等标识\n    # 暂时返回False，实际需要实现检测逻辑\n    return False\n\ndef check_like_button(driver):\n    \"\"\"\n    检查点赞按钮是否存在\n    \"\"\"\n    try:\n        # 这里需要具体的点赞按钮检测逻辑\n        # 例如：查找点赞按钮的CSS选择器\n        # 暂时返回True，实际需要实现检测逻辑\n        return True\n    except:\n        return False\n\ndef click_like_button(driver):\n    \"\"\"\n    点击点赞按钮\n    \"\"\"\n    try:\n        # 这里需要具体的点赞按钮点击逻辑\n        # 例如：driver.find_element(...).click()\n        # 暂时返回True，实际需要实现点击逻辑\n        return True\n    except:\n        return False\n\ndef swipe_to_next(driver):\n    \"\"\"\n    上划切换到下一个内容\n    \"\"\"\n    try:\n        # 这里需要具体的上划操作逻辑\n        # 例如：driver.execute_script(\"window.scrollBy(0, -window.innerHeight)\")\n        # 暂时模拟操作\n        pass\n    except:\n        pass\n\ndef check_browser_ready():\n    \"\"\"\n    检查浏览器服务是否就绪\n    \"\"\"\n    try:\n        import requests\n        response = requests.get(\"http://localhost:18792/json\", timeout=5)\n        return response.status_code == 200\n    except:\n        return False\n\nif __name__ == \"__main__\":\n    print(\"=\" * 60)\n    print(\"🤖 抖音智能浏览脚本 - 带跳过策略\")\n    print(\"=\" * 60)\n    \n    print(\"🎯 执行策略:\")\n    print(\"   - 找不到点赞按钮 → 跳过\")\n    print(\"   - 检测到直播 → 跳过\") \n    print(\"   - 正常视频 → 观看5-8秒 + 点赞\")\n    print(\"   - 目标: 10条有效视频\")\n    \n    if check_browser_ready():\n        print(\"\\n✅ 浏览器服务就绪，准备执行...\")\n        \n        # 这里需要实际的浏览器连接代码\n        # driver = webdriver.Chrome(options=chrome_options)\n        \n        # 执行智能浏览\n        success = douyin_smart_browsing(None)  # 暂时传入None\n        \n        if success:\n            print(\"\\n✅ 智能浏览任务完成！\")\n        else:\n            print(\"\\n❌ 任务执行失败\")\n    else:\n        print(\"\\n❌ 浏览器服务未就绪\")\n        print(\"\\n📋 等待服务恢复后执行:\")\n        print(\"   1. 智能检测内容类型\")\n        print(\"   2. 自动跳过直播和无效内容\") \n        print(\"   3. 只处理有点赞按钮的正常视频\")\n        print(\"   4. 目标完成10条有效视频浏览\")\n    \n    print(\"\\n\" + \"=\" * 60)"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":67658,"output":1790,"cacheRead":0,"cacheWrite":0,"totalTokens":69448,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771768834185}}
