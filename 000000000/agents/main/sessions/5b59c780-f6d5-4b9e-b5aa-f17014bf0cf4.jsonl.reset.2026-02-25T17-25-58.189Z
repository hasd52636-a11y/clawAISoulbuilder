{"type":"message","id":"ddeb73da","parentId":"cc11761f","timestamp":"2026-02-25T17:09:02.151Z","message":{"role":"toolResult","toolCallId":"call_3453425b4e0d45309d18f2cb","toolName":"read","content":[{"type":"text","text":"    <div class=\"card\">\n      <h2>授权配置</h2>\n      <label for=\"port\">Relay 端口</label>\n      <input id=\"port\" type=\"number\" value=\"18792\" placeholder=\"18792\">\n\n      <label for=\"token\">Gateway Token</label>\n      <input id=\"token\" type=\"password\" autocomplete=\"off\" placeholder=\"输入 Gateway Token\">\n\n      <div class=\"btn-row\">\n        <button id=\"save\">保存配置</button>\n        <button id=\"authorize\" class=\"secondary\">立即授权 (24小时)</button>\n      </div>\n\n      <div id=\"status\"></div>\n\n      <div id=\"authStatus\" class=\"auth-info\" style=\"display: none;\">\n        <span>授权状态: <strong id=\"authState\">已授权</strong></span>\n        <span class=\"time\" id=\"authTime\"></span>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <h2>使用说明</h2>\n      <p class=\"hint\">\n        1. 确保 OpenClaw Gateway 或 MCP 服务器已运行 (默认端口 18792)<br>\n        2. 输入与 OpenClaw 配置相同的 Gateway Token<br>\n        3. 点击\"立即授权\"或点击扩展图标进行授权<br>\n        4. 授权后 24 小时内自动控制浏览器，无需重复授权\n      </p>\n    </div>\n\n    <div class=\"card\">\n      <h2>连接地址</h2>\n      <p class=\"hint\">\n        HTTP: <code id=\"httpUrl\">http://127.0.0.1:18792/</code><br>\n        WebSocket: <code id=\"wsUrl\">ws://127.0.0.1:18792/extension</code>\n      </p>\n    </div>\n  </div>\n\n  <script src=\"options.js\"></script>\n</body>\n</html>\n"}],"isError":false,"timestamp":1772039342146}}
