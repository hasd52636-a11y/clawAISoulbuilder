{"type":"message","id":"b9bb95ff","parentId":"7a046f8b","timestamp":"2026-02-25T16:58:41.262Z","message":{"role":"toolResult","toolCallId":"call_629f75321ffc4a0e8c17d606","toolName":"read","content":[{"type":"text","text":"const DEFAULT_PORT = 18792;\nconst AUTH_EXPIRY_HOURS = 24;\n\nconst BADGE = {\n  off: { text: 'OFF', color: '#EF4444' },      // 🔴 红色 - 未授权/未连接\n  connecting: { text: '…', color: '#F59E0B' }, // 🟡 黄色 - 连接中\n  on: { text: 'ON', color: '#10B981' },        // 🟢 绿色 - 已连接/可调用\n  error: { text: '!', color: '#F97316' },      // 🟠 橙色 - 故障/错误\n};\n\nlet relayWs = null;\nlet relayConnectPromise = null;\nlet debuggerListenersInstalled = false;\n\nlet nextSession = 1;\n\nconst tabs = new Map();\nconst tabBySession = new Map();\nconst childSessionToTab = new Map();\nconst pending = new Map();\n\nconst CRYPTO_KEY = \"claw-browser-openclaw-2026\";\n\nfunction encryptData(data) {\n  try {\n    return btoa(JSON.stringify({ data, timestamp: Date.now() }));\n  } catch { return null; }\n}\n\nfunction decryptData(encryptedData) {\n  try {\n    const decrypted = JSON.parse(atob(encryptedData));\n    if (Date.now() - decrypted.timestamp > 365 * 24 * 60 * 60 * 1000) return null;\n    return decrypted.data;\n  } catch { return null; }\n}\n\nasync function getConfig() {\n  const stored = await chrome.storage.local.get(['relayPort', 'gatewayToken', 'authTimestamp']);\n  const port = Number.parseInt(String(stored.relayPort || ''), 10) || DEFAULT_PORT;\n  const token = String(stored.gatewayToken || '').trim();\n  const timestamp = Number(stored.authTimestamp) || 0;\n  return { port, token, timestamp };\n}\n\nfunction isAuthValid(timestamp) {\n  if (!timestamp) return false;\n  return Date.now() < timestamp + (AUTH_EXPIRY_HOURS * 60 * 60 * 1000);\n}\n\n\n[428 more lines in file. Use offset=51 to continue.]"}],"isError":false,"timestamp":1772038721257}}
