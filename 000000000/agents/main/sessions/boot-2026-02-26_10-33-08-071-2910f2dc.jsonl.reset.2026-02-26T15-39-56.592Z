{"type":"message","id":"7fca57ef","parentId":"bf3104cb","timestamp":"2026-02-26T12:14:20.516Z","message":{"role":"assistant","content":[{"type":"text","text":"          "},{"type":"toolCall","id":"call_9f2bc0da5b7b463087bb6e83","name":"write","arguments":{"path":"C:\\Users\\lenovo\\.openclaw\\skills\\claw-browser\\scripts\\build-mcp.ps1","content":"# AutoClaw MCP Server Build Script (PowerShell)\n# Usage: .\\scripts\\build-mcp.ps1 [-Clean] [-Production]\n\nWrite-Host \"🔨 Building AutoClaw MCP Server...\" -ForegroundColor Green\n\n# Set default values\n$CleanBuild = $false\n$Environment = \"development\"\n\n# Parse command line arguments\nfor ($i = 0; $i -lt $args.Count; $i++) {\n    switch ($args[$i]) {\n        \"-Clean\" {\n            $CleanBuild = $true\n        }\n        \"-Production\" {\n            $Environment = \"production\"\n        }\n        default {\n            Write-Host \"Unknown option: $($args[$i])\" -ForegroundColor Red\n            exit 1\n        }\n    }\n}\n\n# Change to MCP directory\nSet-Location \"$PSScriptRoot\\..\\autoclaw-mcp\"\n\n# Clean if requested\nif ($CleanBuild) {\n    Write-Host \"🧹 Cleaning previous builds...\" -ForegroundColor Yellow\n    if (Test-Path \"dist\") {\n        Remove-Item -Recurse -Force \"dist\"\n    }\n    if (Test-Path \"tsconfig.tsbuildinfo\") {\n        Remove-Item -Force \"tsconfig.tsbuildinfo\"\n    }\n}\n\n# Install dependencies if node_modules doesn't exist\nif (-not (Test-Path \"node_modules\")) {\n    Write-Host \"📦 Installing dependencies...\" -ForegroundColor Yellow\n    npm install\n    if ($LASTEXITCODE -ne 0) {\n        Write-Host \"❌ npm install failed\" -ForegroundColor Red\n        exit 1\n    }\n}\n\n# Run TypeScript build\nWrite-Host \"📝 Compiling TypeScript ($Environment mode)...\" -ForegroundColor Cyan\n\nif ($Environment -eq \"production\") {\n    npm run build:prod\n} else {\n    npm run build\n}\n\n# Check if build was successful\nif ($LASTEXITCODE -eq 0 -and (Test-Path \"dist\\server.js\")) {\n    $fileSize = (Get-Item \"dist\\server.js\").Length / 1KB\n    Write-Host \"✅ Build successful!\" -ForegroundColor Green\n    Write-Host \"📁 Output: dist\\server.js\" -ForegroundColor Cyan\n    Write-Host \"📦 Size: $([math]::Round($fileSize, 2)) KB\" -ForegroundColor Cyan\n} else {\n    Write-Host \"❌ Build failed!\" -ForegroundColor Red\n    exit 1\n}"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":89469,"output":650,"cacheRead":0,"cacheWrite":0,"totalTokens":90119,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772108011289}}
