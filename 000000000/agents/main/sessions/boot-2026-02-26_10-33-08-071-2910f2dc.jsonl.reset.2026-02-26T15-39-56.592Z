{"type":"message","id":"344e81bb","parentId":"fab60687","timestamp":"2026-02-26T11:15:11.469Z","message":{"role":"assistant","content":[{"type":"text","text":"          让我检查插件选项页面的JavaScript文件，这里可能包含token配置"},{"type":"toolCall","id":"call_232d973760c14c8b8f12b360","name":"read","arguments":{"path":"C:\\Users\\lenovo\\.openclaw\\skills\\claw-browser\\autoclaw-plugin\\options.js"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":22073,"output":54,"cacheRead":0,"cacheWrite":0,"totalTokens":22127,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772104493412}}
{"type":"message","id":"a4e314a2","parentId":"344e81bb","timestamp":"2026-02-26T11:15:11.485Z","message":{"role":"toolResult","toolCallId":"call_232d973760c14c8b8f12b360","toolName":"read","content":[{"type":"text","text":"const DEFAULT_PORT = 18789;\nconst DEFAULT_AUTH_HOURS = 24;\n\nfunction clampPort(value) {\n  const n = Number.parseInt(String(value || ''), 10);\n  if (!Number.isFinite(n) || n <= 0 || n > 65535) return DEFAULT_PORT;\n  return n;\n}\n\nfunction clampHours(value) {\n  const n = Number.parseInt(String(value || ''), 10);\n  if (!Number.isFinite(n) || n < 1) return 1;\n  if (n > 99) return 99;\n  return n;\n}\n\nfunction clampMaxTabs(value) {\n  const n = Number.parseInt(String(value || ''), 10);\n  if (!Number.isFinite(n) || n < 1) return 50;\n  if (n > 50) return 50;\n  return n;\n}\n\nfunction setStatus(kind, message) {\n  const status = document.getElementById('status');\n  if (!status) return;\n  status.className = 'status ' + (kind || '');\n  status.textContent = message || '';\n}\n\nfunction updateUrls(port) {\n  document.getElementById('wsUrl').textContent = `ws://127.0.0.1:${port}/extension`;\n}\n\nasync function checkServer(port, token) {\n  const trimmedToken = String(token || '').trim();\n  if (!trimmedToken) { setStatus('error', '请输入 Gateway Token'); return false; }\n  try {\n    const wsUrl = `ws://127.0.0.1:${port}/extension?token=${encodeURIComponent(trimmedToken)}`;\n    const ws = new WebSocket(wsUrl);\n    await new Promise((resolve, reject) => {\n      const timeout = setTimeout(() => reject(new Error('连接超时')), 2000);\n      ws.onopen = () => { clearTimeout(timeout); ws.close(); resolve(); };\n      ws.onerror = () => { clearTimeout(timeout); reject(new Error('连接失败')); };\n    });\n    setStatus('ok', `连接成功 (ws://127.0.0.1:${port}/extension)`);\n    return true;\n  } catch { setStatus('error', `连接失败于 ws://127.0.0.1:${port}/extension`); return false; }\n}\n\nasync function load() {\n  const stored = await chrome.storage.local.get(['relayPort', 'gatewayToken', 'authTimestamp', 'authHours', 'autoAttachAll', 'openMode', 'maxTabs']);\n  const port = clampPort(stored.relayPort);\n  const token = String(stored.gatewayToken || '').trim();\n  const timestamp = Number(stored.authTimestamp) || 0;\n  const authHours = clampHours(stored.authHours);\n  const autoAttachAll = stored.autoAttachAll === true;\n  const openMode = stored.openMode || 'current';\n  const maxTabs = clampMaxTabs(stored.maxTabs);\n  document.getElementById('port').value = String(port);\n  document.getElementById('token').value = token;\n  document.getElementById('authHoursSlider').value = authHours;\n  document.getElementById('authHoursDisplay').textContent = authHours + '小时';\n  document.getElementById('autoAttachAll').checked = autoAttachAll;\n  document.getElementById('maxTabs').value = maxTabs;\n  document.querySelectorAll('input[name=\"openMode\"]').forEach(r => r.checked = r.value === openMode);\n  updateUrls(port);\n  if (timestamp) {\n    const now = Date.now();\n    const expiry = timestamp + (authHours * 60 * 60 * 1000);\n    const authInfo = document.getElementById('authStatus');\n    const authTime = document.getElementById('authTime');\n    authInfo.style.display = 'flex';\n    authTime.textContent = now < expiry ? `剩余约 ${Math.round((expiry - now) / 60000)} 分钟` : '已过期';\n  }\n  if (token) await checkServer(port, token);\n}\n\nfunction updateConfirmButton() {\n  const hours = parseInt(document.getElementById('authHoursSlider').value, 10);\n  const token = document.getElementById('token').value.trim();\n  const btn = document.getElementById('authorize');\n  btn.disabled = !token;\n  btn.textContent = token ? `确认授权 (${hours}小时)` : '请先输入Token';\n}\n\nasync function save() {\n  const port = clampPort(document.getElementById('port').value);\n  const token = String(document.getElementById('token').value || '').trim();\n  const authHours = clampHours(document.getElementById('authHoursSlider').value);\n  const autoAttachAll = document.getElementById('autoAttachAll').checked;\n  const openMode = document.querySelector('input[name=\"openMode\"]:checked').value;\n  const maxTabs = clampMaxTabs(document.getElementById('maxTabs').value);\n  await chrome.storage.local.set({ relayPort: port, gatewayToken: token, authHours, autoAttachAll, openMode, maxTabs });\n  document.getElementById('port').value = String(port);\n  document.getElementById('token').value = token;\n  updateUrls(port);\n  updateConfirmButton();\n  await checkServer(port, token);\n}\n\nfunction showConfirmBox() {\n  document.getElementById('confirmHours').textContent = document.getElementById('authHoursSlider').value + '小时';\n  document.getElementById('confirmBox').classList.add('show');\n}\nfunction hideConfirmBox() { document.getElementById('confirmBox').classList.remove('show'); }\n\nasync function authorize() {\n  const port = clampPort(document.getElementById('port').value);\n  const token = String(document.getElementById('token').value || '').trim();\n  const authHours = clampHours(document.getElementById('authHoursSlider').value);\n  if (!token) { setStatus('error', '请先输入 Token'); return; }\n  const ok = await checkServer(port, token);\n  if (!ok) return;\n  const timestamp = Date.now();\n  const autoAttachAll = document.getElementById('autoAttachAll').checked;\n  const openMode = document.querySelector('input[name=\"openMode\"]:checked').value;\n  const maxTabs = clampMaxTabs(document.getElementById('maxTabs').value);\n  await chrome.storage.local.set({ relayPort: port, gatewayToken: token, authTimestamp: timestamp, authHours, autoAttachAll, openMode, maxTabs });\n  hideConfirmBox();\n  setStatus('ok', `授权成功！有效期 ${authHours} 小时`);\n  document.getElementById('authStatus').style.display = 'flex';\n  document.getElementById('authTime').textContent = `剩余约 ${authHours * 60} 分钟`;\n  chrome.runtime.sendMessage({ action: 'tryConnect' }, () => {});\n  if (autoAttachAll) chrome.runtime.sendMessage({ action: 'autoAttachAllTabs' }, () => {});\n}\n\ndocument.getElementById('authHoursSlider').addEventListener('input', (e) => {\n  document.getElementById('authHoursDisplay').textContent = e.target.value + '小时';\n  updateConfirmButton();\n});\ndocument.getElementById('authHoursSlider').addEventListener('change', () => {\n  if (document.getElementById('token').value.trim()) showConfirmBox();\n});\ndocument.getElementById('confirmAuthBtn').addEventListener('click', authorize);\ndocument.getElementById('cancelAuthBtn').addEventListener('click', hideConfirmBox);\ndocument.getElementById('authorize').addEventListener('click', showConfirmBox);\nload();\n"}],"isError":false,"timestamp":1772104511479}}
