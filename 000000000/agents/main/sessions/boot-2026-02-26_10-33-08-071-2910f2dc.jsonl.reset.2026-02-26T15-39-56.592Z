{"type":"message","id":"3359ead8","parentId":"ef73c1ee","timestamp":"2026-02-26T14:42:07.479Z","message":{"role":"assistant","content":[{"type":"text","text":"          我来帮您打开收藏夹中N8N文件夹里的所有链接。让我先获取书签信息，然后筛选出N8N文件夹中的链接。"},{"type":"toolCall","id":"call_73c6b66b9eb140baaf44ce8c","name":"write","arguments":{"path":"C:\\Users\\lenovo\\.openclaw\\workspace\\open_n8n_bookmarks.js","content":"const WebSocket = require('ws');\n\nconsole.log('📚 获取N8N收藏夹链接...');\n\nconst wsUrl = 'ws://127.0.0.1:30000/mcp';\n\n// 第一步：获取所有书签\nconst getBookmarksMessage = {\n  jsonrpc: \"2.0\",\n  id: 8,\n  method: \"tools/call\",\n  params: {\n    name: \"claw_get_bookmarks\",\n    arguments: {}\n  }\n};\n\n// 第二步：获取书签树结构（包含文件夹信息）\nconst getBookmarkTreeMessage = {\n  jsonrpc: \"2.0\",\n  id: 9,\n  method: \"tools/call\",\n  params: {\n    name: \"claw_get_bookmark_tree\",\n    arguments: {}\n  }\n};\n\nconsole.log('搜索N8N文件夹中的链接...');\n\ntry {\n    const ws = new WebSocket(wsUrl);\n    let bookmarks = [];\n    let bookmarkTree = [];\n    \n    ws.on('open', function open() {\n        console.log('✅ MCP连接成功');\n        // 先获取书签列表\n        ws.send(JSON.stringify(getBookmarksMessage));\n        console.log('📤 已发送获取书签请求');\n    });\n    \n    ws.on('message', function incoming(data) {\n        const response = JSON.parse(data.toString());\n        \n        if (response.id === 8) {\n            // 书签列表获取完成\n            if (response.result && response.result.content) {\n                bookmarks = JSON.parse(response.result.content[0].text);\n                console.log(`📖 找到 ${bookmarks.length} 个书签`);\n                \n                // 现在获取书签树结构\n                ws.send(JSON.stringify(getBookmarkTreeMessage));\n                console.log('📤 已发送获取书签树请求');\n            }\n        } else if (response.id === 9) {\n            // 书签树获取完成\n            if (response.result && response.result.content) {\n                bookmarkTree = JSON.parse(response.result.content[0].text);\n                console.log('🌳 书签树结构获取完成');\n                \n                // 查找N8N文件夹\n                findAndOpenN8NLinks(ws, bookmarks, bookmarkTree);\n            }\n        }\n    });\n    \n    ws.on('error', function error(err) {\n        console.log('❌ 连接错误:', err.message);\n        process.exit(1);\n    });\n    \n    setTimeout(() => {\n        console.log('⏰ 响应超时');\n        ws.close();\n        process.exit(1);\n    }, 20000);\n    \n    function findAndOpenN8NLinks(ws, bookmarks, tree) {\n        // 在书签树中查找N8N文件夹\n        function findFolder(tree, name) {\n            for (const item of tree) {\n                if (item.title && item.title.toLowerCase().includes(name.toLowerCase())) {\n                    return item;\n                }\n                if (item.children) {\n                    const found = findFolder(item.children, name);\n                    if (found) return found;\n                }\n            }\n            return null;\n        }\n        \n        const n8nFolder = findFolder(tree, 'n8n');\n        \n        if (!n8nFolder) {\n            console.log('❌ 没有找到N8N文件夹');\n            console.log('📋 可用的文件夹:');\n            listFolders(tree);\n            ws.close();\n            return;\n        }\n        \n        console.log(`✅ 找到N8N文件夹: ${n8nFolder.title}`);\n        \n        // 获取N8N文件夹中的所有链接\n        const n8nLinks = bookmarks.filter(b => b.parentId === n8nFolder.id && b.url);\n        \n        if (n8nLinks.length === 0) {\n            console.log('❌ N8N文件夹中没有找到链接');\n            ws.close();\n            return;\n        }\n        \n        console.log(`🔗 找到 ${n8nLinks.length} 个N8N链接:`);\n        n8nLinks.forEach((link, index) => {\n            console.log(`   ${index + 1}. ${link.title} - ${link.url}`);\n        });\n        \n        // 逐个打开链接\n        openLinksSequentially(ws, n8nLinks);\n    }\n    \n    function listFolders(tree, depth = 0) {\n        for (const item of tree) {\n            if (item.children) {\n                console.log('   '.repeat(depth) + `📁 ${item.title} (${item.id})`);\n                listFolders(item.children, depth + 1);\n            }\n        }\n    }\n    \n    function openLinksSequentially(ws, links) {\n        let currentIndex = 0;\n        \n        function openNextLink() {\n            if (currentIndex >= links.length) {\n                console.log('🎉 所有N8N链接已打开完成！');\n                ws.close();\n                return;\n            }\n            \n            const link = links[currentIndex];\n            console.log(`\\n🌐 打开链接 ${currentIndex + 1}/${links.length}: ${link.title}`);\n            \n            const navigateMessage = {\n                jsonrpc: \"2.0\",\n                id: 10 + currentIndex,\n                method: \"tools/call\",\n                params: {\n                    name: \"claw_navigate\",\n                    arguments: {\n                        url: link.url\n                    }\n                }\n            };\n            \n            ws.send(JSON.stringify(navigateMessage));\n            console.log('📤 导航指令已发送');\n            \n            // 等待2秒后打开下一个链接\n            setTimeout(() => {\n                currentIndex++;\n                openNextLink();\n            }, 2000);\n        }\n        \n        openNextLink();\n    }\n    \n} catch (error) {\n    console.log('💥 测试异常:', error.message);\n    process.exit(1);\n}"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":83394,"output":1568,"cacheRead":0,"cacheWrite":0,"totalTokens":84962,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772116832338}}
