{"type":"message","id":"da3c9a3f","parentId":"c1d09925","timestamp":"2026-02-26T14:52:28.587Z","message":{"role":"toolResult","toolCallId":"call_56ff1da83cba4492a062d582","toolName":"read","content":[{"type":"text","text":"    .radio-item { display: flex; align-items: center; gap: 6px; cursor: pointer; }\n    .radio-item input[type=\"radio\"] { accent-color: var(--accent); }\n\n    /* ── Buttons ── */\n    .btn {\n      display: inline-flex; align-items: center; gap: 8px;\n      padding: 10px 20px; border-radius: 8px; border: none;\n      font-size: 14px; font-weight: 600; cursor: pointer;\n      transition: all .2s;\n    }\n    .btn:disabled { opacity: .5; cursor: not-allowed; }\n    .btn-primary { background: var(--accent); color: white; }\n    .btn-primary:hover:not(:disabled) { background: #4f46e5; }\n    .btn-success { background: var(--success); color: white; }\n    .btn-success:hover:not(:disabled) { background: #059669; }\n    .btn-danger  { background: var(--danger); color: white; }\n    .btn-danger:hover:not(:disabled) { background: #dc2626; }\n    .btn-ghost   { background: var(--surface2); color: var(--text); border: 1px solid var(--border); }\n    .btn-ghost:hover:not(:disabled) { border-color: var(--accent); color: var(--accent2); }\n\n    .btn-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 12px; }\n\n    /* ── Feedback ── */\n    .feedback {\n      margin-top: 12px; padding: 10px 14px;\n      border-radius: 8px; font-size: 13px;\n      display: none;\n    }\n    .feedback.ok  { display: block; background: #064e3b; color: #6ee7b7; border: 1px solid #065f46; }\n    .feedback.err { display: block; background: #450a0a; color: #fca5a5; border: 1px solid #7f1d1d; }\n\n[146 more lines in file. Use offset=210 to continue.]"}],"isError":false,"timestamp":1772117548570}}
