{"type":"message","id":"3fee050b","parentId":"59518141","timestamp":"2026-02-25T08:30:40.980Z","message":{"role":"assistant","content":[{"type":"text","text":"                                                                                                                                      脚本有语法错误。让我重新写一个简单的版本"},{"type":"toolCall","id":"call_274ce4fcf26e4345a106a954","name":"write","arguments":{"path":"C:\\Users\\lenovo\\.openclaw\\config-manager.ps1","content":"# OpenClaw 配置管理器\n# 安全的配置修改与备份\n\nparam(\n    [string]$Action,\n    [string]$Path,\n    [string]$Value\n)\n\n# 显示帮助\nif (-not $Action) {\n    Write-Host \"OpenClaw配置管理器\"\n    Write-Host \"用法: config-manager.ps1 <action> <path> [value]\"\n    Write-Host \"动作: backup, restore, set, get\"\n    Write-Host \"\"\n    Write-Host \"示例:\"\n    Write-Host \"  config-manager.ps1 backup\"\n    Write-Host \"  config-manager.ps1 set gateway.port 8080\"  \n    Write-Host \"  config-manager.ps1 get gateway.port\"\n    Write-Host \"  config-manager.ps1 restore config-backup-20260225-162826\"\n    exit 0\n}\n\n$ConfigPath = \"C:\\Users\\lenovo\\.openclaw\\openclaw.json\"\n$BackupDir = \"C:\\Users\\lenovo\\.openclaw\\config-backups\"\n\n# 创建备份目录\nif (-not (Test-Path $BackupDir)) {\n    New-Item -ItemType Directory -Path $BackupDir -Force\n}\n\n# 备份配置\nif ($Action -eq \"backup\") {\n    $BackupName = \"config-backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"\n    $BackupFile = \"$BackupDir\\$BackupName.json\"\n    \n    Copy-Item $ConfigPath $BackupFile\n    Write-Host \"配置备份已创建: $BackupFile\"\n    Write-Host \"备份名称: $BackupName\"\n    exit 0\n}\n\n# 恢复配置\nif ($Action -eq \"restore\") {\n    if (-not $Path) {\n        Write-Host \"请提供备份名称\"\n        Write-Host \"可用备份:\"\n        Get-ChildItem \"$BackupDir\\*.json\" | ForEach-Object {\n            $_.Name.Replace('.json', '')\n        }\n        exit 1\n    }\n    \n    $BackupFile = \"$BackupDir\\$Path.json\"\n    if (-not (Test-Path $BackupFile)) {\n        Write-Host \"备份文件不存在: $BackupFile\"\n        exit 1\n    }\n    \n    Copy-Item $BackupFile $ConfigPath -Force\n    Write-Host \"配置已从备份恢复: $Path\"\n    exit 0\n}\n\n# 获取配置\nif ($Action -eq \"get\") {\n    if (-not $Path) {\n        Write-Host \"请提供配置路径\"\n        exit 1\n    }\n    \n    openclaw config get $Path\n    exit 0\n}\n\n# 设置配置（安全模式）\nif ($Action -eq \"set\") {\n    if (-not $Path -or -not $Value) {\n        Write-Host \"请提供配置路径和值\"\n        exit 1\n    }\n    \n    # 先创建备份\n    $BackupName = \"config-backup-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"\n    $BackupFile = \"$BackupDir\\$BackupName.json\"\n    Copy-Item $ConfigPath $BackupFile\n    \n    Write-Host \"备份已创建: $BackupName\"\n    \n    # 执行配置修改\n    try {\n        openclaw config set $Path $Value\n        if ($LASTEXITCODE -eq 0) {\n            Write-Host \"配置修改成功!\"\n            Write-Host \"\"\n            Write-Host \"=== 安全提示 ===\"\n            Write-Host \"配置已修改，备份已创建: $BackupName\"\n            Write-Host \"如需恢复，请运行: config-manager.ps1 restore $BackupName\"\n            Write-Host \"\"\n            Write-Host \"等待2分钟确认配置是否正常工作...\"\n            Write-Host \"如果发现问题，请立即运行恢复命令\"\n            Write-Host \"================\"\n        } else {\n            Write-Host \"配置修改失败，自动恢复备份...\"\n            Copy-Item $BackupFile $ConfigPath -Force\n            Write-Host \"配置已恢复\"\n        }\n    }\n    catch {\n        Write-Host \"配置修改过程中出错，自动恢复备份...\"\n        Copy-Item $BackupFile $ConfigPath -Force\n        Write-Host \"配置已恢复\"\n    }\n    \n    exit 0\n}\n\nWrite-Host \"未知动作: $Action\"\nexit 1"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":80538,"output":1177,"cacheRead":0,"cacheWrite":0,"totalTokens":81715,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772008171004}}
