{"type":"message","id":"ede447c1","parentId":"0432d8c1","timestamp":"2026-02-25T16:10:35.708Z","message":{"role":"assistant","content":[{"type":"text","text":"                                                                                                                                      现在让我测试WebSocket连接。创建一个简单的测试脚本来模拟扩展的连接"},{"type":"toolCall","id":"call_cf30fd5029874ac58b60caef","name":"write","arguments":{"path":"C:\\Users\\lenovo\\.openclaw\\test-ws.js","content":"// 模拟扩展的WebSocket连接\nconst WebSocket = require('ws');\n\nconst token = \"Q0hpK2oV4F9tlwbYX3RELxiJNGDvayr8OPqZzkfs\";\nconst wsUrl = `ws://127.0.0.1:18792/extension?token=${encodeURIComponent(token)}`;\n\nconsole.log(\"连接URL:\", wsUrl);\n\nconst ws = new WebSocket(wsUrl);\n\nws.on('open', () => {\n  console.log('✅ WebSocket连接成功!');\n  \n  // 发送ping消息\n  ws.send(JSON.stringify({\n    method: \"ping\",\n    id: 1\n  }));\n});\n\nws.on('message', (data) => {\n  console.log('📨 收到消息:', data.toString());\n});\n\nws.on('error', (error) => {\n  console.log('❌ WebSocket错误:', error.message);\n});\n\nws.on('close', (code, reason) => {\n  console.log(`🔌 连接关闭: ${code} - ${reason}`);\n});\n\n// 3秒后关闭连接\nsetTimeout(() => {\n  ws.close();\n  process.exit(0);\n}, 5000);"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":97904,"output":358,"cacheRead":0,"cacheWrite":0,"totalTokens":98262,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772035801098}}
