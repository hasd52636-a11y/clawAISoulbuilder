Write-Host \"配置修改过程中出错，自动恢复备份...\"\n    & \"C:\\Users\\lenovo\\.openclaw\\config-restore.ps1\" $BackupName\n}"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":78165,"output":667,"cacheRead":0,"cacheWrite":0,"totalTokens":78832,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772001071781}}
