{"type":"message","id":"1a502aed","parentId":"1c17a38e","timestamp":"2026-02-25T16:35:00.777Z","message":{"role":"toolResult","toolCallId":"call_d0126119d23f43d6b7f9a091","toolName":"read","content":[{"type":"text","text":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>ClawBrowser</title>\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body { width: 280px; padding: 12px; font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; background: #f5f5f5; }\n    .header { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }\n    .status-dot { width: 10px; height: 10px; border-radius: 50%; }\n    .status-dot.authorized { background: #4CAF50; }\n    .status-dot.unauthorized { background: #9E9E9E; }\n    .status-dot.connecting { background: #F59E0B; }\n    h1 { font-size: 14px; color: #333; }\n    .card { background: white; border-radius: 8px; padding: 12px; margin-bottom: 10px; }\n    .card h3 { font-size: 11px; color: #666; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px; }\n    button { width: 100%; padding: 10px; border: none; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 500; margin-bottom: 6px; }\n    button.primary { background: #4CAF50; color: white; }\n    button.primary:hover { background: #45a049; }\n    button.secondary { background: #2196F3; color: white; }\n    button.secondary:hover { background: #1976D2; }\n    button:disabled { background: #ccc; cursor: not-allowed; }\n    .info { font-size: 12px; color: #666; text-align: center; margin-top: 8px; }\n    .info a { color: #2196F3; text-decoration: none; }\n  </style>\n</head>\n<body>\n  <div class=\"header\">\n    <div class=\"status-dot\" id=\"statusDot\"></div>\n    <h1>ClawBrowser 控制器</h1>\n  </div>\n\n  <div class=\"card\">\n    <h3>连接状态</h3>\n    <div id=\"connectionStatus\" style=\"font-size: 12px; color: #666; margin-bottom: 10px;\">检查中...</div>\n    <button id=\"toggleBtn\" class=\"primary\">点击授权/断开</button>\n  </div>\n\n  <div class=\"card\">\n    <h3>快捷操作</h3>\n    <button id=\"openOptionsBtn\" class=\"secondary\">扩展设置</button>\n    <button id=\"refreshStatusBtn\" class=\"secondary\">刷新状态</button>\n  </div>\n\n  <p class=\"info\">\n    首次授权后 24 小时内有效<br>\n    <a href=\"#\" id=\"helpLink\">查看使用帮助</a>\n  </p>\n\n  <script src=\"popup.js\"></script>\n</body>\n</html>\n"}],"isError":false,"timestamp":1772037300761}}
