{"type":"message","id":"44fe0095","parentId":"216f1705","timestamp":"2026-02-25T06:31:11.766Z","message":{"role":"assistant","content":[{"type":"text","text":"                                                                                                                  现在创建一个手动恢复脚本"},{"type":"toolCall","id":"call_f067b4dd435f4fc6ac70b432","name":"write","arguments":{"path":"C:\\Users\\lenovo\\.openclaw\\config-restore.ps1","content":"# OpenClaw 配置恢复脚本\n# 从备份恢复配置\n\nparam(\n    [string]$BackupName\n)\n\nif (-not $BackupName) {\n    Write-Host \"请提供备份名称\"\n    Write-Host \"可用备份:\"\n    Get-ChildItem \"C:\\Users\\lenovo\\.openclaw\\config-backups\\*.json\" | ForEach-Object {\n        $_.Name.Replace('.json', '')\n    }\n    exit 1\n}\n\n$BackupDir = \"C:\\Users\\lenovo\\.openclaw\\config-backups\"\n$ConfigPath = \"C:\\Users\\lenovo\\.openclaw\\config.json\"\n$BackupFile = \"$BackupDir\\$BackupName.json\"\n\nif (-not (Test-Path $BackupFile)) {\n    Write-Host \"备份文件不存在: $BackupFile\"\n    exit 1\n}\n\n# 恢复配置\nCopy-Item $BackupFile $ConfigPath -Force\nWrite-Host \"配置已从备份恢复: $BackupName\"\n\n# 可选：删除备份文件\n$Confirm = Read-Host \"是否删除备份文件？(y/N)\"\nif ($Confirm -eq 'y') {\n    Remove-Item $BackupFile -Force\n    Write-Host \"备份文件已删除\"\n}"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":77778,"output":359,"cacheRead":0,"cacheWrite":0,"totalTokens":78137,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772001029491}}
