\r\nd-----         2026/2/23      8:47                himalaya                                                             \r\nd-----         2026/2/23      8:47                imsg                                                                 \r\nd-----         2026/2/23      8:47                mcporter                                                             \r\nd-----         2026/2/23      8:47                model-usage                                                          \r\nd-----         2026/2/23      8:47                nano-banana-pro                                                      \r\nd-----         2026/2/23      8:47                nano-pdf                                                             \r\nd-----         2026/2/23      8:47                notion                                                               \r\nd-----         2026/2/23      8:47                obsidian                                                             \r\nd-----         2026/2/23      8:47                openai-image-gen                                                     \r\nd-----         2026/2/23      8:47                openai-whisper                                                       \r\nd-----         2026/2/23      8:47                openai-whisper-api                                                   \r\nd-----         2026/2/23      8:47                openhue                                                              \r\nd-----         2026/2/23      8:47                oracle                                                               \r\nd-----         2026/2/23      8:47                ordercli                                                             \r\nd-----         2026/2/23      8:47                peekaboo                                                             \r\nd-----         2026/2/23      8:47                sag                                                                  \r\nd-----         2026/2/23    