{"type":"message","id":"ba9a1508","parentId":"b1e7e41b","timestamp":"2026-02-25T20:12:58.604Z","message":{"role":"toolResult","toolCallId":"call_2f933de69e204af4add298a0","toolName":"read","content":[{"type":"text","text":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>autoclaw 设置 - Settings</title>\n  <style>\n    :root {\n      --accent: #4CAF50;\n      --panel: #ffffff;\n      --border: #e0e0e0;\n      --muted: #666;\n      --bg: #f5f5f5;\n    }\n    body {\n      margin: 0;\n      min-height: 100vh;\n      background: var(--bg);\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n      color: #333;\n    }\n    .wrap {\n      max-width: 800px;\n      margin: 40px auto;\n      padding: 0 20px;\n    }\n    header {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      margin-bottom: 24px;\n    }\n    .logo {\n      width: 48px;\n      height: 48px;\n      border-radius: 12px;\n      background: var(--accent);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      color: white;\n      font-size: 24px;\n      font-weight: bold;\n    }\n    h1 {\n      font-size: 20px;\n      margin: 0;\n    }\n    .subtitle {\n      color: var(--muted);\n      font-size: 13px;\n      margin-top: 4px;\n    }\n    .card {\n      background: var(--panel);\n      border: 1px solid var(--border);\n      border-radius: 12px;\n      padding: 20px;\n      margin-bottom: 16px;\n    }\n    .card h2 {\n      font-size: 14px;\n      margin: 0 0 12px 0;\n      color: var(--muted);\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n    }\n    .label-bilingual {\n      margin-bottom: 6px;\n    }\n    .label-bilingual .zh {\n      font-size: 13px;\n      color: var(--muted);\n    }\n    .label-bilingual .en {\n      font-size: 11px;\n      color: #999;\n    }\n    input[type=\"text\"],\n    input[type=\"password\"],\n    input[type=\"number\"] {\n      width: 100%;\n      padding: 12px;\n      border-radius: 8px;\n      border: 1px solid var(--border);\n      font-size: 14px;\n      box-sizing: border-box;\n      margin-bottom: 12px;\n    }\n    input:focus {\n      outline: none;\n      border-color: var(--accent);\n    }\n    input[type=\"range\"] {\n      width: 100%;\n      margin: 10px 0;\n    }\n    .range-container {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      margin-bottom: 12px;\n    }\n    .range-container input[type=\"range\"] {\n      flex: 1;\n    }\n    .range-value {\n      min-width: 50px;\n      padding: 6px 12px;\n      background: #e8f5e9;\n      border-radius: 6px;\n      text-align: center;\n      font-weight: 600;\n      color: var(--accent);\n    }\n    button {\n      padding: 12px 20px;\n      border-radius: 8px;\n      border: none;\n      background: var(--accent);\n      color: white;\n      font-size: 14px;\n      font-weight: 600;\n      cursor: pointer;\n    }\n    button:hover {\n      background: #45a049;\n    }\n    button.secondary {\n      background: #2196F3;\n    }\n    button.secondary:hover {\n      background: #1976D2;\n    }\n    button:disabled {\n      background: #ccc;\n      cursor: not-allowed;\n    }\n    .hint {\n      font-size: 12px;\n      color: var(--muted);\n      margin-top: 8px;\n    }\n    .hint .en {\n      font-size: 11px;\n      color: #999;\n    }\n    code {\n      background: #f0f0f0;\n      padding: 2px 6px;\n      border-radius: 4px;\n      font-family: monospace;\n    }\n    .status {\n      margin-top: 12px;\n      padding: 10px;\n      border-radius: 8px;\n      font-size: 13px;\n    }\n    .status.ok {\n      background: #e8f5e9;\n      color: #2e7d32;\n    }\n    .status.error {\n      background: #ffebee;\n      color: #c62828;\n    }\n    .auth-info {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 12px;\n      background: #e8f5e9;\n      border-radius: 8px;\n      margin-top: 12px;\n    }\n    .auth-info .time {\n      font-size: 12px;\n      color: var(--muted);\n    }\n    .btn-row {\n      display: flex;\n      gap: 10px;\n    }\n    .checkbox-container {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      margin-bottom: 12px;\n      cursor: pointer;\n    }\n    .checkbox-container input[type=\"checkbox\"] {\n      width: 18px;\n      height: 18px;\n      cursor: pointer;\n    }\n    .checkbox-container span {\n      font-size: 14px;\n      color: #333;\n    }\n    .checkbox-container .en {\n      font-size: 12px;\n      color: #666;\n      margin-left: 4px;\n    }\n    .radio-group {\n      display: flex;\n      gap: 20px;\n      margin-bottom: 12px;\n    }\n    .radio-item {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      cursor: pointer;\n    }\n    .radio-item input[type=\"radio\"] {\n      width: 18px;\n      height: 18px;\n      cursor: pointer;\n    }\n    .radio-item .zh {\n      font-size: 14px;\n      color: #333;\n    }\n    .radio-item .en {\n      font-size: 12px;\n      color: #666;\n      margin-left: 4px;\n    }\n    .confirm-box {\n      display: none;\n      margin-top: 12px;\n      padding: 12px;\n      background: #fff3e0;\n      border: 1px solid #ffb74d;\n      border-radius: 8px;\n    }\n    .confirm-box.show {\n      display: block;\n    }\n    .tabs-count {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      margin-top: 12px;\n    }\n    .tabs-count input[type=\"number\"] {\n      width: 80px;\n      margin-bottom: 0;\n    }\n    .links {\n      display: flex;\n      gap: 16px;\n      flex-wrap: wrap;\n      margin-top: 8px;\n    }\n    .links a {\n      color: #2196F3;\n      text-decoration: none;\n      font-size: 13px;\n      padding: 8px 16px;\n      background: #e3f2fd;\n      border-radius: 6px;\n    }\n    .links a:hover {\n      background: #bbdefb;\n    }\n    .links a .en {\n      font-size: 11px;\n      color: #666;\n      margin-left: 4px;\n    }\n    .form-row {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 16px;\n    }\n    .form-row .field {\n      margin-bottom: 0;\n    }\n    .step {\n      display: flex;\n      align-items: flex-start;\n      gap: 12px;\n      margin-bottom: 12px;\n      padding: 12px;\n      background: #f5f5f5;\n      border-radius: 8px;\n    }\n    .step-num {\n      width: 24px;\n      height: 24px;\n      background: var(--accent);\n      color: white;\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 12px;\n      font-weight: bold;\n      flex-shrink: 0;\n    }\n    .step-content {\n      flex: 1;\n    }\n    .step .zh {\n      font-size: 13px;\n      color: #333;\n      margin-bottom: 4px;\n    }\n    .step .en {\n      font-size: 11px;\n      color: #666;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"wrap\">\n    <header>\n      <div class=\"logo\">AC</div>\n      <div>\n        <h1>autoclaw 设置 <span style=\"font-weight:normal;font-size:14px;\">Settings</span></h1>\n        <p class=\"subtitle\">OpenClaw 浏览器控制器 · OpenClaw Browser Controller</p>\n      </div>\n    </header>\n\n    <div class=\"card\">\n      <h2>下载插件 Install Plugin</h2>\n      <div class=\"links\">\n        <a href=\"https://www.autoclaw.wboke.com\" target=\"_blank\">插件下载 <span class=\"en\">Download Plugin</span></a>\n        <a href=\"https://www.wboke.com\" target=\"_blank\">更多工具 <span class=\"en\">More Tools</span></a>\n        <a href=\"https://www.sora.wboke.com\" target=\"_blank\">Sora</a>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <h2>快速开始 Quick Start</h2>\n      <div class=\"step\">\n        <div class=\"step-num\">1</div>\n        <div class=\"step-content\">\n          <div class=\"zh\">安装插件后，在扩展设置页面配置 Token</div>\n          <div class=\"en\">After installing plugin, configure Token in extension settings</div>\n        </div>\n      </div>\n      <div class=\"step\">\n        <div class=\"step-num\">2</div>\n        <div class=\"step-content\">\n          <div class=\"zh\">设置授权时长，点击确认授权</div>\n          <div class=\"en\">Set auth duration, click confirm to authorize</div>\n        </div>\n      </div>\n      <div class=\"step\">\n        <div class=\"step-num\">3</div>\n        <div class=\"step-content\">\n          <div class=\"zh\">启用全局模式后，点击图标一次控制所有标签页</div>\n          <div class=\"en\">Enable auto mode, click icon once to control all tabs</div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <h2>授权配置 Auth Config</h2>\n      <div class=\"form-row\">\n        <div class=\"field\">\n          <div class=\"label-bilingual\">\n            <div class=\"zh\">端口 Port</div>\n          </div>\n          <input id=\"port\" type=\"number\" value=\"18888\" placeholder=\"18888\">\n        </div>\n        <div class=\"field\">\n          <div class=\"label-bilingual\">\n            <div class=\"zh\">Gateway Token</div>\n          </div>\n          <input id=\"token\" type=\"text\" autocomplete=\"off\" value=\"hanzhong_Q0hpK2oV4F9tlwbYX3RELxiJNGDvayr8OPqZzkfs\" placeholder=\"hanzhong_xxx\">\n        </div>\n      </div>\n\n      <div class=\"label-bilingual\">\n        <div class=\"zh\">授权有效期（小时）Auth Duration</div>\n      </div>\n      <div class=\"range-container\">\n        <span>1</span>\n        <input type=\"range\" id=\"authHoursSlider\" min=\"1\" max=\"99\" value=\"24\">\n        <span>99</span>\n        <div class=\"range-value\" id=\"authHoursDisplay\">24小时/h</div>\n      </div>\n\n      <div class=\"confirm-box\" id=\"confirmBox\">\n        <div class=\"label-bilingual\" style=\"margin-bottom:8px;\">\n          <div class=\"zh\">确认授权设置 Confirm Auth</div>\n        </div>\n        <p style=\"margin: 0 0 12px 0; font-size: 13px;\">授权有效期: <strong id=\"confirmHours\">24小时</strong></p>\n        <button id=\"confirmAuthBtn\">确认授权 Confirm</button>\n        <button id=\"cancelAuthBtn\" class=\"secondary\" style=\"margin-left: 8px;\">取消 Cancel</button>\n      </div>\n\n      <div class=\"btn-row\" style=\"margin-top: 12px;\">\n        <button id=\"authorize\" disabled>保存配置后授权 Save & Authorize</button>\n      </div>\n\n      <div id=\"status\"></div>\n\n      <div id=\"authStatus\" class=\"auth-info\" style=\"display: none;\">\n        <span><span class=\"zh\">授权状态</span><span class=\"en\">Auth Status</span>: <strong id=\"authState\">已授权 Authorized</strong></span>\n        <span class=\"time\" id=\"authTime\"></span>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <h2>标签页控制 Tab Control</h2>\n      <div class=\"checkbox-container\">\n        <input type=\"checkbox\" id=\"autoAttachAll\">\n        <span>启用全局自动控制<span class=\"en\">Auto control all tabs</span></span>\n      </div>\n      \n      <div style=\"margin-top: 16px; padding: 12px; background: #fff3e0; border: 1px solid #ffb74d; border-radius: 8px;\">\n        <div style=\"display: flex; align-items: center; gap: 8px; margin-bottom: 8px;\">\n          <span style=\"color: #e65100; font-size: 16px;\">⚠️</span>\n          <span style=\"font-weight: 600; color: #e65100;\">危险操作说明 Danger Warning</span>\n        </div>\n        <p style=\"margin: 0; font-size: 12px; color: #666; line-height: 1.6;\">\n          <span class=\"zh\">启用全局自动控制后，插件将自动控制所有浏览器标签页，包括：自动点击、自动填写表单、自动执行脚本等。恶意指令可能导致账户被盗、隐私泄露或财产损失。请确保：</span><br>\n          <span class=\"en\">After enabling auto control, the plugin will automatically control all browser tabs, including: auto-click, auto-fill forms, auto-execute scripts. Malicious commands may lead to account theft, privacy leaks or financial loss. Please ensure:</span>\n        </p>\n        <ul style=\"margin: 8px 0 0 0; padding-left: 20px; font-size: 11px; color: #666;\">\n          <li><span class=\"zh\">只在可信的AI环境中使用</span><span class=\"en\">Only use in trusted AI environment</span></li>\n          <li><span class=\"zh\">不要让AI执行未知或可疑的代码</span><span class=\"en\">Don't let AI execute unknown or suspicious code</span></li>\n          <li><span class=\"zh\">定期检查授权状态，及时撤销不需要的授权</span><span class=\"en\">Check auth status regularly, revoke unused auth</span></li>\n          <li><span class=\"zh\">不使用时关闭授权或卸载插件</span><span class=\"en\">Close auth or uninstall plugin when not in use</span></li>\n        </ul>\n      </div>\n      \n      <div class=\"radio-group\" style=\"margin-top: 12px;\">\n        <label class=\"radio-item\">\n          <input type=\"radio\" name=\"openMode\" value=\"current\" checked>\n          <span class=\"zh\">当前页打开</span><span class=\"en\">Current tab</span>\n        </label>\n        <label class=\"radio-item\">\n          <input type=\"radio\" name=\"openMode\" value=\"newTab\">\n          <span class=\"zh\">新标签页打开</span><span class=\"en\">New tab</span>\n        </label>\n      </div>\n\n      <div class=\"label-bilingual\" style=\"margin-top: 12px;\">\n        <div class=\"zh\">数量上限 Max Tabs</div>\n      </div>\n      <div class=\"tabs-count\">\n        <input type=\"number\" id=\"maxTabs\" value=\"50\" min=\"1\" max=\"50\">\n        <span class=\"hint\" style=\"margin: 0;\"><span class=\"zh\">个</span><span class=\"en\">tabs</span></span>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <h2>连接地址 Connection</h2>\n      <p class=\"hint\">\n        WebSocket: <code id=\"wsUrl\">ws://127.0.0.1:18888/extension</code>\n      </p>\n      \n      <div style=\"margin-top: 12px; padding: 10px; background: #e3f2fd; border: 1px solid #64b5f6; border-radius: 8px;\">\n        <div style=\"display: flex; align-items: center; gap: 6px;\">\n          <span style=\"color: #1565c0;\">🔒</span>\n          <span style=\"font-size: 12px; color: #1565c0;\">\n            <span class=\"zh\">仅允许本地连接 (127.0.0.1/localhost)，请确保Gateway运行在本地</span>\n            <span class=\"en\">Local connections only (127.0.0.1/localhost). Ensure Gateway runs locally.</span>\n          </span>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <script src=\"options.js\"></script>\n</body>\n</html>\n"}],"isError":false,"timestamp":1772050378598}}
