{"type":"message","id":"e333ffd6","parentId":"4ef4381e","timestamp":"2026-02-25T20:26:08.995Z","message":{"role":"toolResult","toolCallId":"call_66bb5a5f79cb4807980d280c","toolName":"read","content":[{"type":"text","text":"import { ToolDefinition } from \"./types.js\";\n\nexport const tools: ToolDefinition[] = [\n  // ========== 书签管理 ==========\n  {\n    name: \"claw_get_bookmarks\",\n    description: \"获取浏览器所有书签（扁平列表）\",\n    inputSchema: {\n      type: \"object\",\n      properties: {},\n      required: []\n    }\n  },\n  {\n    name: \"claw_get_bookmark_tree\",\n    description: \"获取浏览器书签树形结构\",\n    inputSchema: {\n      type: \"object\",\n      properties: {},\n      required: []\n    }\n  },\n  {\n    name: \"claw_search_bookmarks\",\n    description: \"搜索书签（支持标题和URL关键词）\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        query: { type: \"string\", description: \"搜索关键词\" }\n      },\n      required: [\"query\"]\n    }\n  },\n  {\n    name: \"claw_open_bookmark\",\n    description: \"根据关键词打开书签（模糊匹配标题或URL）\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        keyword: { type: \"string\", description: \"书签关键词\" }\n      },\n      required: [\"keyword\"]\n    }\n  },\n  {\n    name: \"claw_create_bookmark_folder\",\n    description: \"创建新的书签文件夹\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        folderName: { type: \"string\", description: \"文件夹名称\" }\n      },\n      required: [\"folderName\"]\n    }\n  },\n  {\n    name: \"claw_delete_bookmark\",\n    description: \"删除指定书签\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        bookmarkId: { type: \"string\", description: \"书签ID\" }\n      },\n      required: [\"bookmarkId\"]\n    }\n  },\n  {\n    name: \"claw_move_bookmark\",\n    description: \"移动书签到指定文件夹\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        bookmarkId: { type: \"string\", description: \"书签ID\" },\n        newParentId: { type: \"string\", description: \"目标文件夹ID\" }\n      },\n      required: [\"bookmarkId\", \"newParentId\"]\n    }\n  },\n  {\n    name: \"claw_categorize_bookmark\",\n    description: \"将书签批量分类到指定文件夹（根据关键词匹配）\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        keywords: { \n          type: \"array\", \n          items: { type: \"string\" }, \n          description: \"分类关键词数组\" \n        },\n        folderName: { type: \"string\", description: \"目标文件夹名称（不存在则创建）\" }\n      },\n      required: [\"keywords\", \"folderName\"]\n    }\n  },\n  // ========== 页面操作 ==========\n  {\n    name: \"claw_navigate\",\n    description: \"打开指定网址\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        url: { type: \"string\", description: \"目标网址\" }\n      },\n      required: [\"url\"]\n    }\n  },\n  {\n    name: \"claw_click_element\",\n    description: \"点击页面元素（通过 CSS 选择器）\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        selector: { type: \"string\", description: \"CSS 选择器\" },\n        tabId: { type: \"number\", description: \"目标标签页 ID（可选）\" }\n      },\n      required: [\"selector\"]\n    }\n  },\n  {\n    name: \"claw_fill_input\",\n    description: \"在输入框填写内容\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        selector: { type: \"string\", description: \"输入框 CSS 选择器\" },\n        text: { type: \"string\", description: \"填写内容\" },\n        tabId: { type: \"number\", description: \"目标标签页 ID（可选）\" }\n      },\n      required: [\"selector\", \"text\"]\n    }\n  },\n  {\n    name: \"claw_execute_script\",\n    description: \"在页面执行 JavaScript 代码\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        code: { type: \"string\", description: \"JavaScript 代码\" },\n        tabId: { type: \"number\", description: \"目标标签页 ID（可选）\" }\n      },\n      required: [\"code\"]\n    }\n  },\n  {\n    name: \"claw_take_screenshot\",\n    description: \"截取当前页面截图\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        tabId: { type: \"number\", description: \"目标标签页 ID（可选）\" }\n      },\n      required: []\n    }\n  },\n  {\n    name: \"claw_get_page_content\",\n    description: \"获取页面内容\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        mode: { \n          type: \"string\", \n          enum: [\"text\", \"html\"], \n          description: \"获取模式：text 或 html\" \n        },\n        tabId: { type: \"number\", description: \"目标标签页 ID（可选）\" }\n      },\n      required: []\n    }\n  },\n  // ========== 登录管理 ==========\n  {\n    name: \"claw_save_credentials\",\n    description: \"保存网站登录信息（本地加密存储）\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        domain: { type: \"string\", description: \"网站域名（如 zhihu.com）\" },\n        username: { type: \"string\", description: \"账号\" },\n        password: { type: \"string\", description: \"密码\" }\n      },\n      required: [\"domain\", \"username\", \"password\"]\n    }\n  },\n  {\n    name: \"claw_auto_login\",\n    description: \"自动登录到指定网站\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        domain: { type: \"string\", description: \"网站域名\" }\n      },\n      required: [\"domain\"]\n    }\n  },\n  {\n    name: \"claw_get_stored_logins\",\n    description: \"获取已保存的登录信息列表\",\n    inputSchema: {\n      type: \"object\",\n      properties: {},\n      required: []\n    }\n  },\n  // ========== 标签页管理 ==========\n  {\n    name: \"claw_get_tabs\",\n    description: \"获取所有标签页\",\n    inputSchema: {\n      type: \"object\",\n      properties: {},\n      required: []\n    }\n  },\n  {\n    name: \"claw_close_tab\",\n    description: \"关闭指定标签页\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        tabId: { type: \"number\", description: \"标签页 ID\" }\n      },\n      required: [\"tabId\"]\n    }\n  },\n  {\n    name: \"claw_switch_tab\",\n    description: \"切换到指定标签页\",\n    inputSchema: {\n      type: \"object\",\n      properties: {\n        tabId: { type: \"number\", description: \"目标标签页 ID\" }\n      },\n      required: [\"tabId\"]\n    }\n  }\n];\n"}],"isError":false,"timestamp":1772051168985}}
{"type":"message","id":"aea7ac99","parentId":"e333ffd6","timestamp":"2026-02-25T20:26:11.532Z","message":{"role":"assistant","content":[{"type":"text","text":"          我看到`claw_navigate`工具的定义，它确实没有指定打开方式。让我检查一下扩展的实际实现"},{"type":"toolCall","id":"call_b748aed086464d668ca2734c","name":"read","arguments":{"path":"~/.openclaw/skills/claw-browser/autoclaw/background.js"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":58950,"output":56,"cacheRead":0,"cacheWrite":0,"totalTokens":59006,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772051168996}}
{"type":"message","id":"7103e7cb","parentId":"aea7ac99","timestamp":"2026-02-25T20:26:11.550Z","message":{"role":"toolResult","toolCallId":"call_b748aed086464d668ca2734c","toolName":"read","content":[{"type":"text","text":"// autoclaw - 浏览器自动化扩展 (增强版)\n// 基于 OpenClaw Gateway 官方WebSocket通讯规范\n\nconst DEFAULT_PORT = 18888;\nconst DEFAULT_AUTH_HOURS = 24;\nconst DEFAULT_MAX_TABS = 50;\n\n// ========== 常量定义 ==========\nconst PROTOCOL_VERSION = 'openclaw-v1';\nconst WEBSOCKET_CONFIG = {\n  url: 'ws://127.0.0.1:18789/extension',\n  protocols: ['openclaw-v1'],\n  timeout: 5000,\n  reconnect: {\n    maxAttempts: 10,\n    baseDelay: 1000,\n    maxDelay: 30000,\n    backoffFactor: 1.5\n  }\n};\n\nconst MESSAGE_TYPES = {\n  REQUEST: 'request',\n  RESPONSE: 'response',\n  PING: 'ping',\n  PONG: 'pong',\n  AUTH: 'auth',\n  ERROR: 'error',\n  EVENT: 'event'\n};\n\nconst ERROR_CODES = {\n  CONNECTION: {\n    TIMEOUT: 'connection_timeout',\n    REFUSED: 'connection_refused',\n    CLOSED: 'connection_closed'\n  },\n  AUTH: {\n    INVALID_TOKEN: 'auth_invalid_token',\n    EXPIRED: 'auth_expired',\n    PERMISSION_DENIED: 'auth_permission_denied'\n  },\n  OPERATION: {\n    INVALID: 'operation_invalid',\n    TIMEOUT: 'operation_timeout',\n    FAILED: 'operation_failed'\n  }\n};\n\n// 连接状态枚举\nconst CONNECTION_STATES = {\n  CONNECTING: 'connecting',\n  CONNECTED: 'connected',\n  RECONNECTING: 'reconnecting',\n  DISCONNECTED: 'disconnected',\n  ERROR: 'error'\n};\n\n// 错误分类\nconst ERROR_CATEGORIES = {\n  NETWORK: 'network',\n  AUTH: 'authentication',\n  PERMISSION: 'permission',\n  BROWSER: 'browser_api',\n  OPERATION: 'operation'\n};\n\n// ========== 工具函数 ==========\nfunction generateMessageId() {\n  return 'msg_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);\n}\n\nfunction createMessage(type, action, payload = {}) {\n  return {\n    id: generateMessageId(),\n    type,\n    action,\n    payload,\n    timestamp: Date.now(),\n    version: PROTOCOL_VERSION\n  };\n}\n\n// ========== 分级日志系统 ==========\nconst LOG_LEVELS = {\n  DEBUG: 0,\n  INFO: 1,\n  WARN: 2,\n  ERROR: 3\n};\n\nlet currentLogLevel = LOG_LEVELS.INFO;\n\nfunction setLogLevel(level) {\n  currentLogLevel = level;\n}\n\nfunction log(level, message, data = {}) {\n  if (level >= currentLogLevel) {\n    const timestamp = new Date().toISOString();\n    const levelName = Object.keys(LOG_LEVELS).find(key => LOG_LEVELS[key] === level);\n    \n    const logEntry = `[${timestamp}] [${levelName}] ${message}`;\n    \n    if (level === LOG_LEVELS.ERROR) {\n      console.error(logEntry, data);\n    } else if (level === LOG_LEVELS.WARN) {\n      console.warn(logEntry, data);\n    } else {\n      console.log(logEntry, data);\n    }\n  }\n}\n\nfunction debug(message, data = {}) {\n  log(LOG_LEVELS.DEBUG, message, data);\n}\n\nfunction info(message, data = {}) {\n  log(LOG_LEVELS.INFO, message, data);\n}\n\nfunction warn(message, data = {}) {\n  log(LOG_LEVELS.WARN, message, data);\n}\n\nfunction error(message, data = {}) {\n  log(LOG_LEVELS.ERROR, message, data);\n}\n\n// ========== 错误处理系统 ==========\nconst ErrorHandler = {\n  codes: ERROR_CODES,\n\n  handle(error, context = {}) {\n    const errorInfo = this.analyzeError(error);\n    this.logError(errorInfo, { ...context, category: this.getErrorCategory(errorInfo) });\n    return errorInfo;\n  },\n\n  analyzeError(error) {\n    const message = error?.message || String(error);\n    \n    if (message.includes('timeout') || message.includes('超时')) {\n      return { code: ERROR_CODES.CONNECTION.TIMEOUT, message, level: 'error' };\n    }\n    if (message.includes('WebSocket') || message.includes('connection')) {\n      return { code: ERROR_CODES.CONNECTION.CLOSED, message, level: 'error' };\n    }\n    if (message.includes('token') || message.includes('Token')) {\n      return { code: ERROR_CODES.AUTH.INVALID_TOKEN, message, level: 'error' };\n    }\n    if (message.includes('expired') || message.includes('过期')) {\n      return { code: ERROR_CODES.AUTH.EXPIRED, message, level: 'warn' };\n    }\n    if (message.includes('permission') || message.includes('权限')) {\n      return { code: ERROR_CODES.AUTH.PERMISSION_DENIED, message, level: 'error' };\n    }\n    if (message.includes('attach') || message.includes('附加')) {\n      return { code: ERROR_CODES.OPERATION.FAILED, message, level: 'error' };\n    }\n    \n    return { code: ERROR_CODES.OPERATION.INVALID, message, level: 'error' };\n  },\n\n  logError(errorInfo, context) {\n    error(`Error: ${errorInfo.code}`, { \n      message: errorInfo.message, \n      context,\n      category: this.getErrorCategory(errorInfo)\n    });\n  },\n\n  getErrorCategory(errorInfo) {\n    const { code } = errorInfo;\n    \n    if (code.includes('connection_')) return ERROR_CATEGORIES.NETWORK;\n    if (code.includes('auth_')) return ERROR_CATEGORIES.AUTH;\n    if (code.includes('permission')) return ERROR_CATEGORIES.PERMISSION;\n    if (code.includes('attach') || code.includes('detach')) return ERROR_CATEGORIES.BROWSER;\n    if (code.includes('operation_')) return ERROR_CATEGORIES.OPERATION;\n    \n    return ERROR_CATEGORIES.NETWORK;\n  },\n\n  getUserMessage(errorInfo) {\n    const messages = {\n      [ERROR_CODES.CONNECTION.TIMEOUT]: '连接超时，请检查网络',\n      [ERROR_CODES.CONNECTION.CLOSED]: '连接已断开，请检查 Gateway 是否运行',\n      [ERROR_CODES.CONNECTION.REFUSED]: '连接被拒绝',\n      [ERROR_CODES.AUTH.INVALID_TOKEN]: 'Token 无效，请重新配置',\n      [ERROR_CODES.AUTH.EXPIRED]: '授权已过期，请重新授权',\n      [ERROR_CODES.AUTH.PERMISSION_DENIED]: '权限不足',\n      [ERROR_CODES.OPERATION.INVALID]: '操作无效',\n      [ERROR_CODES.OPERATION.TIMEOUT]: '操作超时',\n      [ERROR_CODES.OPERATION.FAILED]: '操作失败'\n    };\n    return messages[errorInfo.code] || '发生未知错误';\n  }\n};\n\n// ========== 连接监控 ==========\nconst ConnectionMonitor = function() {\n  this.metrics = {\n    connectionAttempts: 0,\n    successfulConnections: 0,\n    failedConnections: 0,\n    messagesSent: 0,\n    messagesReceived: 0,\n    averageLatency: 0,\n    errorCount: 0,\n    lastPingTime: 0,\n    lastPongTime: 0,\n    missedPongs: 0\n  };\n  \n  this.latencySamples = [];\n  this.startTime = Date.now();\n};\n\nConnectionMonitor.prototype.recordConnectionAttempt = function() {\n  this.metrics.connectionAttempts++;\n};\n\nConnectionMonitor.prototype.recordConnectionSuccess = function() {\n  this.metrics.successfulConnections++;\n  this.metrics.failedConnections = 0;\n};\n\nConnectionMonitor.prototype.recordConnectionFailure = function() {\n  this.metrics.failedConnections++;\n};\n\nConnectionMonitor.prototype.recordMessageSent = function() {\n  this.metrics.messagesSent++;\n};\n\nConnectionMonitor.prototype.recordMessageReceived = function(latency) {\n  this.metrics.messagesReceived++;\n  this.latencySamples.push(latency);\n  \n  if (this.latencySamples.length > 100) {\n    this.latencySamples.shift();\n  }\n  \n  this.metrics.averageLatency = this.latencySamples.reduce((a, b) => a + b, 0) / this.latencySamples.length;\n};\n\nConnectionMonitor.prototype.recordPing = function() {\n  this.metrics.lastPingTime = Date.now();\n};\n\nConnectionMonitor.prototype.recordPong = function() {\n  const now = Date.now();\n  this.metrics.lastPongTime = now;\n  \n  if (this.metrics.lastPingTime > 0) {\n    const latency = now - this.metrics.lastPingTime;\n    this.recordMessageReceived(latency);\n  }\n  \n  this.metrics.missedPongs = 0;\n};\n\nConnectionMonitor.prototype.recordMissedPong = function() {\n  this.metrics.missedPongs++;\n};\n\nConnectionMonitor.prototype.getHealthScore = function() {\n  const successRate = this.metrics.successfulConnections / \n    Math.max(1, this.metrics.connectionAttempts);\n  const latencyScore = this.metrics.averageLatency < 100 ? 0.3 : \n    this.metrics.averageLatency < 500 ? 0.2 : 0.1;\n  const pongScore = this.metrics.missedPongs < 3 ? 0.2 : 0;\n  const messageScore = this.metrics.messagesReceived > 0 ? \n    (this.metrics.messagesSent / this.metrics.messagesReceived) * 0.3 : 0.3;\n  \n  return Math.min(1, successRate * 0.2 + latencyScore + pongScore + messageScore);\n};\n\nConnectionMonitor.prototype.getStats = function() {\n  return {\n    uptime: Date.now() - this.startTime,\n    healthScore: this.getHealthScore(),\n    connection: {\n      attempts: this.metrics.connectionAttempts,\n      successes: this.metrics.successfulConnections,\n      failures: this.metrics.failedConnections,\n      successRate: this.metrics.connectionAttempts > 0 ? \n        (this.metrics.successfulConnections / this.metrics.connectionAttempts).toFixed(2) : 0\n    },\n    messages: {\n      sent: this.metrics.messagesSent,\n      received: this.metrics.messagesReceived,\n      avgLatency: Math.round(this.metrics.averageLatency)\n    },\n    heartbeat: {\n      lastPing: this.metrics.lastPingTime,\n      lastPong: this.metrics.lastPongTime,\n      missed: this.metrics.missedPongs\n    },\n    errors: this.metrics.errorCount\n  };\n};\n\nconst connectionMonitor = new ConnectionMonitor();\n\n// ========== 消息队列 ==========\nconst MessageQueue = function() {\n  this.queue = [];\n  this.pending = new Map();\n  this.maxRetries = 3;\n};\n\nMessageQueue.prototype.enqueue = function(message, priority = 'normal') {\n  this.queue.push({\n    message,\n    priority,\n    retries: 0,\n    timestamp: Date.now()\n  });\n  \n  this.queue.sort((a, b) => {\n    const priorityOrder = { high: 0, normal: 1, low: 2 };\n    return priorityOrder[a.priority] - priorityOrder[b.priority];\n  });\n};\n\nMessageQueue.prototype.dequeue = function() {\n  return this.queue.shift();\n};\n\nMessageQueue.prototype.isEmpty = function() {\n  return this.queue.length === 0;\n};\n\nMessageQueue.prototype.addPending = function(id, resolve, reject) {\n  this.pending.set(id, { resolve, reject, timestamp: Date.now() });\n};\n\nMessageQueue.prototype.getPending = function(id) {\n  return this.pending.get(id);\n};\n\nMessageQueue.prototype.removePending = function(id) {\n  this.pending.delete(id);\n};\n\nMessageQueue.prototype.clearPending = function() {\n  for (const [id, p] of this.pending) {\n    p.reject(new Error('Connection closed'));\n  }\n  this.pending.clear();\n};\n\nconst messageQueue = new MessageQueue();\n\n// ========== OpenClaw WebSocket 客户端 ==========\nconst OpenClawWebSocket = function(options = {}) {\n  this.config = { ...WEBSOCKET_CONFIG, ...options };\n  this.ws = null;\n  this.connectionState = 'disconnected';\n  this.authenticated = false;\n  this.reconnectAttempts = 0;\n  \n  this.onOpen = options.onOpen || null;\n  this.onClose = options.onClose || null;\n  this.onError = options.onError || null;\n  this.onMessage = options.onMessage || null;\n  this.onAuth = options.onAuth || null;\n  \n  this._heartbeatTimer = null;\n  this._reconnectTimer = null;\n  this._cleanupTimer = null;\n};\n\nOpenClawWebSocket.prototype.connect = function() {\n  const self = this;\n  \n  return new Promise(function(resolve, reject) {\n    connectionMonitor.recordConnectionAttempt();\n    \n    if (self.ws) {\n      self.ws.close();\n    }\n    \n    try {\n      self.ws = new WebSocket(self.config.url, self.config.protocols);\n    } catch (e) {\n      connectionMonitor.recordConnectionFailure();\n      reject(e);\n      return;\n    }\n    \n    const timeout = setTimeout(function() {\n      if (self.ws.readyState !== WebSocket.OPEN) {\n        self.ws.close();\n        connectionMonitor.recordConnectionFailure();\n        reject(new Error('Connection timeout'));\n      }\n    }, self.config.timeout);\n\n    self.ws.onopen = function(event) {\n      clearTimeout(timeout);\n      info('WebSocket connected', { protocol: self.ws.protocol, url: self.config.url });\n      self.connectionState = 'connected';\n      connectionMonitor.recordConnectionSuccess();\n      \n      if (self.onOpen) self.onOpen(event);\n      resolve(self.ws);\n    };\n\n    self.ws.onmessage = function(event) {\n      self.handleMessage(event.data);\n    };\n\n    self.ws.onerror = function(error) {\n      clearTimeout(timeout);\n      error('WebSocket connection error', { error });\n      if (self.onError) self.onError(error);\n    };\n\n    self.ws.onclose = function(event) {\n      clearTimeout(timeout);\n      warn('WebSocket closed', { code: event.code, reason: event.reason });\n      self.connectionState = 'disconnected';\n      \n      if (self.onClose) self.onClose(event);\n      \n      if (event.code !== 1000 && self.reconnectAttempts < self.config.reconnect.maxAttempts) {\n        self.scheduleReconnect();\n      }\n    };\n  });\n};\n\nOpenClawWebSocket.prototype.handleMessage = function(data) {\n  try {\n    const msg = JSON.parse(data);\n    \n    if (msg.type === MESSAGE_TYPES.PING) {\n      this.send({\n        id: msg.id || generateMessageId(),\n        type: MESSAGE_TYPES.PONG,\n        timestamp: Date.now()\n      });\n      return;\n    }\n    \n    if (msg.type === MESSAGE_TYPES.PONG) {\n      connectionMonitor.recordPong();\n      return;\n    }\n    \n    if (msg.type === MESSAGE_TYPES.ERROR) {\n      error('Server error', { payload: msg.payload });\n      return;\n    }\n    \n    if (msg.id && this.pending.has(msg.id)) {\n      const p = this.pending.get(msg.id);\n      this.pending.delete(msg.id);\n      \n      if (msg.type === MESSAGE_TYPES.ERROR || msg.error) {\n        p.reject(new Error(msg.error || msg.payload?.message || 'Unknown error'));\n      } else {\n        p.resolve(msg.payload || msg.result);\n      }\n      return;\n    }\n    \n    if (this.onMessage) {\n      this.onMessage(msg);\n    }\n    \n  } catch (e) {\n    error('Message parse error', { error: e, rawData: data });\n  }\n};\n\nOpenClawWebSocket.prototype.send = function(message) {\n  if (!this.ws || this.ws.readyState !== WebSocket.OPEN) {\n    throw new Error('WebSocket not connected');\n  }\n  \n  if (!message.id) {\n    message.id = generateMessageId();\n  }\n  if (!message.type) {\n    message.type = MESSAGE_TYPES.REQUEST;\n  }\n  if (!message.timestamp) {\n    message.timestamp = Date.now();\n  }\n  if (!message.version) {\n    message.version = PROTOCOL_VERSION;\n  }\n  \n  this.ws.send(JSON.stringify(message));\n  connectionMonitor.recordMessageSent();\n  return message.id;\n};\n\nOpenClawWebSocket.prototype.request = function(action, payload = {}) {\n  const self = this;\n  \n  return new Promise(function(resolve, reject) {\n    if (self.connectionState !== 'connected') {\n      reject(new Error('Not connected'));\n      return;\n    }\n    \n    const message = createMessage(MESSAGE_TYPES.REQUEST, action, payload);\n    const id = self.send(message);\n    \n    messageQueue.addPending(id, resolve, reject);\n    \n    setTimeout(function() {\n      if (messageQueue.pending.has(id)) {\n        messageQueue.pending.delete(id);\n        reject(new Error('Request timeout'));\n      }\n    }, 10000);\n  });\n};\n\nOpenClawWebSocket.prototype.authenticate = function(token) {\n  const self = this;\n  \n  return new Promise(function(resolve, reject) {\n    // 验证Token格式\n    if (!token || typeof token !== 'string') {\n      reject(new Error('Token must be a non-empty string'));\n      return;\n    }\n    \n    if (token.length < 32) {\n      reject(new Error('Token too short, minimum 32 characters'));\n      return;\n    }\n    \n    const message = createMessage(MESSAGE_TYPES.AUTH, 'auth', {\n      token: token,\n      client: 'autoclaw-extension',\n      version: '1.0.0'\n    });\n    \n    const id = self.send(message);\n    \n    // 监听认证响应\n    const responseHandler = (response) => {\n      if (response.id === id) {\n        if (response.type === MESSAGE_TYPES.ERROR) {\n          reject(new Error(response.payload?.message || 'Authentication failed'));\n        } else {\n          self.authenticated = true;\n          if (self.onAuth) self.onAuth({ success: true });\n          resolve(true);\n        }\n      }\n    };\n    \n    this.onMessage = responseHandler;\n    \n    // 超时处理\n    setTimeout(() => {\n      this.onMessage = null;\n      reject(new Error('Authentication timeout'));\n    }, 5000);\n  });\n};\n\nOpenClawWebSocket.prototype.scheduleReconnect = function() {\n  const self = this;\n  \n  if (this._reconnectTimer) return;\n  \n  this.reconnectAttempts++;\n  const delay = Math.min(\n    this.config.reconnect.baseDelay * Math.pow(this.config.reconnect.backoffFactor, this.reconnectAttempts - 1),\n    this.config.reconnect.maxDelay\n  );\n  \n  info(`Reconnecting in ${delay}ms`, { attempt: this.reconnectAttempts });\n  \n  this._reconnectTimer = setTimeout(function() {\n    self._reconnectTimer = null;\n    \n    if (self.reconnectAttempts >= self.config.reconnect.maxAttempts) {\n      error('Max reconnect attempts reached', { maxAttempts: self.config.reconnect.maxAttempts });\n      return;\n    }\n    \n    self.connect().catch(function(err) {\n      error('Reconnect failed', { error: err.message, attempt: self.reconnectAttempts });\n    });\n  }, delay);\n};\n\nOpenClawWebSocket.prototype.disconnect = function() {\n  this.reconnectAttempts = this.config.reconnect.maxAttempts;\n  \n  if (this._reconnectTimer) {\n    clearTimeout(this._reconnectTimer);\n    this._reconnectTimer = null;\n  }\n  \n  this.stopHeartbeat();\n  \n  if (this.ws) {\n    this.ws.close(1000, 'Manual disconnect');\n    this.ws = null;\n  }\n  \n  this.connectionState = 'disconnected';\n  messageQueue.clearPending();\n};\n\nOpenClawWebSocket.prototype.startHeartbeat = function(interval = 30000) {\n  const self = this;\n  this.stopHeartbeat();\n  \n  this._heartbeatTimer = setInterval(function() {\n    if (self.connectionState === 'connected') {\n      connectionMonitor.recordPing();\n      self.send({\n        type: MESSAGE_TYPES.PING,\n        timestamp: Date.now()\n      });\n    }\n  }, interval);\n};\n\nOpenClawWebSocket.prototype.stopHeartbeat = function() {\n  if (this._heartbeatTimer) {\n    clearInterval(this._heartbeatTimer);\n    this._heartbeatTimer = null;\n  }\n};\n\nOpenClawWebSocket.prototype.isConnected = function() {\n  return this.connectionState === 'connected' && this.ws && this.ws.readyState === WebSocket.OPEN;\n};\n\n// ========== 主扩展逻辑 ==========\n\nlet stableWs = null;\nlet debuggerListenersInstalled = false;\n\nlet nextSession = 1;\n\nconst tabs = new Map();\nconst tabBySession = new Map();\nconst childSessionToTab = new Map();\n\nconst CRYPTO_KEY = \"autoclaw-openclaw-2026\";\n\nfunction encryptData(data) {\n  try {\n    return btoa(JSON.stringify({ data, timestamp: Date.now() }));\n  } catch { return null; }\n}\n\nfunction decryptData(encryptedData) {\n  try {\n    const decrypted = JSON.parse(atob(encryptedData));\n    if (Date.now() - decrypted.timestamp > 365 * 24 * 60 * 60 * 1000) return null;\n    return decrypted.data;\n  } catch { return null; }\n}\n\nasync function getConfig() {\n  const stored = await chrome.storage.local.get([\n    'relayPort', 'gatewayToken', 'authTimestamp', 'authHours',\n    'autoAttachAll', 'openMode', 'maxTabs'\n  ]);\n  const port = Number.parseInt(String(stored.relayPort || ''), 10) || DEFAULT_PORT;\n  const token = String(stored.gatewayToken || '').trim();\n  const timestamp = Number(stored.authTimestamp) || 0;\n  const authHours = Number(stored.authHours) || DEFAULT_AUTH_HOURS;\n  const autoAttachAll = stored.autoAttachAll === true;\n  const openMode = stored.openMode || 'current';\n  const maxTabs = Number(stored.maxTabs) || DEFAULT_MAX_TABS;\n  return { port, token, timestamp, authHours, autoAttachAll, openMode, maxTabs };\n}\n\nasync function isAuthValid() {\n  const { timestamp, authHours } = await getConfig();\n  if (!timestamp) return false;\n  return Date.now() < timestamp + (authHours * 60 * 60 * 1000);\n}\n\nfunction setBadge(tabId, kind) {\n  const BADGE = {\n    off: { text: 'OFF', color: '#EF4444' },\n    connecting: { text: '…', color: '#F59E0B' },\n    on: { text: 'ON', color: '#10B981' },\n    error: { text: '!', color: '#F97316' },\n  };\n  \n  const cfg = BADGE[kind];\n  chrome.action.setBadgeText({ tabId, text: cfg.text });\n  chrome.action.setBadgeBackgroundColor({ tabId, color: cfg.color });\n  \n  const titles = {\n    off: 'autoclaw: 未连接 (点击配置)',\n    connecting: 'autoclaw: 连接中…',\n    on: 'autoclaw: 已连接 (点击断开)',\n    error: 'autoclaw: 连接错误 (点击重试)'\n  };\n  chrome.action.setTitle({ tabId, title: titles[kind] });\n}\n\nasync function ensureRelayConnection() {\n  if (stableWs && stableWs.isConnected()) return;\n  \n  const { port, token } = await getConfig();\n  \n  if (!token) {\n    const err = ErrorHandler.handle({ message: '请先在扩展设置中配置授权 Token' });\n    throw new Error(err.message);\n  }\n\n  const wsUrl = `ws://127.0.0.1:${port}/extension`;\n  \n  stableWs = new OpenClawWebSocket({\n    url: wsUrl,\n    protocols: [PROTOCOL_VERSION],\n    onOpen: function() {\n      console.log('[autoclaw] Gateway connected, authenticating...');\n      \n      stableWs.authenticate(token).then(function() {\n        console.log('[autoclaw] Authentication successful');\n        \n        if (!debuggerListenersInstalled) {\n          debuggerListenersInstalled = true;\n          chrome.debugger.onEvent.addListener(onDebuggerEvent);\n          chrome.debugger.onDetach.addListener(onDebuggerDetach);\n        }\n      }).catch(function(err) {\n        console.error('[autoclaw] Authentication failed:', err.message);\n      });\n      \n      stableWs.startHeartbeat(30000);\n    },\n    onClose: function(ev) {\n      console.log('[autoclaw] Gateway closed');\n      onRelayClosed('closed');\n    },\n    onError: function(err) {\n      console.error('[autoclaw] Gateway error:', err);\n      ErrorHandler.handle(err, { context: 'ensureRelayConnection' });\n    },\n    onMessage: function(msg) { onRelayMessage(msg); }\n  });\n\n  try {\n    await stableWs.connect();\n  } catch (err) {\n    const errorInfo = ErrorHandler.handle(err, { context: 'ensureRelayConnection' });\n    throw err;\n  }\n}\n\nfunction onRelayClosed(reason) {\n  for (const tabId of tabs.keys()) {\n    detachTab(tabId, 'disconnect');\n  }\n  tabs.clear();\n  tabBySession.clear();\n  childSessionToTab.clear();\n  messageQueue.clearPending();\n}\n\nfunction sendToRelay(action, payload) {\n  if (!stableWs || !stableWs.isConnected()) {\n    throw new Error('Relay 未连接');\n  }\n  return stableWs.request(action, payload);\n}\n\nasync function onRelayMessage(msg) {\n  const startTime = Date.now();\n  \n  if (msg.type === MESSAGE_TYPES.EVENT && msg.action === 'forwardCDPEvent') {\n    // 转发CDP事件\n    return;\n  }\n  \n  if (msg.type === MESSAGE_TYPES.REQUEST && msg.action === 'forwardCDPCommand') {\n    try {\n      const result = await handleForwardCdpCommand(msg);\n      stableWs.send({\n        id: msg.id,\n        type: MESSAGE_TYPES.RESPONSE,\n        payload: result\n      });\n    } catch (err) {\n      stableWs.send({\n        id: msg.id,\n        type: MESSAGE_TYPES.ERROR,\n        error: err.message\n      });\n    }\n    connectionMonitor.recordMessageReceived(Date.now() - startTime);\n  }\n}\n\nfunction getTabBySessionId(sessionId) {\n  const tabId = tabBySession.get(sessionId);\n  return tabId ? { tabId, kind: 'main' } : null;\n}\n\nfunction getTabByTargetId(targetId) {\n  for (const [tabId, tab] of tabs.entries()) {\n    if (tab.targetId === targetId) return tabId;\n  }\n  return null;\n}\n\nasync function attachTab(tabId, opts = {}) {\n  const config = await getConfig();\n  const startTime = Date.now();\n  \n  if (tabs.size >= config.maxTabs) {\n    const err = ErrorHandler.handle({ message: `已达到标签页上限 (${config.maxTabs})` });\n    throw new Error(err.message);\n  }\n\n  try {\n    const debuggee = { tabId };\n    await chrome.debugger.attach(debuggee, '1.3');\n    await chrome.debugger.sendCommand(debuggee, 'Page.enable').catch(() => {});\n\n    const info = await chrome.debugger.sendCommand(debuggee, 'Target.getTargetInfo');\n    const targetId = String(info?.targetInfo?.targetId || '').trim();\n    if (!targetId) throw new Error('无法获取 Target ID');\n\n    const sessionId = 'ac-tab-' + nextSession++;\n    tabs.set(tabId, { state: 'connected', sessionId, targetId });\n    tabBySession.set(sessionId, tabId);\n\n    if (!opts.skipAttachedEvent) {\n      sendToRelay('forwardCDPEvent', {\n        method: 'Target.attachedToTarget',\n        params: {\n          sessionId,\n          targetInfo: { ...info.targetInfo, attached: true },\n          waitingForDebugger: false,\n        },\n      });\n    }\n\n    setBadge(tabId, 'on');\n    connectionMonitor.recordMessageReceived(Date.now() - startTime);\n    return { sessionId, targetId };\n    \n  } catch (err) {\n    const errorInfo = ErrorHandler.handle(err, { context: 'attachTab', tabId });\n    throw err;\n  }\n}\n\nasync function detachTab(tabId, reason) {\n  const tab = tabs.get(tabId);\n  if (tab?.sessionId && tab?.targetId) {\n    try {\n      sendToRelay('forwardCDPEvent', {\n        method: 'Target.detachedFromTarget',\n        params: { sessionId: tab.sessionId, targetId: tab.targetId, reason },\n      });\n    } catch {}\n  }\n\n  if (tab?.sessionId) tabBySession.delete(tab.sessionId);\n  tabs.delete(tabId);\n\n  for (const [childSessionId, parentTabId] of childSessionToTab.entries()) {\n    if (parentTabId === tabId) childSessionToTab.delete(childSessionId);\n  }\n\n  try {\n    await chrome.debugger.detach({ tabId });\n  } catch {}\n\n  setBadge(tabId, 'off');\n}\n\nasync function handleForwardCdpCommand(msg) {\n  const method = String(msg?.payload?.method || msg?.params?.method || '').trim();\n  const params = msg?.payload?.params || msg?.params || undefined;\n  const sessionId = typeof msg?.payload?.sessionId === 'string' ? msg.payload.sessionId : \n                    typeof msg?.params?.sessionId === 'string' ? msg.params.sessionId : undefined;\n  const startTime = Date.now();\n\n  try {\n    const bySession = sessionId ? getTabBySessionId(sessionId) : null;\n    const targetId = typeof params?.targetId === 'string' ? params.targetId : undefined;\n    const tabId = bySession?.tabId || (targetId ? getTabByTargetId(targetId) : null) ||\n      (() => {\n        for (const [id, tab] of tabs.entries()) {\n          if (tab.state === 'connected') return id;\n        }\n        return null;\n      })();\n\n    if (!tabId) {\n      throw new Error(`没有已附加的标签页: ${method}`);\n    }\n\n    const debuggee = { tabId };\n\n    if (method === 'Runtime.enable') {\n      try {\n        await chrome.debugger.sendCommand(debuggee, 'Runtime.disable');\n        await new Promise(r => setTimeout(r, 50));\n      } catch {}\n      return await chrome.debugger.sendCommand(debuggee, 'Runtime.enable', params);\n    }\n\n    if (method === 'Target.createTarget') {\n      const config = await getConfig();\n      if (tabs.size >= config.maxTabs) {\n        throw new Error(`已达到标签页上限 (${config.maxTabs})`);\n      }\n      \n      const url = typeof params?.url === 'string' ? params.url : 'about:blank';\n      \n      if (config.openMode === 'current') {\n        await chrome.tabs.update(tabId, { url: url });\n        return { targetId: tabs.get(tabId)?.targetId };\n      } else {\n        const tab = await chrome.tabs.create({ url, active: false });\n        if (!tab.id) throw new Error('创建标签页失败');\n        await new Promise(r => setTimeout(r, 100));\n        const attached = await attachTab(tab.id);\n        return { targetId: attached.targetId };\n      }\n    }\n\n    if (method === 'Target.closeTarget') {\n      const target = String(params?.targetId || '');\n      const toClose = target ? getTabByTargetId(target) : tabId;\n      if (!toClose) return { success: false };\n      try { await chrome.tabs.remove(toClose); } catch { return { success: false }; }\n      return { success: true };\n    }\n\n    if (method === 'Target.activateTarget') {\n      const target = String(params?.targetId || '');\n      const toActivate = target ? getTabByTargetId(target) : tabId;\n      if (!toActivate) return {};\n      const tab = await chrome.tabs.get(toActivate).catch(() => null);\n      if (!tab) return {};\n      if (tab.windowId) await chrome.windows.update(tab.windowId, { focused: true }).catch(() => {});\n      await chrome.tabs.update(toActivate, { active: true }).catch(() => {});\n      return {};\n    }\n\n    const tabState = tabs.get(tabId);\n    const mainSessionId = tabState?.sessionId;\n    const debuggerSession = sessionId && mainSessionId && sessionId !== mainSessionId\n      ? { ...debuggee, sessionId }\n      : debuggee;\n\n    const result = await chrome.debugger.sendCommand(debuggerSession, method, params);\n    connectionMonitor.recordMessageReceived(Date.now() - startTime);\n    return result;\n    \n  } catch (err) {\n    const errorInfo = ErrorHandler.handle(err, { context: 'handleForwardCdpCommand', method });\n    throw err;\n  }\n}\n\nfunction onDebuggerEvent(source, method, params) {\n  const tabId = source.tabId;\n  if (!tabId) return;\n  const tab = tabs.get(tabId);\n  if (!tab?.sessionId) return;\n\n  if (method === 'Target.attachedToTarget' && params?.sessionId) {\n    childSessionToTab.set(String(params.sessionId), tabId);\n  }\n  if (method === 'Target.detachedFromTarget' && params?.sessionId) {\n    childSessionToTab.delete(String(params.sessionId));\n  }\n\n  try {\n    sendToRelay('forwardCDPEvent', {\n      method,\n      params,\n      sessionId: source.sessionId || tab.sessionId\n    });\n  } catch {}\n}\n\nfunction onDebuggerDetach(source, reason) {\n  const tabId = source.tabId;\n  if (!tabId || !tabs.has(tabId)) return;\n  detachTab(tabId, reason);\n}\n\nasync function connectOrToggleForActiveTab() {\n  const [active] = await chrome.tabs.query({ active: true, currentWindow: true });\n  const tabId = active?.id;\n  if (!tabId) return;\n\n  if (!(await isAuthValid())) {\n    chrome.runtime.openOptionsPage();\n    return;\n  }\n\n  const existing = tabs.get(tabId);\n  if (existing?.state === 'connected') {\n    await detachTab(tabId, 'toggle');\n    return;\n  }\n\n  tabs.set(tabId, { state: 'connecting' });\n  setBadge(tabId, 'connecting');\n\n  try {\n    await ensureRelayConnection();\n    await attachTab(tabId);\n  } catch (err) {\n    tabs.delete(tabId);\n    setBadge(tabId, 'error');\n    console.warn('[autoclaw] attach failed:', err.message);\n  }\n}\n\nasync function autoAttachAllTabs() {\n  const config = await getConfig();\n  if (!(await isAuthValid())) {\n    return;\n  }\n\n  try {\n    await ensureRelayConnection();\n    const allTabs = await chrome.tabs.query({});\n    \n    for (const tab of allTabs) {\n      if (tab.id && !tabs.has(tab.id)) {\n        if (tabs.size >= config.maxTabs) break;\n        try {\n          await attachTab(tab.id);\n        } catch {}\n      }\n    }\n  } catch {}\n}\n\nchrome.tabs.onCreated.addListener(async function(tab) {\n  const config = await getConfig();\n  if (!config.autoAttachAll) return;\n  if (!(await isAuthValid())) return;\n  \n  if (tab.id && tabs.size < config.maxTabs) {\n    try {\n      await ensureRelayConnection();\n      await attachTab(tab.id);\n    } catch {}\n  }\n});\n\nasync function getAttachedTabsCount() {\n  return tabs.size;\n}\n\nasync function getStats() {\n  return connectionMonitor.getStats();\n}\n\nchrome.runtime.onMessage.addListener(function(request, sender, sendResponse) {\n  if (request.action === 'tryConnect') {\n    ensureRelayConnection()\n      .then(function() { sendResponse({ success: true }); })\n      .catch(function(e) { sendResponse({ success: false, error: e.message, code: e.code }); });\n    return true;\n  }\n  \n  if (request.action === 'autoAttachAllTabs') {\n    autoAttachAllTabs()\n      .then(function() { sendResponse({ success: true }); })\n      .catch(function(e) { sendResponse({ success: false, error: e.message }); });\n    return true;\n  }\n  \n  if (request.action === 'getAttachedTabsCount') {\n    sendResponse({ count: tabs.size });\n    return true;\n  }\n\n  if (request.action === 'getStats') {\n    sendResponse(getStats());\n    return true;\n  }\n  \n  if (request.action === 'getErrorMessage') {\n    var errorInfo = ErrorHandler.analyzeError({ message: request.error });\n    sendResponse({ message: ErrorHandler.getUserMessage(errorInfo), code: errorInfo.code });\n    return true;\n  }\n});\n\nchrome.action.onClicked.addListener(function() {\n  connectOrToggleForActiveTab();\n});\n\nchrome.runtime.onInstalled.addListener(function() {\n  chrome.runtime.openOptionsPage();\n});\n\nasync function initializeAllTabs() {\n  const allTabs = await chrome.tabs.query({});\n  for (const tab of allTabs) {\n    if (tab.id) {\n      setBadge(tab.id, 'off');\n    }\n  }\n}\n\nchrome.runtime.onStartup.addListener(function() {\n  initializeAllTabs();\n});\n\nsetInterval(async function() {\n  const config = await getConfig();\n  if (await isAuthValid()) {\n    try {\n      await ensureRelayConnection();\n      \n      if (config.autoAttachAll) {\n        const allTabs = await chrome.tabs.query({});\n        for (const tab of allTabs) {\n          if (tab.id && !tabs.has(tab.id)) {\n            if (tabs.size >= config.maxTabs) break;\n            try {\n              await attachTab(tab.id);\n            } catch {}\n          }\n        }\n      }\n    } catch {}\n  }\n}, 30000);\n\nconsole.log('[autoclaw] Extension loaded v1.0.0 (enhanced)');\n"}],"isError":false,"timestamp":1772051171543}}
