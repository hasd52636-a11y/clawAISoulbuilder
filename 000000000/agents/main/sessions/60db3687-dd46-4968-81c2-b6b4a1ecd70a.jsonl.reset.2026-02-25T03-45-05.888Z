{"type":"message","id":"14775a3d","parentId":"9d66ec3f","timestamp":"2026-02-24T11:39:24.295Z","message":{"role":"assistant","content":[{"type":"text","text":"          "},{"type":"toolCall","id":"call_1cf356e76fb248a083ca5255","name":"write","arguments":{"path":"D:\\工作报告\\20260224_13_网站API设置指南.md","content":"# 网站API设置指南（单独阐述）\n\n## 🎯 网站端API设置要求\n\n### 1. API服务器基础配置\n\n#### 环境变量设置\n```bash\n# .env 文件\nAPI_KEY=sk_your_actual_secret_key_here\nHASH_SALT=your_super_secret_salt_value\nPORT=3000\nNODE_ENV=production\nALLOWED_ORIGINS=https://openclaw.ai,https://*.openclaw.ai\n```\n\n#### 依赖安装\n```bash\n# 必需依赖\nnpm install express crypto\n\n# 可选开发依赖\nnpm install -D nodemon dotenv\n```\n\n### 2. 核心API端点实现\n\n#### 身份生成端点\n```javascript\n// routes/identities.js\nconst express = require('express');\nconst router = express.Router();\nconst { generateIdentity } = require('../services/identity-generator');\nconst { calculateHash, deriveKeyFromHash, calculateSignature } = require('../utils/hash-utils');\n\n// POST /api/v1/identities/generate\nrouter.post('/generate', async (req, res) => {\n  try {\n    // 1. 验证API密钥\n    const apiKey = req.headers['x-api-key'];\n    if (apiKey !== process.env.API_KEY) {\n      return res.status(401).json({ \n        error: 'Invalid API key',\n        message: '请提供有效的API密钥'\n      });\n    }\n\n    // 2. 验证请求参数\n    const { country, includeFinancial, verificationMethod } = req.body;\n    if (!isValidCountry(country)) {\n      return res.status(400).json({\n        error: 'Invalid country code',\n        message: '不支持的国家代码'\n      });\n    }\n\n    // 3. 生成身份信息\n    const identity = await generateIdentity({\n      country: country || 'US',\n      includeFinancial: includeFinancial || false,\n      verificationMethod: verificationMethod || 'email'\n    });\n\n    // 4. 计算内容哈希\n    const contentHash = calculateHash(identity);\n    \n    // 5. 派生验证密钥\n    const verificationKey = deriveKeyFromHash(contentHash);\n    \n    // 6. 生成数字签名\n    const signature = calculateSignature(identity, verificationKey);\n\n    // 7. 返回响应\n    res.json({\n      status: 'success',\n      data: identity,\n      hash: contentHash,\n      signature: signature,\n      requestId: req.headers['x-request-id'] || generateRequestId(),\n      generatedAt: new Date().toISOString()\n    });\n\n  } catch (error) {\n    console.error('Identity generation error:', error);\n    res.status(500).json({\n      error: 'Generation failed',\n      message: error.message,\n      code: 'INTERNAL_ERROR'\n    });\n  }\n});\n\n// 批量生成端点\nrouter.post('/bulk-generate', async (req, res) => {\n  try {\n    const { count = 1, country, includeFinancial } = req.body;\n    \n    if (count > 100) {\n      return res.status(400).json({\n        error: 'Count too large',\n        message: '单次最多生成100个身份'\n      });\n    }\n\n    const results = [];\n    for (let i = 0; i < count; i++) {\n      const identity = await generateIdentity({ country, includeFinancial });\n      const contentHash = calculateHash(identity);\n      const signature = calculateSignature(identity, deriveKeyFromHash(contentHash));\n      \n      results.push({\n        data: identity,\n        hash: contentHash,\n        signature: signature,\n        requestId: `req_${Date.now()}_${i}`\n      });\n    }\n\n    res.json({\n      status: 'success',\n      count: results.length,\n      identities: results,\n      generatedAt: new Date().toISOString()\n    });\n\n  } catch (error) {\n    res.status(500).json({\n      error: 'Bulk generation failed',\n      message: error.message\n    });\n  }\n});\n\nmodule.exports = router;\n```\n\n### 3. 哈希工具函数\n\n#### hash-utils.js\n```javascript\nconst crypto = require('crypto');\n\n// 计算内容哈希\nfunction calculateHash(data) {\n  const content = typeof data === 'string' ? data : JSON.stringify(data);\n  const salt = process.env.HASH_SALT || 'default-salt';\n  \n  return crypto\n    .createHash('sha256')\n    .update(content + salt + Date.now()) // 添加时间戳防止重放\n    .digest('hex');\n}\n\n// 从哈希派生密钥\nfunction deriveKeyFromHash(hash) {\n  const salt = process.env.HASH_SALT || 'default-salt';\n  \n  return crypto\n    .createHmac('sha256', salt)\n    .update(hash)\n    .digest('hex')\n    .substring(0, 32); // 取前32字符作为密钥\n}\n\n// 计算数字签名\nfunction calculateSignature(data, key) {\n  const content = typeof data === 'string' ? data : JSON.stringify(data);\n  \n  return crypto\n    .createHmac('sha256', key)\n    .update(content)\n    .digest('hex');\n}\n\n// 验证签名\nfunction verifySignature(data, signature, key) {\n  const expectedSignature = calculateSignature(data, key);\n  return expectedSignature === signature;\n}\n\nmodule.exports = {\n  calculateHash,\n  deriveKeyFromHash,\n  calculateSignature,\n  verifySignature\n};\n```\n\n### 4. 身份生成服务\n\n#### identity-generator.js\n```javascript\n// 国家配置数据库\nconst countryConfigs = {\n  US: {\n    firstName: ['John', 'Jane', 'Robert', 'Mary', 'David', 'Sarah'],\n    lastName: ['Smith', 'Johnson', 'Williams', 'Brown', 'Jones', 'Garcia'],\n    phone: {\n      format: '+1-555-###-####',\n      areaCodes: ['201', '202', '203', '205', '206', '212']\n    },\n    address: {\n      streetNames: ['Main', 'Oak', 'Pine', 'Maple', 'Cedar', 'Elm'],\n      streetTypes: ['St', 'Ave', 'Rd', 'Blvd', 'Dr'],\n      cities: ['New York', 'Los Angeles', 'Chicago', 'Houston', 'Phoenix'],\n      states: ['NY', 'CA', 'IL', 'TX', 'AZ']\n    }\n  },\n  CN: {\n    firstName: ['伟', '芳', '娜', '强', '磊', '静'],\n    lastName: ['王', '李', '张', '刘', '陈', '杨'],\n    phone: {\n      format: '+86 1##########',\n      prefixes: ['130', '131', '132', '133', '134', '135']\n    },\n    address: {\n      provinces: ['北京市', '上海市', '广东省', '江苏省', '浙江省'],\n      cities: ['北京市', '上海市', '广州市', '深圳市', '杭州市'],\n      districts: ['朝阳区', '浦东新区', '天河区', '福田区', '西湖区'],\n      streets: ['建国路', '南京路', '中山路', '解放路', '人民路']\n    }\n  }\n};\n\n// 生成身份信息\nasync function generateIdentity(options = {}) {\n  const country = options.country || 'US';\n  const config = countryConfigs[country] || countryConfigs.US;\n  \n  return {\n    personal: generatePersonalInfo(config, country),\n    contact: generateContactInfo(config, country),\n    financial: options.includeFinancial ? generateFinancialInfo(country) : undefined,\n    metadata: {\n      country: country,\n      generatedAt: new Date().toISOString(),\n      isTestData: true,\n      version: '1.0'\n    }\n  };\n}\n\n// 生成个人信息\nfunction generatePersonalInfo(config, country) {\n  const firstName = randomChoice(config.firstName);\n  const lastName = randomChoice(config.lastName);\n  \n  return {\n    firstName: firstName,\n    lastName: lastName,\n    fullName: country === 'CN' ? `${lastName}${firstName}` : `${firstName} ${lastName}`,\n    gender: Math.random() > 0.5 ? 'male' : 'female',\n    birthDate: generateBirthDate(18, 65),\n    age: randomInt(18, 65),\n    nationality: country\n  };\n}\n\n// 生成联系信息\nfunction generateContactInfo(config, country) {\n  return {\n    email: generateEmail(),\n    phone: generatePhoneNumber(config.phone, country),\n    address: generateAddress(config.address, country)\n  };\n}\n\n// 工具函数\nfunction randomChoice(array) {\n  return array[Math.floor(Math.random() * array.length)];\n}\n\nfunction randomInt(min, max) {\n  return Math.floor(Math.random() * (max - min + 1)) + min;\n}\n\nfunction generateBirthDate(minAge, maxAge) {\n  const age = randomInt(minAge, maxAge);\n  const birthYear = new Date().getFullYear() - age;\n  const birthMonth = randomInt(1, 12);\n  const birthDay = randomInt(1, 28); // 简单处理，避免日期问题\n  \n  return new Date(birthYear, birthMonth - 1, birthDay).toISOString().split('T')[0];\n}\n\nmodule.exports = { generateIdentity };\n```\n\n### 5. 中间件和安全配置\n\n#### auth-middleware.js\n```javascript\n// API密钥验证中间件\nfunction authenticateApiKey(req, res, next) {\n  const apiKey = req.headers['x-api-key'];\n  \n  if (!apiKey) {\n    return res.status(401).json({\n      error: 'API key required',\n      message: '请提供API密钥'\n    });\n  }\n  \n  if (apiKey !== process.env.API_KEY) {\n    return res.status(403).json({\n      error: 'Invalid API key',\n      message: 'API密钥无效'\n    });\n  }\n  \n  next();\n}\n\n// 速率限制中间件\nfunction rateLimit(req, res, next) {\n  const ip = req.ip;\n  const now = Date.now();\n  const windowMs = 60000; // 1分钟\n  const maxRequests = 60; // 最多60个请求\n  \n  // 简单的内存存储（生产环境建议使用Redis）\n  if (!req.app.locals.rateLimit) {\n    req.app.locals.rateLimit = {};\n  }\n  \n  if (!req.app.locals.rateLimit[ip]) {\n    req.app.locals.rateLimit[ip] = { count: 0, resetTime: now + windowMs };\n  }\n  \n  const ipData = req.app.locals.rateLimit[ip];\n  \n  if (now > ipData.resetTime) {\n    ipData.count = 0;\n    ipData.resetTime = now + windowMs;\n  }\n  \n  if (ipData.count >= maxRequests) {\n    return res.status(429).json({\n      error: 'Rate limit exceeded',\n      message: '请求过于频繁，请稍后再试',\n      retryAfter: Math.ceil((ipData.resetTime - now) / 1000)\n    });\n  }\n  \n  ipData.count++;\n  next();\n}\n\nmodule.exports = { authenticateApiKey, rateLimit };\n```\n\n#### app.js 主文件\n```javascript\nconst express = require('express');\nconst cors = require('cors');\nrequire('dotenv').config();\n\nconst { authenticateApiKey, rateLimit } = require('./middleware/auth-middleware');\nconst identityRoutes = require('./routes/identities');\n\nconst app = express();\n\n// 中间件\napp.use(cors({\n  origin: process.env.ALLOWED_ORIGINS?.split(',') || ['https://openclaw.ai'],\n  credentials: true\n}));\n\napp.use(express.json());\napp.use(rateLimit);\n\n// 路由\napp.use('/api/v1/identities', authenticateApiKey, identityRoutes);\n\n// 健康检查端点\napp.get('/health', (req, res) => {\n  res.json({ \n    status: 'healthy', \n    timestamp: new Date().toISOString() \n  });\n});\n\n// 404处理\napp.use('*', (req, res) => {\n  res.status(404).json({\n    error: 'Endpoint not found',\n    message: `找不到路径: ${req.originalUrl}`\n  });\n});\n\n// 错误处理\napp.use((error, req, res, next) => {\n  console.error('Unhandled error:', error);\n  res.status(500).json({\n    error: 'Internal server error',\n    message: process.env.NODE_ENV === 'development' ? error.message : '服务器内部错误'\n  });\n});\n\nconst PORT = process.env.PORT || 3000;\napp.listen(PORT, () => {\n  console.log(`Identity API server running on port ${PORT}`);\n});\n```\n\n### 6. 部署和生产配置\n\n#### package.json\n```json\n{\n  \"name\": \"identity-api\",\n  \"version\": \"1.0.0\",\n  \"description\": \"OpenClaw身份生成API\",\n  \"main\": \"app.js\",\n  \"scripts\": {\n    \"start\": \"node app.js\",\n    \"dev\": \"nodemon app.js\",\n    \"test\": \"jest\"\n  },\n  \"dependencies\": {\n    \"express\": \"^4.18.0\",\n    \"cors\": \"^2.8.5\",\n    \"dotenv\": \"^16.0.0\"\n  },\n  \"devDependencies\": {\n    \"nodemon\": \"^2.0.0\",\n    \"jest\": \"^29.0.0\"\n  }\n}\n```\n\n#### Dockerfile\n```dockerfile\nFROM node:18-alpine\n\nWORKDIR /app\n\nCOPY package*.json ./\nRUN npm install --only=production\n\nCOPY . .\n\nEXPOSE 3000\n\nCMD [\"node\", \"app.js\"]\n```\n\n## 🚀 快速启动命令\n\n```bash\n# 1. 创建项目目录\nmkdir identity-api && cd identity-api\n\n# 2. 初始化项目\nnpm init -y\n\n# 3. 安装依赖\nnpm install express cors dotenv\n\n# 4. 创建配置文件\necho 'API_KEY=sk_your_secret_key_here' > .env\necho 'HASH_SALT=your_super_secret_salt' >> .env\necho 'PORT=3000' >> .env\n\n# 5. 创建上述代码文件\n# 创建 app.js, routes/, services/, utils/, middleware/\n\n# 6. 启动服务器\nnode app.js\n```\n\n## 📊 API响应示例\n\n### 成功响应\n```json\n{\n  \"status\": \"success\",\n  \"data\": {\n    \"personal\": {\n      \"firstName\": \"John\",\n      \"lastName\": \"Smith\",\n      \"fullName\": \"John Smith\",\n      \"gender\": \"male\",\n      \"birthDate\": \"1985-07-15\",\n      \"age\": 38,\n      \"nationality\": \"US\"\n    },\n    \"contact\": {\n      \"email\": \"john.smith@example.com\",\n      \"phone\": \"+1-555-012-3456\",\n      \"address\": \"123 Main St, New York, NY\"\n    },\n    \"metadata\": {\n      \"country\": \"US\",\n      \"generatedAt\": \"2026-02-24T19:31:00.000Z\",\n      \"isTestData\": true,\n      \"version\": \"1.0\"\n    }\n  },\n  \"hash\": \"a1b2c3d4e5f6...\",\n  \"signature\": \"signature_value_here\",\n  \"requestId\": \"req_1234567890\",\n  \"generatedAt\": \"2026-02-24T19:31:00.000Z\"\n}\n```\n\n### 错误响应\n```json\n{\n  \"error\": \"Invalid API key\",\n  \"message\": \"请提供有效的"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":109860,"output":4096,"cacheRead":0,"cacheWrite":0,"totalTokens":113956,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"length","timestamp":1771932879507}}
