{"type":"message","id":"0f95c7f1","parentId":"5567af8e","timestamp":"2026-02-24T06:33:08.683Z","message":{"role":"assistant","content":[{"type":"text","text":"          "},{"type":"toolCall","id":"call_02b52acbf4dc460eb9cd0f8c","name":"write","arguments":{"path":"D:\\工作报告\\20260224_04_全球身份生成平台_前端代码\\src\\App.tsx","content":"import React, { useState } from 'react'\nimport { Globe, CreditCard, Download, Sparkles, Settings } from 'lucide-react'\n\nfunction App() {\n  const [selectedCountry, setSelectedCountry] = useState('US')\n  const [includeBankCard, setIncludeBankCard] = useState(true)\n  const [isGenerating, setIsGenerating] = useState(false)\n  const [generatedData, setGeneratedData] = useState<any>(null)\n\n  const countries = [\n    { code: 'US', name: '美国', flag: '🇺🇸' },\n    { code: 'CN', name: '中国', flag: '🇨🇳' },\n    { code: 'DE', name: '德国', flag: '🇩🇪' },\n    { code: 'JP', name: '日本', flag: '🇯🇵' },\n    { code: 'GB', name: '英国', flag: '🇬🇧' },\n    { code: 'FR', name: '法国', flag: '🇫🇷' },\n    { code: 'CA', name: '加拿大', flag: '🇨🇦' },\n  ]\n\n  const generateIdentity = async () => {\n    setIsGenerating(true)\n    \n    // 模拟API调用\n    setTimeout(() => {\n      const mockData = {\n        personal: {\n          name: selectedCountry === 'CN' ? '张三' : 'John Smith',\n          gender: 'Male',\n          birthDate: '1990-01-15',\n          age: 34\n        },\n        contact: {\n          phone: selectedCountry === 'CN' ? '+86 13800138000' : '+1-555-0123',\n          email: 'test@example.com',\n          address: selectedCountry === 'CN' \n            ? '北京市朝阳区建国路123号' \n            : '123 Main St, New York, NY 10001'\n        },\n        bankCard: includeBankCard ? {\n          cardNumber: '4111111111111111',\n          cardHolder: selectedCountry === 'CN' ? '张三' : 'John Smith',\n          expiryDate: '12/28',\n          cvv: '123',\n          cardType: 'VISA',\n          issuer: selectedCountry === 'CN' ? '中国工商银行' : 'Chase Bank',\n          currency: selectedCountry === 'CN' ? 'CNY' : 'USD'\n        } : null\n      }\n      setGeneratedData(mockData)\n      setIsGenerating(false)\n    }, 1500)\n  }\n\n  const exportData = () => {\n    if (!generatedData) return\n    \n    const dataStr = JSON.stringify(generatedData, null, 2)\n    const dataBlob = new Blob([dataStr], { type: 'application/json' })\n    \n    const link = document.createElement('a')\n    link.href = URL.createObjectURL(dataBlob)\n    link.download = `identity-${selectedCountry}-${Date.now()}.json`\n    link.click()\n  }\n\n  return (\n    <div className=\"min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100\">\n      <div className=\"container mx-auto px-4 py-8\">\n        {/* Header */}\n        <div className=\"text-center mb-12\">\n          <div className=\"flex items-center justify-center mb-4\">\n            <Globe className=\"w-12 h-12 text-blue-600 mr-3\" />\n            <h1 className=\"text-4xl font-bold text-gray-800\">全球身份生成平台</h1>\n          </div>\n          <p className=\"text-lg text-gray-600 max-w-2xl mx-auto\">\n            生成符合各国规范的虚拟身份信息，支持银行卡信用卡生成，专为开发和测试设计\n          </p>\n        </div>\n\n        {/* Main Content */}\n        <div className=\"max-w-4xl mx-auto bg-white rounded-xl shadow-2xl p-8\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-8\">\n            {/* Left Panel - Controls */}\n            <div className=\"space-y-6\">\n              <div>\n                <label className=\"block text-sm font-medium text-gray-700 mb-2\">\n                  选择国家/地区\n                </label>\n                <div className=\"grid grid-cols-2 gap-3\">\n                  {countries.map((country) => (\n                    <button\n                      key={country.code}\n                      onClick={() => setSelectedCountry(country.code)}\n                      className={`flex items-center justify-center p-3 rounded-lg border-2 transition-all ${\n                        selectedCountry === country.code\n                          ? 'border-blue-500 bg-blue-50 text-blue-700'\n                          : 'border-gray-200 hover:border-gray-300'\n                      }`}\n                    >\n                      <span className=\"text-2xl mr-2\">{country.flag}</span>\n                      <span className=\"font-medium\">{country.name}</span>\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              <div>\n                <label className=\"flex items-center space-x-3\">\n                  <input\n                    type=\"checkbox\"\n                    checked={includeBankCard}\n                    onChange={(e) => setIncludeBankCard(e.target.checked)}\n                    className=\"w-5 h-5 text-blue-600 rounded\"\n                  />\n                  <span className=\"text-gray-700 font-medium\">\n                    <CreditCard className=\"w-5 h-5 inline mr-2\" />\n                    包含银行卡信息\n                  </span>\n                </label>\n              </div>\n\n              <button\n                onClick={generateIdentity}\n                disabled={isGenerating}\n                className=\"w-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white py-4 px-6 rounded-xl font-semibold text-lg hover:from-blue-700 hover:to-indigo-700 transition-all disabled:opacity-50 disabled:cursor-not-allowed\"\n              >\n                {isGenerating ? (\n                  <div className=\"flex items-center justify-center\">\n                    <Sparkles className=\"w-5 h-5 animate-spin mr-2\" />\n                    生成中...\n                  </div>\n                ) : (\n                  <div className=\"flex items-center justify-center\">\n                    <Sparkles className=\"w-5 h-5 mr-2\" />\n                    生成身份信息\n                  </div>\n                )}\n              </button>\n            </div>\n\n            {/* Right Panel - Preview */}\n            <div className=\"bg-gray-50 rounded-xl p-6\">\n              <h3 className=\"text-lg font-semibold text-gray-800 mb-4\">\n                身份信息预览\n              </h3>\n              \n              {generatedData ? (\n                <div className=\"space-y-4\">\n                  {/* Personal Info */}\n                  <div className=\"bg-white rounded-lg p-4 shadow-sm\">\n                    <h4 className=\"font-medium text-gray-700 mb-2\">个人信息</h4>\n                    <div className=\"space-y-1 text-sm\">\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-gray-500\">姓名:</span>\n                        <span className=\"font-medium\">{generatedData.personal.name}</span>\n                      </div>\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-gray-500\">性别:</span>\n                        <span className=\"font-medium\">{generatedData.personal.gender}</span>\n                      </div>\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-gray-500\">出生日期:</span>\n                        <span className=\"font-medium\">{generatedData.personal.birthDate}</span>\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Contact Info */}\n                  <div className=\"bg-white rounded-lg p-4 shadow-sm\">\n                    <h4 className=\"font-medium text-gray-700 mb-2\">联系信息</h4>\n                    <div className=\"space-y-1 text-sm\">\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-gray-500\">电话:</span>\n                        <span className=\"font-medium\">{generatedData.contact.phone}</span>\n                      </div>\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-gray-500\">邮箱:</span>\n                        <span className=\"font-medium\">{generatedData.contact.email}</span>\n                      </div>\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-gray-500\">地址:</span>\n                        <span className=\"font-medium text-right\">{generatedData.contact.address}</span>\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Bank Card */}\n                  {generatedData.bankCard && (\n                    <div className=\"bg-white rounded-lg p-4 shadow-sm\">\n                      <h4 className=\"font-medium text-gray-700 mb-2\">银行卡信息</h4>\n                      <div className=\"space-y-1 text-sm\">\n                        <div className=\"flex justify-between\">\n                          <span className=\"text-gray-500\">卡号:</span>\n                          <span className=\"font-medium\">{generatedData.bankCard.cardNumber}</span>\n                        </div>\n                        <div className=\"flex justify-between\">\n                          <span className=\"text-gray-500\">有效期:</span>\n                          <span className=\"font-medium\">{generatedData.bankCard.expiryDate}</span>\n                        </div>\n                        <div className=\"flex justify-between\">\n                          <span className=\"text-gray-500\">CVV:</span>\n                          <span className=\"font-medium\">{generatedData.bankCard.cvv}</span>\n                        </div>\n                        <div className=\"flex justify-between\">\n                          <span className=\"text-gray-500\">发卡行:</span>\n                          <span className=\"font-medium\">{generatedData.bankCard.issuer}</span>\n                        </div>\n                      </div>\n                    </div>\n                  )}\n\n                  {/* Export Button */}\n                  <button\n                    onClick={exportData}\n                    className=\"w-full bg-green-600 text-white py-3 px-4 rounded-lg font-medium hover:bg-green-700 transition-all flex items-center justify-center\"\n                  >\n                    <Download className=\"w-4 h-4 mr-2\" />\n                    导出JSON数据\n                  </button>\n                </div>\n              ) : (\n                <div className=\"text-center text-gray-500 py-12\">\n                  <Settings className=\"w-12 h-12 mx-auto mb-4 opacity-50\" />\n                  <p>点击\"生成身份信息\"开始创建虚拟身份</p>\n                </div>\n              )}\n            </div>\n          </div>\n        </div>\n\n        {/* Footer */}\n        <div className=\"text-center mt-12 text-gray-600\">\n          <p className=\"text-sm\">\n            © 2026 全球身份生成平台 | 仅供开发和测试使用\n          </p>\n        </div>\n      </div>\n    </div>\n  )\n}\n\nexport default App"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":73543,"output":2734,"cacheRead":0,"cacheWrite":0,"totalTokens":76277,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771914533151}}
