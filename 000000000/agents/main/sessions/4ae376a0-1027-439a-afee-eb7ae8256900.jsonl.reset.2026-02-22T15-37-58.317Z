{"type":"message","id":"1aabccd6","parentId":"6de90ed1","timestamp":"2026-02-22T15:20:34.611Z","message":{"role":"toolResult","toolCallId":"call_63b669f5628043e0b1b78017","toolName":"exec","content":[{"type":"text","text":"Error: TypeError: CronPattern: @reboot is not supported in this environment. This is an event-based trigger that requires system startup detection.\n\n(Command exited with code 1)"}],"details":{"status":"completed","exitCode":1,"durationMs":2440,"aggregated":"Error: TypeError: CronPattern: @reboot is not supported in this environment. This is an event-based trigger that requires system startup detection.\n\n(Command exited with code 1)","cwd":"C:\\Users\\lenovo\\.openclaw\\workspace"},"isError":false,"timestamp":1771773634604}}
