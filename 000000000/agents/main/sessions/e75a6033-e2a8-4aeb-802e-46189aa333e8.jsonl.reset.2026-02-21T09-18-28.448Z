{"type":"message","id":"86888cb6","parentId":"ef3a3fd5","timestamp":"2026-02-21T02:58:43.998Z","message":{"role":"assistant","content":[{"type":"text","text":"          让我为您提供一个更简单可靠的解决方案。我将创建一个使用剪贴板监听的版本："},{"type":"toolCall","id":"call_7fd6384b0dd744cbb2ad5261","name":"write","arguments":{"path":"translation_server_clipboard.py","content":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"\n电脑端翻译服务程序 - 剪贴板监听版本\n复制文本自动触发翻译\n\"\"\"\n\nimport socket\nimport threading\nimport pyautogui\nimport pyperclip\nimport time\nimport base64\nimport json\nimport os\nfrom PIL import Image\nimport sys\n\nclass ClipboardMonitor:\n    def __init__(self, callback):\n        self.callback = callback\n        self.last_text = \"\"\n        self.running = True\n        \n    def start_monitoring(self):\n        \"\"\"开始监听剪贴板\"\"\"\n        def monitor():\n            while self.running:\n                try:\n                    current_text = pyperclip.paste()\n                    # 只有当有新文本且不是空字符串时触发\n                    if current_text and current_text.strip() and current_text != self.last_text:\n                        print(f\"📋 检测到新文本: {current_text}\")\n                        self.callback(current_text)\n                        self.last_text = current_text\n                    time.sleep(1)  # 每秒检查一次\n                except Exception as e:\n                    print(f\"❌ 剪贴板监听错误: {e}\")\n                    time.sleep(2)\n        \n        thread = threading.Thread(target=monitor)\n        thread.daemon = True\n        thread.start()\n\nclass TranslationServer:\n    def __init__(self, host='0.0.0.0', port=8888):\n        self.host = host\n        self.port = port\n        self.clients = []\n        self.server_socket = None\n        self.running = False\n        \n    def get_local_ip(self):\n        \"\"\"获取本机IP地址\"\"\"\n        try:\n            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\n            s.connect((\"8.8.8.8\", 80))\n            ip = s.getsockname()[0]\n            s.close()\n            return ip\n        except:\n            return \"127.0.0.1\"\n    \n    def start_server(self):\n        \"\"\"启动TCP服务器\"\"\"\n        try:\n            self.server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n            self.server_socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\n            self.server_socket.bind((self.host, self.port))\n            self.server_socket.listen(5)\n            \n            print(\"Translation service started\")\n            print(f\"Phone connect IP: {self.get_local_ip()}\")\n            print(f\"Port: {self.port}\")\n            print(\"Copy any text to trigger translation\")\n            print(\"Waiting for phone connection...\")\n            \n            self.running = True\n            \n            # 接受客户端连接\n            accept_thread = threading.Thread(target=self.accept_clients)\n            accept_thread.daemon = True\n            accept_thread.start()\n            \n        except Exception as e:\n            print(f\"Failed to start server: {e}\")\n    \n    def accept_clients(self):\n        \"\"\"接受客户端连接\"\"\"\n        while self.running:\n            try:\n                client_socket, addr = self.server_socket.accept()\n                print(f\"Phone connected: {addr}\")\n                self.clients.append(client_socket)\n                \n                # 为每个客户端创建接收线程\n                client_thread = threading.Thread(\n                    target=self.handle_client, \n                    args=(client_socket, addr)\n                )\n                client_thread.daemon = True\n                client_thread.start()\n                \n            except Exception as e:\n                if self.running:\n                    print(f\"Connection error: {e}\")\n    \n    def handle_client(self, client_socket, addr):\n        \"\"\"处理客户端通信\"\"\"\n        try:\n            while self.running:\n                data = client_socket.recv(1024)\n                if not data:\n                    break\n                \n                message = data.decode('utf-8')\n                print(f\"Received from phone: {message}\")\n                \n                # 处理语音指令\n                if message.startswith(\"VOICE:\"):\n                    self.handle_voice_command(message[6:])\n                    \n        except Exception as e:\n            print(f\"Client {addr} communication error: {e}\")\n        finally:\n            if client_socket in self.clients:\n                self.clients.remove(client_socket)\n            client_socket.close()\n            print(f\"Phone disconnected: {addr}\")\n    \n    def handle_voice_command(self, command):\n        \"\"\"处理语音指令\"\"\"\n        command = command.lower().strip()\n        print(f\"Voice command: {command}\")\n        \n        if \"翻译\" in command:\n            self.trigger_translation()\n        elif \"截图\" in command or \"识别\" in command:\n            self.capture_and_send_screenshot()\n    \n    def send_to_phone(self, data_type, data):\n        \"\"\"发送数据到手机\"\"\"\n        if not self.clients:\n            print(\"No phone connected\")\n            return False\n            \n        message = json.dumps({\n            \"type\": data_type,\n            \"data\": data,\n            \"timestamp\": time.time()\n        })\n        \n        for client in self.clients[:]:\n            try:\n                client.send(message.encode('utf-8'))\n                print(f\"Sent {data_type} to phone\")\n                return True\n            except Exception as e:\n                print(f\"Send failed: {e}\")\n                self.clients.remove(client)\n        \n        return False\n    \n    def get_selected_text(self):\n        \"\"\"获取选中的文本\"\"\"\n        try:\n            # 保存当前剪贴板内容\n            original_clipboard = pyperclip.paste()\n            \n            # 模拟Ctrl+C复制选中的文本\n            pyperclip.copy('')  # 清空剪贴板\n            \n            # 使用pyautogui模拟复制操作\n            pyautogui.hotkey('ctrl', 'c')\n            \n            # 等待剪贴板更新\n            time.sleep(0.3)\n            \n            selected_text = pyperclip.paste()\n            \n            # 恢复原始剪贴板内容\n            pyperclip.copy(original_clipboard)\n            \n            if selected_text and selected_text.strip():\n                return selected_text.strip()\n            \n        except Exception as e:\n            print(f\"Get selected text failed: {e}\")\n        \n        return None\n    \n    def capture_screenshot(self):\n        \"\"\"捕获屏幕截图\"\"\"\n        try:\n            # 捕获屏幕\n            screenshot = pyautogui.screenshot()\n            \n            # 转换为Base64\n            buffered = BytesIO()\n            screenshot.save(buffered, format=\"PNG\")\n            img_str = base64.b64encode(buffered.getvalue()).decode('utf-8')\n            \n            return img_str\n            \n        except Exception as e:\n            print(f\"Screenshot failed: {e}\")\n            return None\n    \n    def trigger_translation(self, text=None):\n        \"\"\"触发翻译过程\"\"\"\n        print(\"Starting translation process...\")\n        \n        if text:\n            # 直接使用传入的文本\n            print(f\"Text to translate: {text}\")\n            self.send_to_phone(\"text\", text)\n        else:\n            # 尝试获取选中文本\n            selected_text = self.get_selected_text()\n            if selected_text:\n                print(f\"Selected text: {selected_text}\")\n                self.send_to_phone(\"text\", selected_text)\n            else:\n                print(\"No text selected, capturing screenshot...\")\n                self.capture_and_send_screenshot()\n    \n    def capture_and_send_screenshot(self):\n        \"\"\"捕获并发送截图\"\"\"\n        print(\"Capturing screenshot...\")\n        \n        img_data = self.capture_screenshot()\n        if img_data:\n            self.send_to_phone(\"image\", img_data)\n        else:\n            print(\"Screenshot failed\")\n    \n    def setup_clipboard_monitor(self):\n        \"\"\"设置剪贴板监听\"\"\"\n        self.clipboard_monitor = ClipboardMonitor(self.trigger_translation)\n        self.clipboard_monitor.start_monitoring()\n        print(\"Clipboard monitoring started\")\n        print(\"Copy any text to trigger translation\")\n    \n    def run(self):\n        \"\"\"运行服务\"\"\"\n        try:\n            self.setup_clipboard_monitor()\n            self.start_server()\n            \n            # 保持程序运行\n            while self.running:\n                time.sleep(1)\n                \n        except KeyboardInterrupt:\n            print(\"\\nStopping service...\")\n        finally:\n            self.stop()\n    \n    def stop(self):\n        \"\"\"停止服务\"\"\"\n        self.running = False\n        if self.server_socket:\n            self.server_socket.close()\n        for client in self.clients:\n            client.close()\n        print(\"Service stopped\")\n\n# 兼容Python 2/3的BytesIO\ntry:\n    from io import BytesIO\nexcept ImportError:\n    from StringIO import StringIO as BytesIO\n\nif __name__ == \"__main__\":\n    print(\"=\" * 50)\n    print(\"PC Translation Server - Clipboard Version\")\n    print(\"=\" * 50)\n    \n    # 启动服务\n    server = TranslationServer()\n    server.run()"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":34476,"output":2410,"cacheRead":0,"cacheWrite":0,"totalTokens":36886,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771642597568}}
