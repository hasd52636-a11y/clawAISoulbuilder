{"type":"message","id":"3145d00e","parentId":"85ba5555","timestamp":"2026-02-21T04:25:45.504Z","message":{"role":"assistant","content":[{"type":"text","text":"          "},{"type":"toolCall","id":"call_72a263a3431541d9ab31b7d5","name":"write","arguments":{"path":"stable_client.py","content":"#!/usr/bin/env python3\n\"\"\"\n稳定的手机客户端 - 解决翻译质量和连接问题\n\"\"\"\n\nimport socket\nimport json\nimport base64\nimport time\nimport os\nimport subprocess\nfrom datetime import datetime\n\nclass StableClient:\n    def __init__(self, server_ip, server_port=8888):\n        self.server_ip = server_ip\n        self.server_port = server_port\n        self.socket = None\n        self.connected = False\n        \n        # 增强的翻译词典\n        self.translation_dict = {\n            \"hello\": \"你好\", \"hi\": \"你好\", \"hey\": \"嘿\",\n            \"world\": \"世界\", \"earth\": \"地球\", \n            \"thank\": \"谢谢\", \"thanks\": \"谢谢\", \"thank you\": \"谢谢\",\n            \"good\": \"好\", \"morning\": \"早上\", \"good morning\": \"早上好\",\n            \"afternoon\": \"下午\", \"good afternoon\": \"下午好\",\n            \"evening\": \"晚上\", \"good evening\": \"晚上好\",\n            \"night\": \"晚上\", \"good night\": \"晚安\",\n            \"python\": \"Python\", \"program\": \"程序\", \"programming\": \"编程\",\n            \"phone\": \"手机\", \"mobile\": \"移动\", \"computer\": \"电脑\",\n            \"translation\": \"翻译\", \"text\": \"文本\", \"word\": \"单词\",\n            \"book\": \"书\", \"pen\": \"笔\", \"paper\": \"纸\",\n            \"water\": \"水\", \"fire\": \"火\", \"air\": \"空气\", \"earth\": \"土\",\n            \"man\": \"男人\", \"woman\": \"女人\", \"boy\": \"男孩\", \"girl\": \"女孩\",\n            \"cat\": \"猫\", \"dog\": \"狗\", \"bird\": \"鸟\", \"fish\": \"鱼\",\n            \"red\": \"红色\", \"blue\": \"蓝色\", \"green\": \"绿色\", \"yellow\": \"黄色\",\n            \"big\": \"大\", \"small\": \"小\", \"fast\": \"快\", \"slow\": \"慢\",\n            \"hot\": \"热\", \"cold\": \"冷\", \"new\": \"新\", \"old\": \"旧\",\n            \"yes\": \"是\", \"no\": \"不\", \"ok\": \"好的\", \"okay\": \"好的\",\n            \"please\": \"请\", \"sorry\": \"对不起\", \"excuse\": \"原谅\",\n            \"love\": \"爱\", \"like\": \"喜欢\", \"hate\": \"恨\", \"happy\": \"快乐\",\n            \"sad\": \"悲伤\", \"angry\": \"生气\", \"tired\": \"疲倦\",\n            \"eat\": \"吃\", \"drink\": \"喝\", \"sleep\": \"睡觉\", \"work\": \"工作\",\n            \"play\": \"玩\", \"study\": \"学习\", \"read\": \"阅读\", \"write\": \"写作\",\n            \"one\": \"一\", \"two\": \"二\", \"three\": \"三\", \"four\": \"四\", \"five\": \"五\",\n            \"six\": \"六\", \"seven\": \"七\", \"eight\": \"八\", \"nine\": \"九\", \"ten\": \"十\"\n        }\n    \n    def connect_to_server(self):\n        \"\"\"连接到电脑服务器\"\"\"\n        try:\n            self.socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n            self.socket.settimeout(300)  # 5分钟超时\n            self.socket.connect((self.server_ip, self.server_port))\n            self.connected = True\n            print(f\"✅ 已连接到电脑: {self.server_ip}:{self.server_port}\")\n            return True\n            \n        except Exception as e:\n            print(f\"❌ 连接失败: {e}\")\n            return False\n    \n    def receive_data(self):\n        \"\"\"接收和处理数据\"\"\"\n        try:\n            while self.connected:\n                data = self.socket.recv(4096)\n                if not data:\n                    print(\"❌ 连接已断开\")\n                    break\n                \n                print(f\"📨 收到 {len(data)} 字节数据\")\n                \n                try:\n                    message = json.loads(data.decode('utf-8'))\n                    \n                    # 忽略心跳消息\n                    if message.get('type') == 'heartbeat':\n                        continue\n                        \n                    self.process_message(message)\n                    \n                    # 发送心跳回应\n                    heartbeat = json.dumps({'type': 'heartbeat', 'time': time.time()})\n                    self.socket.send(heartbeat.encode('utf-8'))\n                    \n                except json.JSONDecodeError:\n                    print(f\"📨 收到非JSON数据: {data[:100]}...\")\n                    \n        except socket.timeout:\n            print(\"⏰ 连接超时，尝试重连...\")\n            self.reconnect()\n        except Exception as e:\n            print(f\"❌ 接收数据错误: {e}\")\n        finally:\n            self.disconnect()\n    \n    def reconnect(self):\n        \"\"\"重新连接\"\"\"\n        self.disconnect()\n        time.sleep(2)\n        if self.connect_to_server():\n            self.receive_data()\n    \n    def process_message(self, message):\n        \"\"\"处理接收到的消息\"\"\"\n        msg_type = message.get('type', '')\n        data = message.get('data', '')\n        \n        print(f\"📥 收到消息类型: {msg_type}\")\n        \n        if msg_type == \"text\":\n            self.handle_text_translation(data)\n        elif msg_type == \"image\":\n            self.handle_image_ocr(data)\n        else:\n            print(f\""}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"aborted","timestamp":1771647504540,"errorMessage":"Request was aborted"}}
