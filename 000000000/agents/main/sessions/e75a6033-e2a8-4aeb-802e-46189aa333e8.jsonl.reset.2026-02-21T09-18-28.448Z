{"type":"message","id":"7982cbb4","parentId":"3eebf615","timestamp":"2026-02-21T01:32:57.972Z","message":{"role":"assistant","content":[{"type":"text","text":"      好的！我来为您完整实现这个项目。让我先创建电脑端的Python服务程序"},{"type":"toolCall","id":"call_3d29dc1c45d84cdba0e3b1da","name":"write","arguments":{"path":"translation_server.py","content":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"\n电脑端翻译服务程序\n支持快捷键触发文本翻译和OCR识别\n\"\"\"\n\nimport socket\nimport threading\nimport keyboard\nimport pyautogui\nimport pyperclip\nimport time\nimport base64\nimport json\nimport os\nfrom PIL import Image\nimport sys\n\nclass TranslationServer:\n    def __init__(self, host='0.0.0.0', port=8888):\n        self.host = host\n        self.port = port\n        self.clients = []\n        self.server_socket = None\n        self.running = False\n        \n    def get_local_ip(self):\n        \"\"\"获取本机IP地址\"\"\"\n        try:\n            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\n            s.connect((\"8.8.8.8\", 80))\n            ip = s.getsockname()[0]\n            s.close()\n            return ip\n        except:\n            return \"127.0.0.1\"\n    \n    def start_server(self):\n        \"\"\"启动TCP服务器\"\"\"\n        try:\n            self.server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n            self.server_socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\n            self.server_socket.bind((self.host, self.port))\n            self.server_socket.listen(5)\n            \n            print(f\"🚀 翻译服务已启动\")\n            print(f\"📱 手机连接IP: {self.get_local_ip()}\")\n            print(f\"🔌 端口: {self.port}\")\n            print(\"⌨️  快捷键: Ctrl + C + C + C (连续按三次C)\")\n            print(\"⏳ 等待手机连接...\")\n            \n            self.running = True\n            \n            # 接受客户端连接\n            accept_thread = threading.Thread(target=self.accept_clients)\n            accept_thread.daemon = True\n            accept_thread.start()\n            \n        except Exception as e:\n            print(f\"❌ 启动服务器失败: {e}\")\n    \n    def accept_clients(self):\n        \"\"\"接受客户端连接\"\"\"\n        while self.running:\n            try:\n                client_socket, addr = self.server_socket.accept()\n                print(f\"✅ 手机连接成功: {addr}\")\n                self.clients.append(client_socket)\n                \n                # 为每个客户端创建接收线程\n                client_thread = threading.Thread(\n                    target=self.handle_client, \n                    args=(client_socket, addr)\n                )\n                client_thread.daemon = True\n                client_thread.start()\n                \n            except Exception as e:\n                if self.running:\n                    print(f\"❌ 接受连接错误: {e}\")\n    \n    def handle_client(self, client_socket, addr):\n        \"\"\"处理客户端通信\"\"\"\n        try:\n            while self.running:\n                data = client_socket.recv(1024)\n                if not data:\n                    break\n                \n                message = data.decode('utf-8')\n                print(f\"📱 收到手机消息: {message}\")\n                \n                # 处理语音指令\n                if message.startswith(\"VOICE:\"):\n                    self.handle_voice_command(message[6:])\n                    \n        except Exception as e:\n            print(f\"❌ 客户端 {addr} 通信错误: {e}\")\n        finally:\n            if client_socket in self.clients:\n                self.clients.remove(client_socket)\n            client_socket.close()\n            print(f\"❌ 手机断开连接: {addr}\")\n    \n    def handle_voice_command(self, command):\n        \"\"\"处理语音指令\"\"\"\n        command = command.lower().strip()\n        print(f\"🎤 语音指令: {command}\")\n        \n        # 这里可以添加更多的语音指令处理\n        if \"翻译\" in command:\n            self.trigger_translation()\n        elif \"截图\" in command or \"识别\" in command:\n            self.capture_and_send_screenshot()\n    \n    def send_to_phone(self, data_type, data):\n        \"\"\"发送数据到手机\"\"\"\n        if not self.clients:\n            print(\"❌ 没有手机连接\")\n            return False\n            \n        message = json.dumps({\n            \"type\": data_type,\n            \"data\": data,\n            \"timestamp\": time.time()\n        })\n        \n        for client in self.clients[:]:\n            try:\n                client.send(message.encode('utf-8'))\n                print(f\"✅ 已发送 {data_type} 到手机\")\n                return True\n            except Exception as e:\n                print(f\"❌ 发送失败: {e}\")\n                self.clients.remove(client)\n        \n        return False\n    \n    def get_selected_text(self):\n        \"\"\"获取选中的文本\"\"\"\n        try:\n            # 保存当前剪贴板内容\n            original_clipboard = pyperclip.paste()\n            \n            # 模拟Ctrl+C复制选中的文本\n            pyperclip.copy('')  # 清空剪贴板\n            keyboard.press('ctrl')\n            keyboard.press('c')\n            keyboard.release('c')\n            keyboard.release('ctrl')\n            \n            # 等待剪贴板更新\n            time.sleep(0.1)\n            \n            selected_text = pyperclip.paste()\n            \n            # 恢复原始剪贴板内容\n            pyperclip.copy(original_clipboard)\n            \n            if selected_text and selected_text.strip():\n                return selected_text.strip()\n            \n        except Exception as e:\n            print(f\"❌ 获取选中文本失败: {e}\")\n        \n        return None\n    \n    def capture_screenshot(self):\n        \"\"\"捕获屏幕截图\"\"\"\n        try:\n            # 捕获屏幕\n            screenshot = pyautogui.screenshot()\n            \n            # 转换为Base64\n            buffered = BytesIO()\n            screenshot.save(buffered, format=\"PNG\")\n            img_str = base64.b64encode(buffered.getvalue()).decode('utf-8')\n            \n            return img_str\n            \n        except Exception as e:\n            print(f\"❌ 截图失败: {e}\")\n            return None\n    \n    def trigger_translation(self):\n        \"\"\"触发翻译过程\"\"\"\n        print(\"🔍 正在获取选中文本...\")\n        \n        text = self.get_selected_text()\n        if text:\n            print(f\"📝 选中文本: {text}\")\n            self.send_to_phone(\"text\", text)\n        else:\n            print(\"❌ 未检测到选中文本，尝试截图...\")\n            self.capture_and_send_screenshot()\n    \n    def capture_and_send_screenshot(self):\n        \"\"\"捕获并发送截图\"\"\"\n        print(\"📸 正在截图...\")\n        \n        img_data = self.capture_screenshot()\n        if img_data:\n            self.send_to_phone(\"image\", img_data)\n        else:\n            print(\"❌ 截图失败\")\n    \n    def setup_hotkey(self):\n        \"\"\"设置快捷键\"\"\"\n        # 注册Ctrl+连续三次C快捷键\n        keyboard.add_hotkey('ctrl+c+c+c', self.trigger_translation)\n        print(\"✅ 快捷键已注册: Ctrl + C + C + C\")\n    \n    def run(self):\n        \"\"\"运行服务\"\"\"\n        try:\n            self.setup_hotkey()\n            self.start_server()\n            \n            # 保持程序运行\n            while self.running:\n                time.sleep(1)\n                \n        except KeyboardInterrupt:\n            print(\"\\n🛑 正在关闭服务...\")\n        finally:\n            self.stop()\n    \n    def stop(self):\n        \"\"\"停止服务\"\"\"\n        self.running = False\n        if self.server_socket:\n            self.server_socket.close()\n        for client in self.clients:\n            client.close()\n        print(\"✅ 服务已停止\")\n\n# 兼容Python 2/3的BytesIO\ntry:\n    from io import BytesIO\nexcept ImportError:\n    from StringIO import StringIO as BytesIO\n\ndef create_startup_script():\n    \"\"\"创建开机启动脚本\"\"\"\n    script_content = '''@echo off\ncd /d \"%~dp0\"\npython translation_server.py\npause\n'''\n    \n    with open('start_server.bat', 'w', encoding='gbk') as f:\n        f.write(script_content)\n    \n    print(\"✅ 已创建启动脚本: start_server.bat\")\n    print(\"💡 请将此脚本添加到开机启动项中\")\n\nif __name__ == \"__main__\":\n    print(\"=\" * 50)\n    print(\"🤖 电脑端翻译服务\")\n    print(\"=\" * 50)\n    \n    # 创建启动脚本\n    create_startup_script()\n    \n    # 启动服务\n    server = TranslationServer()\n    server.run()"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":7505,"output":2345,"cacheRead":0,"cacheWrite":0,"totalTokens":9850,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771637448127}}
