{"type":"message","id":"4f0414e0","parentId":"087206f9","timestamp":"2026-02-21T04:18:24.521Z","message":{"role":"assistant","content":[{"type":"text","text":"    您说得对，让我从根本上解决这些问题。让我创建一个全新的、更稳定的版本："},{"type":"toolCall","id":"call_1fd644b36a63481192591c33","name":"write","arguments":{"path":"stable_server.py","content":"#!/usr/bin/env python3\n\"\"\"\n稳定的翻译服务器 - 解决连接和翻译质量问题\n\"\"\"\n\nimport socket\nimport threading\nimport pyautogui\nimport pyperclip\nimport time\nimport base64\nimport json\nimport os\nfrom PIL import Image\nfrom io import BytesIO\n\nclass StableServer:\n    def __init__(self, host='0.0.0.0', port=8888):\n        self.host = host\n        self.port = port\n        self.clients = []\n        self.server_socket = None\n        self.running = False\n        self.last_clipboard = \"\"\n    \n    def get_local_ip(self):\n        \"\"\"获取本机IP地址\"\"\"\n        try:\n            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\n            s.connect((\"8.8.8.8\", 80))\n            ip = s.getsockname()[0]\n            s.close()\n            return ip\n        except:\n            return \"127.0.0.1\"\n    \n    def start_server(self):\n        \"\"\"启动TCP服务器\"\"\"\n        try:\n            self.server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n            self.server_socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\n            self.server_socket.bind((self.host, self.port))\n            self.server_socket.listen(5)\n            \n            print(\"Stable translation server started\")\n            print(f\"Phone connect IP: {self.get_local_ip()}\")\n            print(f\"Port: {self.port}\")\n            print(\"Copy text to trigger translation\")\n            \n            self.running = True\n            \n            # 接受客户端连接\n            accept_thread = threading.Thread(target=self.accept_clients)\n            accept_thread.daemon = True\n            accept_thread.start()\n            \n            # 开始剪贴板监控\n            self.start_clipboard_monitor()\n            \n        except Exception as e:\n            print(f\"Failed to start server: {e}\")\n    \n    def accept_clients(self):\n        \"\"\"接受客户端连接\"\"\"\n        while self.running:\n            try:\n                client_socket, addr = self.server_socket.accept()\n                print(f\"Phone connected: {addr}\")\n                self.clients.append(client_socket)\n                \n                # 设置心跳\n                client_socket.settimeout(300)  # 5分钟超时\n                \n                # 为每个客户端创建接收线程\n                client_thread = threading.Thread(\n                    target=self.handle_client, \n                    args=(client_socket, addr)\n                )\n                client_thread.daemon = True\n                client_thread.start()\n                \n            except Exception as e:\n                if self.running:\n                    print(f\"Connection error: {e}\")\n    \n    def handle_client(self, client_socket, addr):\n        \"\"\"处理客户端通信\"\"\"\n        try:\n            while self.running:\n                try:\n                    data = client_socket.recv(1024)\n                    if not data:\n                        break\n                    \n                    # 处理心跳\n                    try:\n                        message = json.loads(data.decode('utf-8'))\n                        if message.get('type') == 'heartbeat':\n                            continue\n                    except:\n                        pass\n                        \n                except socket.timeout:\n                    # 发送心跳保持连接\n                    try:\n                        heartbeat = json.dumps({'type': 'heartbeat', 'time': time.time()})\n                        client_socket.send(heartbeat.encode('utf-8'))\n                    except:\n                        break\n                except Exception as e:\n                    print(f\"Client error: {e}\")\n                    break\n                    \n        finally:\n            if client_socket in self.clients:\n                self.clients.remove(client_socket)\n            client_socket.close()\n            print(f\"Phone disconnected: {addr}\")\n    \n    def start_clipboard_monitor(self):\n        \"\"\"开始剪贴板监控\"\"\"\n        def monitor():\n            while self.running:\n                try:\n                    current_text = pyperclip.paste()\n                    if current_text and current_text.strip() and current_text != self.last_clipboard:\n                        print(f\"Detected new text: {current_text}\")\n                        self.send_to_phone(\"text\", current_text)\n                        self.last_clipboard = current_text\n                    time.sleep(1)\n                except Exception as e:\n                    print(f\"Clipboard error: {e}\")\n                    time.sleep(2)\n        \n        thread = threading.Thread(target=monitor)\n        thread.daemon = True\n        thread.start()\n    \n    def send_to_phone(self, data_type, data):\n        \"\"\"发送数据到手机\"\"\"\n        if not self.clients:\n            print(\"No phone connected\")\n            return False\n            \n        message = json.dumps({\n            \"type\": data_type,\n            \"data\": data,\n            \"timestamp\": time.time()\n        })\n        \n        success = False\n        for client in self.clients[:]:\n            try:\n                client.send(message.encode('utf-8'))\n                print(f\"Sent {data_type} to phone\")\n                success = True\n            except Exception as e:\n                print(f\"Send failed: {e}\")\n                self.clients.remove(client)\n        \n        return success\n    \n    def run(self):\n        \"\"\"运行服务\"\"\"\n        try:\n            self.start_server()\n            \n            # 保持程序运行\n            while self.running:\n                time.sleep(1)\n                \n        except KeyboardInterrupt:\n            print(\"\\nStopping service...\")\n        finally:\n            self.stop()\n    \n    def stop(self):\n        \"\"\"停止服务\"\"\"\n        self.running = False\n        if self.server_socket:\n            self.server_socket.close()\n        for client in self.clients:\n            client.close()\n        print(\"Service stopped\")\n\nif __name__ == \"__main__\":\n    print(\"=\" * 50)\n    print(\"Stable Translation Server\")\n    print(\"=\" * 50)\n    \n    server = StableServer()\n    server.run()"}}],"api":"openai-completions","provider":"nvidia","model":"deepseek-ai/deepseek-v3.1","usage":{"input":46297,"output":1581,"cacheRead":0,"cacheWrite":0,"totalTokens":47878,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1771647345481}}
